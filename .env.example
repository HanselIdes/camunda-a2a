# Copy to .env. Ports must be free on the host; compose project name is camunda-a2a.
COMPOSE_PROJECT_NAME=camunda-a2a
CAMUNDA_REST_PORT=18080
CAMUNDA_GRPC_PORT=18500
CAMUNDA_MGMT_PORT=19600
CONNECTORS_PORT=18085
PROXY_PORT=18090
# Public base URL clients use for the agent (the proxy). Goes into the Agent Card.
A2A_PUBLIC_URL=http://localhost:18090
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3-coder-30b-64k
