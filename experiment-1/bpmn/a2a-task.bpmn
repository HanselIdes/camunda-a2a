<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_a2a_task" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Msg_get" name="a2a-get">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=taskId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_cancel" name="a2a-cancel">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=taskId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_send" name="a2a-send">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=taskId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_push" name="a2a-push">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=taskId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="AgentFailed" name="AgentFailed" errorCode="AGENT_FAILED" />
  <bpmn:process id="a2a-task" name="A2A task" isExecutable="true">
    <bpmn:startEvent id="TaskSubmitted" name="Task submitted">
      <bpmn:outgoing>Flow_TaskSubmitted_CreateTaskState</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="CreateTaskState" name="Create task">
      <bpmn:extensionElements>
        <zeebe:script expression="= {id: taskId, contextId: contextId, status: {state: &#34;TASK_STATE_SUBMITTED&#34;, timestamp: substring(string(now()), 1, 19) + &#34;Z&#34;}, artifacts: [], history: [put(put(req.message, &#34;taskId&#34;, taskId), &#34;contextId&#34;, contextId)]}" resultVariable="task" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TaskSubmitted_CreateTaskState</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateTaskState_InitPushConfigs</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="InitPushConfigs" name="Store push notification config">
      <bpmn:extensionElements>
        <zeebe:script expression="= if req.pushConfig = null then [] else [put(put(req.pushConfig, &#34;taskId&#34;, taskId), &#34;id&#34;, if req.pushConfig.id != null then req.pushConfig.id else uuid())]" resultVariable="pushConfigs" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreateTaskState_InitPushConfigs</bpmn:incoming>
      <bpmn:outgoing>Flow_InitPushConfigs_SetPending</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="SetPending" name="Set reply pending">
      <bpmn:extensionElements>
        <zeebe:script expression="=req.blocking" resultVariable="pending" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InitPushConfigs_SetPending</bpmn:incoming>
      <bpmn:outgoing>Flow_SetPending_ReturnImmediately</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ReturnImmediately" name="Return immediately?" default="Flow_ReturnImmediately_InitDone">
      <bpmn:incoming>Flow_SetPending_ReturnImmediately</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnImmediately_BuildInitialReply</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReturnImmediately_InitDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="BuildInitialReply" name="Build initial reply">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for v in [(for h in [if req.hl = null or req.hl &#62;= count(task.history) then task.history else if req.hl &#60;= 0 then [] else sublist(task.history, count(task.history) - req.hl + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &#62; 0 then task.artifacts else null, history: if count(h) &#62; 0 then h else null})[item.value != null]))[1]] return if &#34;task&#34; = &#34;task&#34; then {task: v} else v)[1]" resultVariable="initialReply" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReturnImmediately_BuildInitialReply</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildInitialReply_PublishInitialReply</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="PublishInitialReply" name="Publish initial reply">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=req.corrId" target="corrId" />
          <zeebe:input source="=initialReply" target="replyResult" />
          <zeebe:input source="=null" target="replyError" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BuildInitialReply_PublishInitialReply</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishInitialReply_InitDone</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="InitDone" name="Task initialised">
      <bpmn:incoming>Flow_ReturnImmediately_InitDone</bpmn:incoming>
      <bpmn:incoming>Flow_PublishInitialReply_InitDone</bpmn:incoming>
      <bpmn:outgoing>Flow_InitDone_Active</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Active" name="Process task">
      <bpmn:incoming>Flow_InitDone_Active</bpmn:incoming>
      <bpmn:outgoing>Flow_Active_TerminalJoin</bpmn:outgoing>
      <bpmn:startEvent id="MessageAccepted" name="Message accepted">
        <bpmn:outgoing>Flow_MessageAccepted_ClassifyJoin</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="ClassifyJoin" name="Classify next message">
        <bpmn:incoming>Flow_MessageAccepted_ClassifyJoin</bpmn:incoming>
        <bpmn:incoming>Flow_SetPendingAgain_ClassifyJoin</bpmn:incoming>
        <bpmn:outgoing>Flow_ClassifyJoin_ClassifyMessage</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:businessRuleTask id="ClassifyMessage" name="Classify message">
        <bpmn:extensionElements>
          <zeebe:calledDecision decisionId="a2a-classify" resultVariable="sc" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ClassifyJoin_ClassifyMessage</bpmn:incoming>
        <bpmn:outgoing>Flow_ClassifyMessage_ModeGw</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:scriptTask id="ApplyScenario" name="Apply scenario">
        <bpmn:extensionElements>
          <zeebe:script expression="= (for m in [if sc.statusText != null then {messageId: uuid(), contextId: task.contextId, taskId: task.id, role: &#34;ROLE_AGENT&#34;, parts: [{text: sc.statusText}]} else if sc.echo then {messageId: uuid(), contextId: task.contextId, taskId: task.id, role: &#34;ROLE_AGENT&#34;, parts: [{text: &#34;Unhandled messageId prefix: &#34; + req.message.messageId}]} else null] return for a in [if sc.artifact = null then null else {artifactId: uuid(), name: &#34;output&#34;, parts: if sc.artifact = &#34;text&#34; then [{text: &#34;Generated text content&#34;}] else if sc.artifact = &#34;file&#34; then [{raw: &#34;dGNr&#34;, mediaType: &#34;text/plain&#34;, filename: &#34;output.txt&#34;}] else if sc.artifact = &#34;file-url&#34; then [{url: &#34;https://example.com/output.txt&#34;, mediaType: &#34;text/plain&#34;, filename: &#34;output.txt&#34;}] else [{data: {key: &#34;value&#34;, count: 42}}]}] return {id: task.id, contextId: task.contextId, status: context(get entries({state: sc.state, message: m, timestamp: substring(string(now()), 1, 19) + &#34;Z&#34;})[item.value != null]), artifacts: if a = null then task.artifacts else append(task.artifacts, a), history: if m != null then append(task.history, m) else task.history})[1][1]" resultVariable="task" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ModeGw_ApplyScenario</bpmn:incoming>
        <bpmn:outgoing>Flow_ApplyScenario_WorkDone</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="IsPending" name="Reply pending?" default="Flow_IsPending_ReplyHandled">
        <bpmn:incoming>Flow_PushJoin_IsPending</bpmn:incoming>
        <bpmn:outgoing>Flow_IsPending_BuildReply</bpmn:outgoing>
        <bpmn:outgoing>Flow_IsPending_ReplyHandled</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="BuildReply" name="Build reply">
        <bpmn:extensionElements>
          <zeebe:script expression="=(for v in [(for h in [if req.hl = null or req.hl &#62;= count(task.history) then task.history else if req.hl &#60;= 0 then [] else sublist(task.history, count(task.history) - req.hl + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &#62; 0 then task.artifacts else null, history: if count(h) &#62; 0 then h else null})[item.value != null]))[1]] return if &#34;task&#34; = &#34;task&#34; then {task: v} else v)[1]" resultVariable="workReply" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_IsPending_BuildReply</bpmn:incoming>
        <bpmn:outgoing>Flow_BuildReply_PublishReply</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:callActivity id="PublishReply" name="Publish reply">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" />
          <zeebe:ioMapping>
            <zeebe:input source="=req.corrId" target="corrId" />
            <zeebe:input source="=workReply" target="replyResult" />
            <zeebe:input source="=null" target="replyError" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_BuildReply_PublishReply</bpmn:incoming>
        <bpmn:outgoing>Flow_PublishReply_MarkReplied</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:scriptTask id="MarkReplied" name="Mark replied">
        <bpmn:extensionElements>
          <zeebe:script expression="=false" resultVariable="pending" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_PublishReply_MarkReplied</bpmn:incoming>
        <bpmn:outgoing>Flow_MarkReplied_ReplyHandled</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="ReplyHandled" name="Reply handled">
        <bpmn:incoming>Flow_IsPending_ReplyHandled</bpmn:incoming>
        <bpmn:incoming>Flow_MarkReplied_ReplyHandled</bpmn:incoming>
        <bpmn:outgoing>Flow_ReplyHandled_InputRequired</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="InputRequired" name="Input required?" default="Flow_InputRequired_WorkFinished">
        <bpmn:incoming>Flow_ReplyHandled_InputRequired</bpmn:incoming>
        <bpmn:outgoing>Flow_InputRequired_WorkFinished</bpmn:outgoing>
        <bpmn:outgoing>Flow_InputRequired_FollowJoin</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="WorkFinished" name="Work finished">
        <bpmn:incoming>Flow_InputRequired_WorkFinished</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="FollowJoin" name="Await follow-up">
        <bpmn:incoming>Flow_InputRequired_FollowJoin</bpmn:incoming>
        <bpmn:incoming>Flow_PublishMismatch_FollowJoin</bpmn:incoming>
        <bpmn:outgoing>Flow_FollowJoin_FollowUpArrives</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="FollowUpArrives" name="Follow-up arrives">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=sendReq" target="followReq" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_FollowJoin_FollowUpArrives</bpmn:incoming>
        <bpmn:outgoing>Flow_FollowUpArrives_ContextMatches</bpmn:outgoing>
        <bpmn:messageEventDefinition id="FollowUpArrives_def" messageRef="Msg_send" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="ContextMatches" name="Context matches?" default="Flow_ContextMatches_BuildContextMismatch">
        <bpmn:incoming>Flow_FollowUpArrives_ContextMatches</bpmn:incoming>
        <bpmn:outgoing>Flow_ContextMatches_RecordUserMessage</bpmn:outgoing>
        <bpmn:outgoing>Flow_ContextMatches_BuildContextMismatch</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="BuildContextMismatch" name="Build context mismatch error">
        <bpmn:extensionElements>
          <zeebe:script expression="={code: -32602, message: &#34;contextId does not match the task&#34;}" resultVariable="mismatchError" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ContextMatches_BuildContextMismatch</bpmn:incoming>
        <bpmn:outgoing>Flow_BuildContextMismatch_PublishMismatch</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:callActivity id="PublishMismatch" name="Publish mismatch error">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" />
          <zeebe:ioMapping>
            <zeebe:input source="=followReq.corrId" target="corrId" />
            <zeebe:input source="=null" target="replyResult" />
            <zeebe:input source="=mismatchError" target="replyError" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_BuildContextMismatch_PublishMismatch</bpmn:incoming>
        <bpmn:outgoing>Flow_PublishMismatch_FollowJoin</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:scriptTask id="RecordUserMessage" name="Record user message">
        <bpmn:extensionElements>
          <zeebe:script expression="= {id: task.id, contextId: task.contextId, status: {state: &#34;TASK_STATE_WORKING&#34;, timestamp: substring(string(now()), 1, 19) + &#34;Z&#34;}, artifacts: task.artifacts, history: append(task.history, put(put(followReq.message, &#34;taskId&#34;, task.id), &#34;contextId&#34;, task.contextId))}" resultVariable="task" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ContextMatches_RecordUserMessage</bpmn:incoming>
        <bpmn:outgoing>Flow_RecordUserMessage_SetRequest</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="SetRequest" name="Set current request">
        <bpmn:extensionElements>
          <zeebe:script expression="={corrId: followReq.corrId, blocking: true, hl: followReq.historyLength, message: followReq.message, wrap: &#34;task&#34;}" resultVariable="req" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_RecordUserMessage_SetRequest</bpmn:incoming>
        <bpmn:outgoing>Flow_SetRequest_SetPendingAgain</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="SetPendingAgain" name="Set reply pending again">
        <bpmn:extensionElements>
          <zeebe:script expression="=true" resultVariable="pending" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SetRequest_SetPendingAgain</bpmn:incoming>
        <bpmn:outgoing>Flow_SetPendingAgain_ClassifyJoin</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="ModeGw" name="Scripted or agent?" default="Flow_ModeGw_ApplyScenario">
        <bpmn:incoming>Flow_ClassifyMessage_ModeGw</bpmn:incoming>
        <bpmn:outgoing>Flow_ModeGw_ApplyScenario</bpmn:outgoing>
        <bpmn:outgoing>Flow_ModeGw_MarkWorking</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:adHocSubProcess id="AgentTools" name="Agent with tools" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="1" />
          <zeebe:ioMapping>
            <zeebe:input source="openai" target="provider.type" />
            <zeebe:input source="completions" target="provider.openai.api.type" />
            <zeebe:input source="custom" target="provider.openai.backend.type" />
            <zeebe:input source="{{secrets.OLLAMA_BASE_URL}}" target="provider.openai.backend.custom.endpoint" />
            <zeebe:input source="none" target="provider.openai.backend.custom.authentication.type" />
            <zeebe:input source="PT180S" target="provider.openai.timeouts.timeout" />
            <zeebe:input source="{{secrets.OLLAMA_MODEL}}" target="provider.openai.model.model" />
            <zeebe:input source="modelDefault" target="provider.openai.api.completions.effort" />
            <zeebe:input source="=0" target="provider.openai.api.completions.temperature" />
            <zeebe:input source="=&#34;You are a helpful assistant exposed through the A2A protocol. Answer the user concisely in plain text. Use the available tools whenever they help. If you cannot answer without more information from the user, start your reply with the exact marker NEED_INPUT: followed by your question, and call no tool.&#34;" target="data.systemPrompt.prompt" />
            <zeebe:input source="=string join(for part in req.message.parts return if part.text != null then part.text else &#34;&#34;, &#34; &#34;)" target="data.userPrompt.prompt" />
            <zeebe:input target="agentContext" />
            <zeebe:input source="in-process" target="data.memory.storage.type" />
            <zeebe:input source="=20" target="data.memory.contextWindowSize" />
            <zeebe:input source="=8" target="data.limits.maxModelCalls" />
            <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
            <zeebe:input source="text" target="data.response.format.type" />
            <zeebe:input source="=false" target="data.response.format.parseJson" />
            <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
            <zeebe:input source="true" target="data.response.includeAgentContext" />
            <zeebe:input target="agent" />
            <zeebe:output source="=agent" target="agent" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="1" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" />
            <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;AGENT_FAILED&#34;, string(error.message)) else null" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
          <zeebe:properties>
            <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
          </zeebe:properties>
          <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult,&#10;  completedAt: now()&#10;}" />
          <zeebe:agentDefinition agentType="aiAgentSubProcess" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_MarkWorking_AgentTools</bpmn:incoming>
        <bpmn:outgoing>Flow_AgentTools_ApplyAgentResponse</bpmn:outgoing>
        <bpmn:scriptTask id="get_current_time" name="Get current time">
          <bpmn:documentation>Returns the current date and time in UTC. Use it whenever the user asks what time or date it is. Takes no arguments.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:properties>
              <zeebe:property name="a2a:tags" value="time,clock,date" />
              <zeebe:property name="a2a:examples" value="What time is it?|What is today&#39;s date?" />
            </zeebe:properties>
            <zeebe:script expression="={utcTime: substring(string(now()), 1, 19) + &#34;Z&#34;}" resultVariable="toolCallResult" />
          </bpmn:extensionElements>
        </bpmn:scriptTask>
        <bpmn:scriptTask id="convert_temperature" name="Convert temperature">
          <bpmn:documentation>Converts a temperature between Celsius and Fahrenheit. Use it when the user gives a temperature and wants it in the other unit. Arguments: the numeric value and the unit it is given in.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:properties>
              <zeebe:property name="a2a:tags" value="temperature,conversion" />
              <zeebe:property name="a2a:examples" value="Convert 100 celsius to fahrenheit|What is 50 fahrenheit in celsius?" />
            </zeebe:properties>
            <zeebe:ioMapping>
              <zeebe:input source="=fromAi(toolCall.degrees, &#34;The temperature value to convert&#34;, &#34;number&#34;)" target="degrees" />
              <zeebe:input source="=fromAi(toolCall.unit, &#34;The unit of the given value: celsius or fahrenheit&#34;, &#34;string&#34;)" target="unit" />
            </zeebe:ioMapping>
            <zeebe:script expression="=if lower case(unit) = &#34;celsius&#34; then {value: round half up(degrees * 9 / 5 + 32, 1), unit: &#34;fahrenheit&#34;} else {value: round half up((degrees - 32) * 5 / 9, 1), unit: &#34;celsius&#34;}" resultVariable="toolCallResult" />
          </bpmn:extensionElements>
        </bpmn:scriptTask>
        <bpmn:businessRuleTask id="capital_of" name="Look up capital city">
          <bpmn:documentation>Looks up the capital city of a country. Use it when the user asks for the capital of a country. Argument: the country name in English.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:properties>
              <zeebe:property name="a2a:tags" value="geography,capital" />
              <zeebe:property name="a2a:examples" value="What is the capital of France?|Capital of Japan?" />
            </zeebe:properties>
            <zeebe:ioMapping>
              <zeebe:input source="=fromAi(toolCall.country, &#34;The country name in English&#34;, &#34;string&#34;)" target="country" />
            </zeebe:ioMapping>
            <zeebe:calledDecision decisionId="capitals" resultVariable="toolCallResult" />
          </bpmn:extensionElements>
        </bpmn:businessRuleTask>
      </bpmn:adHocSubProcess>
      <bpmn:boundaryEvent id="AgentError" name="Agent failed" attachedToRef="AgentTools">
        <bpmn:outgoing>Flow_AgentError_MarkAgentFailed</bpmn:outgoing>
        <bpmn:errorEventDefinition id="AgentError_def" errorRef="AgentFailed" />
      </bpmn:boundaryEvent>
      <bpmn:scriptTask id="ApplyAgentResponse" name="Apply agent response">
        <bpmn:extensionElements>
          <zeebe:script expression="= (for t in [if starts with((if agent.responseText instance of string then trim(agent.responseText) else &#34;The agent produced no answer.&#34;), &#34;NEED_INPUT:&#34;) then trim(substring((if agent.responseText instance of string then trim(agent.responseText) else &#34;The agent produced no answer.&#34;), 12)) else (if agent.responseText instance of string then trim(agent.responseText) else &#34;The agent produced no answer.&#34;)] return for a in [(for calls in [flatten(for m in agent.context.conversation.messages[item.role = &#34;assistant&#34; and item.toolCalls != null] return for tc in m.toolCalls return {name: tc.name, arguments: tc.arguments})] return if count(calls) = 0 then null else {artifactId: uuid(), name: &#34;tool-trace&#34;, parts: [{data: {toolCalls: calls}}]})[1]] return for m in [{messageId: uuid(), contextId: task.contextId, taskId: task.id, role: &#34;ROLE_AGENT&#34;, parts: [{text: t}]}] return {id: task.id, contextId: task.contextId, status: {state: if starts with((if agent.responseText instance of string then trim(agent.responseText) else &#34;The agent produced no answer.&#34;), &#34;NEED_INPUT:&#34;) then &#34;TASK_STATE_INPUT_REQUIRED&#34; else &#34;TASK_STATE_COMPLETED&#34;, message: m, timestamp: substring(string(now()), 1, 19) + &#34;Z&#34;}, artifacts: concatenate(task.artifacts[item.name != &#34;tool-trace&#34; and item.name != &#34;answer&#34; and item.name != &#34;question&#34;], [{artifactId: uuid(), name: if (if starts with((if agent.responseText instance of string then trim(agent.responseText) else &#34;The agent produced no answer.&#34;), &#34;NEED_INPUT:&#34;) then &#34;TASK_STATE_INPUT_REQUIRED&#34; else &#34;TASK_STATE_COMPLETED&#34;) = &#34;TASK_STATE_INPUT_REQUIRED&#34; then &#34;question&#34; else &#34;answer&#34;, parts: [{text: t}]}], if a = null then [] else [a]), history: append(task.history, m)})[1][1][1]" resultVariable="task" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_AgentTools_ApplyAgentResponse</bpmn:incoming>
        <bpmn:outgoing>Flow_ApplyAgentResponse_WorkDone</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="MarkAgentFailed" name="Mark task failed">
        <bpmn:extensionElements>
          <zeebe:script expression="= (for m in [{messageId: uuid(), contextId: task.contextId, taskId: task.id, role: &#34;ROLE_AGENT&#34;, parts: [{text: &#34;The agent could not complete the request.&#34;}]}] return {id: task.id, contextId: task.contextId, status: {state: &#34;TASK_STATE_FAILED&#34;, message: m, timestamp: substring(string(now()), 1, 19) + &#34;Z&#34;}, artifacts: task.artifacts, history: append(task.history, m)})[1]" resultVariable="task" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_AgentError_MarkAgentFailed</bpmn:incoming>
        <bpmn:outgoing>Flow_MarkAgentFailed_WorkDone</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="MarkWorking" name="Mark task working">
        <bpmn:extensionElements>
          <zeebe:script expression="= {id: task.id, contextId: task.contextId, status: {state: &#34;TASK_STATE_WORKING&#34;, timestamp: substring(string(now()), 1, 19) + &#34;Z&#34;}, artifacts: task.artifacts, history: task.history}" resultVariable="task" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ModeGw_MarkWorking</bpmn:incoming>
        <bpmn:outgoing>Flow_MarkWorking_AgentTools</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="WorkDone" name="Work done">
        <bpmn:incoming>Flow_ApplyScenario_WorkDone</bpmn:incoming>
        <bpmn:incoming>Flow_ApplyAgentResponse_WorkDone</bpmn:incoming>
        <bpmn:incoming>Flow_MarkAgentFailed_WorkDone</bpmn:incoming>
        <bpmn:outgoing>Flow_WorkDone_HasPush</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:subProcess id="ActiveGet" name="Answer GetTask" triggeredByEvent="true">
        <bpmn:startEvent id="GetWhileActive" name="GetTask while active" isInterrupting="false">
          <bpmn:outgoing>Flow_GetWhileActive_BuildActiveView</bpmn:outgoing>
          <bpmn:messageEventDefinition id="GetWhileActive_def" messageRef="Msg_get" />
        </bpmn:startEvent>
        <bpmn:scriptTask id="BuildActiveView" name="Build task view">
          <bpmn:extensionElements>
            <zeebe:script expression="=(for v in [(for h in [if getReq.historyLength = null or getReq.historyLength &#62;= count(task.history) then task.history else if getReq.historyLength &#60;= 0 then [] else sublist(task.history, count(task.history) - getReq.historyLength + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &#62; 0 then task.artifacts else null, history: if count(h) &#62; 0 then h else null})[item.value != null]))[1]] return if getReq.wrap = &#34;task&#34; then {task: v} else v)[1]" resultVariable="getView" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_GetWhileActive_BuildActiveView</bpmn:incoming>
          <bpmn:outgoing>Flow_BuildActiveView_PublishActiveView</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:callActivity id="PublishActiveView" name="Publish task view">
          <bpmn:extensionElements>
            <zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" />
            <zeebe:ioMapping>
              <zeebe:input source="=getReq.corrId" target="corrId" />
              <zeebe:input source="=getView" target="replyResult" />
              <zeebe:input source="=null" target="replyError" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_BuildActiveView_PublishActiveView</bpmn:incoming>
          <bpmn:outgoing>Flow_PublishActiveView_ActiveViewPublished</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:endEvent id="ActiveViewPublished" name="View published">
          <bpmn:incoming>Flow_PublishActiveView_ActiveViewPublished</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_GetWhileActive_BuildActiveView" sourceRef="GetWhileActive" targetRef="BuildActiveView" />
        <bpmn:sequenceFlow id="Flow_BuildActiveView_PublishActiveView" sourceRef="BuildActiveView" targetRef="PublishActiveView" />
        <bpmn:sequenceFlow id="Flow_PublishActiveView_ActiveViewPublished" sourceRef="PublishActiveView" targetRef="ActiveViewPublished" />
      </bpmn:subProcess>
      <bpmn:subProcess id="ActiveCancel" name="Cancel task" triggeredByEvent="true">
        <bpmn:startEvent id="CancelWhileActive" name="CancelTask while active">
          <bpmn:outgoing>Flow_CancelWhileActive_MarkCanceled</bpmn:outgoing>
          <bpmn:messageEventDefinition id="CancelWhileActive_def" messageRef="Msg_cancel" />
        </bpmn:startEvent>
        <bpmn:scriptTask id="MarkCanceled" name="Mark canceled">
          <bpmn:extensionElements>
            <zeebe:script expression="= {id: task.id, contextId: task.contextId, status: {state: &#34;TASK_STATE_CANCELED&#34;, timestamp: substring(string(now()), 1, 19) + &#34;Z&#34;}, artifacts: task.artifacts, history: task.history}" resultVariable="task" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_CancelWhileActive_MarkCanceled</bpmn:incoming>
          <bpmn:outgoing>Flow_MarkCanceled_BuildCancelView</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:scriptTask id="BuildCancelView" name="Build canceled task view">
          <bpmn:extensionElements>
            <zeebe:script expression="=(for v in [(for h in [if null = null or null &#62;= count(task.history) then task.history else if null &#60;= 0 then [] else sublist(task.history, count(task.history) - null + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &#62; 0 then task.artifacts else null, history: if count(h) &#62; 0 then h else null})[item.value != null]))[1]] return if cancelReq.wrap = &#34;task&#34; then {task: v} else v)[1]" resultVariable="cancelView" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_MarkCanceled_BuildCancelView</bpmn:incoming>
          <bpmn:outgoing>Flow_BuildCancelView_PublishCancelView</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:callActivity id="PublishCancelView" name="Publish canceled task">
          <bpmn:extensionElements>
            <zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" />
            <zeebe:ioMapping>
              <zeebe:input source="=cancelReq.corrId" target="corrId" />
              <zeebe:input source="=cancelView" target="replyResult" />
              <zeebe:input source="=null" target="replyError" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_BuildCancelView_PublishCancelView</bpmn:incoming>
          <bpmn:outgoing>Flow_PublishCancelView_HasPushCancel</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:endEvent id="CancelPublished" name="Cancel published">
          <bpmn:incoming>Flow_HasPushCancel_CancelPublished</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:exclusiveGateway id="HasPushCancel" name="Push configs?" default="Flow_HasPushCancel_CancelPublished">
          <bpmn:incoming>Flow_PublishCancelView_HasPushCancel</bpmn:incoming>
          <bpmn:outgoing>Flow_HasPushCancel_NotifyPushCancel</bpmn:outgoing>
          <bpmn:outgoing>Flow_HasPushCancel_CancelPublished</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="NotifyPushCancel" name="Start push delivery" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
            <zeebe:ioMapping>
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="POST" target="method" />
              <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}/v2/process-instances&#34;" target="url" />
              <zeebe:input source="=false" target="followRedirects" />
              <zeebe:input source="JSON" target="documentReturnFormat.choice" />
              <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
              <zeebe:input source="=20" target="readTimeoutInSeconds" />
              <zeebe:input source="={processDefinitionId: &#34;a2a-push-notify&#34;, variables: {configs: pushConfigs, payload: (for v in [(for h in [if null = null or null &#62;= count(task.history) then task.history else if null &#60;= 0 then [] else sublist(task.history, count(task.history) - null + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &#62; 0 then task.artifacts else null, history: if count(h) &#62; 0 then h else null})[item.value != null]))[1]] return if &#34;task&#34; = &#34;task&#34; then {task: v} else v)[1]}}" target="body" />
              <zeebe:input source="true" target="ignoreNullValues" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="elementTemplateVersion" value="18" />
              <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
              <zeebe:header key="resultExpression" value="={}" />
              <zeebe:header key="retryBackoff" value="PT30S" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_HasPushCancel_NotifyPushCancel</bpmn:incoming>
          <bpmn:outgoing>Flow_NotifyPushCancel_CancelNotified</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="CancelNotified" name="Cancel published">
          <bpmn:incoming>Flow_NotifyPushCancel_CancelNotified</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_CancelWhileActive_MarkCanceled" sourceRef="CancelWhileActive" targetRef="MarkCanceled" />
        <bpmn:sequenceFlow id="Flow_MarkCanceled_BuildCancelView" sourceRef="MarkCanceled" targetRef="BuildCancelView" />
        <bpmn:sequenceFlow id="Flow_BuildCancelView_PublishCancelView" sourceRef="BuildCancelView" targetRef="PublishCancelView" />
        <bpmn:sequenceFlow id="Flow_PublishCancelView_HasPushCancel" sourceRef="PublishCancelView" targetRef="HasPushCancel" />
        <bpmn:sequenceFlow id="Flow_HasPushCancel_NotifyPushCancel" name="yes" sourceRef="HasPushCancel" targetRef="NotifyPushCancel">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(pushConfigs) &gt; 0</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_HasPushCancel_CancelPublished" name="no" sourceRef="HasPushCancel" targetRef="CancelPublished" />
        <bpmn:sequenceFlow id="Flow_NotifyPushCancel_CancelNotified" sourceRef="NotifyPushCancel" targetRef="CancelNotified" />
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="HasPush" name="Push configs?" default="Flow_HasPush_PushJoin">
        <bpmn:incoming>Flow_WorkDone_HasPush</bpmn:incoming>
        <bpmn:outgoing>Flow_HasPush_NotifyPush</bpmn:outgoing>
        <bpmn:outgoing>Flow_HasPush_PushJoin</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="NotifyPush" name="Start push delivery" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}/v2/process-instances&#34;" target="url" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="JSON" target="documentReturnFormat.choice" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
            <zeebe:input source="={processDefinitionId: &#34;a2a-push-notify&#34;, variables: {configs: pushConfigs, payload: (for v in [(for h in [if null = null or null &#62;= count(task.history) then task.history else if null &#60;= 0 then [] else sublist(task.history, count(task.history) - null + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &#62; 0 then task.artifacts else null, history: if count(h) &#62; 0 then h else null})[item.value != null]))[1]] return if &#34;task&#34; = &#34;task&#34; then {task: v} else v)[1]}}" target="body" />
            <zeebe:input source="true" target="ignoreNullValues" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="18" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={}" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_HasPush_NotifyPush</bpmn:incoming>
        <bpmn:outgoing>Flow_NotifyPush_PushJoin</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="PushJoin" name="Push handled">
        <bpmn:incoming>Flow_HasPush_PushJoin</bpmn:incoming>
        <bpmn:incoming>Flow_NotifyPush_PushJoin</bpmn:incoming>
        <bpmn:outgoing>Flow_PushJoin_IsPending</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:subProcess id="ActivePush" name="Answer push configuration operation" triggeredByEvent="true">
        <bpmn:startEvent id="PushWhileActive" name="Push operation while active" isInterrupting="false">
          <bpmn:outgoing>Flow_PushWhileActive_ComputePushOutcome</bpmn:outgoing>
          <bpmn:messageEventDefinition id="PushWhileActive_def" messageRef="Msg_push" />
        </bpmn:startEvent>
        <bpmn:scriptTask id="ComputePushOutcome" name="Compute push outcome">
          <bpmn:extensionElements>
            <zeebe:script expression="=(for op in [pushReq.op] return if op = &#34;CreateTaskPushNotificationConfig&#34; then (if pushReq.config.url instance of string and pushReq.config.url != &#34;&#34; then {result: put(put(pushReq.config, &#34;taskId&#34;, task.id), &#34;id&#34;, if pushReq.config.id != null then pushReq.config.id else uuid())} else {error: {code: -32602, message: &#34;Invalid params: url is required&#34;}}) else if op = &#34;GetTaskPushNotificationConfig&#34; then (if count(pushConfigs[item.id = pushReq.configId]) &#62; 0 then {result: pushConfigs[item.id = pushReq.configId][1]} else {error: {code: -32602, message: &#34;Push notification config not found&#34;}}) else if op = &#34;ListTaskPushNotificationConfigs&#34; then {result: {configs: pushConfigs, nextPageToken: &#34;&#34;}} else {result: {}})[1]" resultVariable="pushOutcome" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_PushWhileActive_ComputePushOutcome</bpmn:incoming>
          <bpmn:outgoing>Flow_ComputePushOutcome_UpdatePushConfigs</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:scriptTask id="UpdatePushConfigs" name="Update push configs">
          <bpmn:extensionElements>
            <zeebe:script expression="=if pushReq.op = &#34;CreateTaskPushNotificationConfig&#34; and pushOutcome.result != null then append(pushConfigs[item.id != pushOutcome.result.id], pushOutcome.result) else if pushReq.op = &#34;DeleteTaskPushNotificationConfig&#34; then pushConfigs[item.id != pushReq.configId] else pushConfigs" resultVariable="pushConfigs" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_ComputePushOutcome_UpdatePushConfigs</bpmn:incoming>
          <bpmn:outgoing>Flow_UpdatePushConfigs_PublishPushOutcome</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:callActivity id="PublishPushOutcome" name="Publish push outcome">
          <bpmn:extensionElements>
            <zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" />
            <zeebe:ioMapping>
              <zeebe:input source="=pushReq.corrId" target="corrId" />
              <zeebe:input source="=pushOutcome.result" target="replyResult" />
              <zeebe:input source="=pushOutcome.error" target="replyError" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_UpdatePushConfigs_PublishPushOutcome</bpmn:incoming>
          <bpmn:outgoing>Flow_PublishPushOutcome_PushOutcomePublished</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:endEvent id="PushOutcomePublished" name="Push outcome published">
          <bpmn:incoming>Flow_PublishPushOutcome_PushOutcomePublished</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_PushWhileActive_ComputePushOutcome" sourceRef="PushWhileActive" targetRef="ComputePushOutcome" />
        <bpmn:sequenceFlow id="Flow_ComputePushOutcome_UpdatePushConfigs" sourceRef="ComputePushOutcome" targetRef="UpdatePushConfigs" />
        <bpmn:sequenceFlow id="Flow_UpdatePushConfigs_PublishPushOutcome" sourceRef="UpdatePushConfigs" targetRef="PublishPushOutcome" />
        <bpmn:sequenceFlow id="Flow_PublishPushOutcome_PushOutcomePublished" sourceRef="PublishPushOutcome" targetRef="PushOutcomePublished" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_MessageAccepted_ClassifyJoin" sourceRef="MessageAccepted" targetRef="ClassifyJoin" />
      <bpmn:sequenceFlow id="Flow_ClassifyJoin_ClassifyMessage" sourceRef="ClassifyJoin" targetRef="ClassifyMessage" />
      <bpmn:sequenceFlow id="Flow_ClassifyMessage_ModeGw" sourceRef="ClassifyMessage" targetRef="ModeGw" />
      <bpmn:sequenceFlow id="Flow_ModeGw_ApplyScenario" name="scripted" sourceRef="ModeGw" targetRef="ApplyScenario" />
      <bpmn:sequenceFlow id="Flow_ModeGw_MarkWorking" name="agent" sourceRef="ModeGw" targetRef="MarkWorking">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=sc.route = "agent"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_MarkWorking_AgentTools" sourceRef="MarkWorking" targetRef="AgentTools" />
      <bpmn:sequenceFlow id="Flow_ApplyScenario_WorkDone" sourceRef="ApplyScenario" targetRef="WorkDone" />
      <bpmn:sequenceFlow id="Flow_AgentTools_ApplyAgentResponse" sourceRef="AgentTools" targetRef="ApplyAgentResponse" />
      <bpmn:sequenceFlow id="Flow_AgentError_MarkAgentFailed" sourceRef="AgentError" targetRef="MarkAgentFailed" />
      <bpmn:sequenceFlow id="Flow_ApplyAgentResponse_WorkDone" sourceRef="ApplyAgentResponse" targetRef="WorkDone" />
      <bpmn:sequenceFlow id="Flow_MarkAgentFailed_WorkDone" sourceRef="MarkAgentFailed" targetRef="WorkDone" />
      <bpmn:sequenceFlow id="Flow_IsPending_BuildReply" name="yes" sourceRef="IsPending" targetRef="BuildReply">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=pending = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_IsPending_ReplyHandled" name="no" sourceRef="IsPending" targetRef="ReplyHandled" />
      <bpmn:sequenceFlow id="Flow_BuildReply_PublishReply" sourceRef="BuildReply" targetRef="PublishReply" />
      <bpmn:sequenceFlow id="Flow_PublishReply_MarkReplied" sourceRef="PublishReply" targetRef="MarkReplied" />
      <bpmn:sequenceFlow id="Flow_MarkReplied_ReplyHandled" sourceRef="MarkReplied" targetRef="ReplyHandled" />
      <bpmn:sequenceFlow id="Flow_ReplyHandled_InputRequired" sourceRef="ReplyHandled" targetRef="InputRequired" />
      <bpmn:sequenceFlow id="Flow_InputRequired_WorkFinished" name="no" sourceRef="InputRequired" targetRef="WorkFinished" />
      <bpmn:sequenceFlow id="Flow_InputRequired_FollowJoin" name="yes" sourceRef="InputRequired" targetRef="FollowJoin">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task.status.state = "TASK_STATE_INPUT_REQUIRED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_FollowJoin_FollowUpArrives" sourceRef="FollowJoin" targetRef="FollowUpArrives" />
      <bpmn:sequenceFlow id="Flow_FollowUpArrives_ContextMatches" sourceRef="FollowUpArrives" targetRef="ContextMatches" />
      <bpmn:sequenceFlow id="Flow_ContextMatches_RecordUserMessage" name="yes" sourceRef="ContextMatches" targetRef="RecordUserMessage">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=followReq.message.contextId = null or followReq.message.contextId = task.contextId</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ContextMatches_BuildContextMismatch" name="no" sourceRef="ContextMatches" targetRef="BuildContextMismatch" />
      <bpmn:sequenceFlow id="Flow_BuildContextMismatch_PublishMismatch" sourceRef="BuildContextMismatch" targetRef="PublishMismatch" />
      <bpmn:sequenceFlow id="Flow_PublishMismatch_FollowJoin" sourceRef="PublishMismatch" targetRef="FollowJoin" />
      <bpmn:sequenceFlow id="Flow_RecordUserMessage_SetRequest" sourceRef="RecordUserMessage" targetRef="SetRequest" />
      <bpmn:sequenceFlow id="Flow_SetRequest_SetPendingAgain" sourceRef="SetRequest" targetRef="SetPendingAgain" />
      <bpmn:sequenceFlow id="Flow_SetPendingAgain_ClassifyJoin" sourceRef="SetPendingAgain" targetRef="ClassifyJoin" />
      <bpmn:sequenceFlow id="Flow_WorkDone_HasPush" sourceRef="WorkDone" targetRef="HasPush" />
      <bpmn:sequenceFlow id="Flow_HasPush_NotifyPush" name="yes" sourceRef="HasPush" targetRef="NotifyPush">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(pushConfigs) &gt; 0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_HasPush_PushJoin" name="no" sourceRef="HasPush" targetRef="PushJoin" />
      <bpmn:sequenceFlow id="Flow_NotifyPush_PushJoin" sourceRef="NotifyPush" targetRef="PushJoin" />
      <bpmn:sequenceFlow id="Flow_PushJoin_IsPending" sourceRef="PushJoin" targetRef="IsPending" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="TerminalJoin" name="Await terminal requests">
      <bpmn:incoming>Flow_Active_TerminalJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PublishTerminalView_TerminalJoin</bpmn:incoming>
