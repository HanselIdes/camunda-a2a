          <zeebe:input source="=cancelError" target="replyError" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BuildNotCancelable_PublishNotCancelable</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishNotCancelable_TerminalJoin</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateCatchEvent id="TerminalSend" name="SendMessage in terminal state">
      <bpmn:incoming>Flow_AwaitTerminal_TerminalSend</bpmn:incoming>
      <bpmn:outgoing>Flow_TerminalSend_BuildTerminalSendError</bpmn:outgoing>
      <bpmn:messageEventDefinition id="TerminalSend_def" messageRef="Msg_send" />
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="BuildTerminalSendError" name="Build terminal state error">
      <bpmn:extensionElements>
        <zeebe:script expression="={code: -32004, message: &#34;Task is in a terminal state and cannot accept messages&#34;, reason: &#34;UNSUPPORTED_OPERATION&#34;}" resultVariable="sendError" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TerminalSend_BuildTerminalSendError</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildTerminalSendError_PublishTerminalSendError</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="PublishTerminalSendError" name="Publish terminal state error">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=sendReq.corrId" target="corrId" />
          <zeebe:input source="=null" target="replyResult" />
          <zeebe:input source="=sendError" target="replyError" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BuildTerminalSendError_PublishTerminalSendError</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishTerminalSendError_TerminalJoin</bpmn:outgoing>
