    <bpmn:intermediateCatchEvent id="TerminalGet" name="GetTask in terminal state">
      <bpmn:incoming>Flow_AwaitTerminal_TerminalGet</bpmn:incoming>
      <bpmn:outgoing>Flow_TerminalGet_BuildTerminalView</bpmn:outgoing>
      <bpmn:messageEventDefinition id="TerminalGet_def" messageRef="Msg_get" />
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="BuildTerminalView" name="Build task view">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for v in [(for h in [if getReq.historyLength = null or getReq.historyLength &#62;= count(task.history) then task.history else if getReq.historyLength &#60;= 0 then [] else sublist(task.history, count(task.history) - getReq.historyLength + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &#62; 0 then task.artifacts else null, history: if count(h) &#62; 0 then h else null})[item.value != null]))[1]] return if getReq.wrap = &#34;task&#34; then {task: v} else v)[1]" resultVariable="terminalView" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TerminalGet_BuildTerminalView</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildTerminalView_PublishTerminalView</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="PublishTerminalView" name="Publish task view">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=getReq.corrId" target="corrId" />
          <zeebe:input source="=terminalView" target="replyResult" />
          <zeebe:input source="=null" target="replyError" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BuildTerminalView_PublishTerminalView</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishTerminalView_TerminalJoin</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateCatchEvent id="TerminalCancel" name="CancelTask in terminal state">
