      <bpmn:messageEventDefinition id="TerminalCancel_def" messageRef="Msg_cancel" />
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="BuildNotCancelable" name="Build not cancelable error">
      <bpmn:extensionElements>
        <zeebe:script expression="={code: -32002, message: &#34;Task cannot be canceled in its current state&#34;, reason: &#34;TASK_NOT_CANCELABLE&#34;}" resultVariable="cancelError" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TerminalCancel_BuildNotCancelable</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildNotCancelable_PublishNotCancelable</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="PublishNotCancelable" name="Publish not cancelable error">
