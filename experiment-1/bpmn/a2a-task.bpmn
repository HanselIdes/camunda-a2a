    <bpmn:intermediateCatchEvent id="TaskExpires" name="Task expires">
      <bpmn:incoming>Flow_AwaitTerminal_TaskExpires</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskExpires_TaskExpired</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TaskExpires_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT1H"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="TaskExpired" name="Task expired">
      <bpmn:incoming>Flow_TaskExpires_TaskExpired</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="TerminalPush" name="Push operation in terminal state">
      <bpmn:incoming>Flow_AwaitTerminal_TerminalPush</bpmn:incoming>
      <bpmn:outgoing>Flow_TerminalPush_ComputeTerminalPush</bpmn:outgoing>
      <bpmn:messageEventDefinition id="TerminalPush_def" messageRef="Msg_push" />
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="ComputeTerminalPush" name="Compute push outcome">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for op in [pushReq.op] return if op = &#34;CreateTaskPushNotificationConfig&#34; then (if pushReq.config.url instance of string and pushReq.config.url != &#34;&#34; then {result: put(put(pushReq.config, &#34;taskId&#34;, task.id), &#34;id&#34;, if pushReq.config.id != null then pushReq.config.id else uuid())} else {error: {code: -32602, message: &#34;Invalid params: url is required&#34;}}) else if op = &#34;GetTaskPushNotificationConfig&#34; then (if count(pushConfigs[item.id = pushReq.configId]) &#62; 0 then {result: pushConfigs[item.id = pushReq.configId][1]} else {error: {code: -32602, message: &#34;Push notification config not found&#34;}}) else if op = &#34;ListTaskPushNotificationConfigs&#34; then {result: {configs: pushConfigs, nextPageToken: &#34;&#34;}} else {result: {}})[1]" resultVariable="pushOutcome" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TerminalPush_ComputeTerminalPush</bpmn:incoming>
      <bpmn:outgoing>Flow_ComputeTerminalPush_UpdateTerminalPush</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="UpdateTerminalPush" name="Update push configs">
      <bpmn:extensionElements>
        <zeebe:script expression="=if pushReq.op = &#34;CreateTaskPushNotificationConfig&#34; and pushOutcome.result != null then append(pushConfigs[item.id != pushOutcome.result.id], pushOutcome.result) else if pushReq.op = &#34;DeleteTaskPushNotificationConfig&#34; then pushConfigs[item.id != pushReq.configId] else pushConfigs" resultVariable="pushConfigs" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ComputeTerminalPush_UpdateTerminalPush</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateTerminalPush_PublishTerminalPush</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="PublishTerminalPush" name="Publish push outcome">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=pushReq.corrId" target="corrId" />
          <zeebe:input source="=pushOutcome.result" target="replyResult" />
          <zeebe:input source="=pushOutcome.error" target="replyError" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_UpdateTerminalPush_PublishTerminalPush</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishTerminalPush_TerminalJoin</bpmn:outgoing>
    </bpmn:callActivity>
