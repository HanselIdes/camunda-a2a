    <bpmn:intermediateCatchEvent id="Replied" name="Remote agent replied" zeebe:modelerTemplate="dev.hansel.a2a.client.webhook.intermediate.v1" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
