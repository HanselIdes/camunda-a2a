          <zeebe:property name="inbound.auth.type" value="APIKEY" />
          <zeebe:property name="inbound.auth.apiKey" value="{{secrets.A2A_PUSH_TOKEN}}" />
          <zeebe:property name="inbound.auth.apiKeyLocator" value="=request.headers.`x-a2a-notification-token`" />
          <zeebe:property name="correlationKeyExpression" value="=(if request.body.task != null then request.body.task.id else request.body.statusUpdate.taskId)" />
          <zeebe:property name="activationCondition" value="=list contains([&#34;TASK_STATE_COMPLETED&#34;, &#34;TASK_STATE_FAILED&#34;, &#34;TASK_STATE_CANCELED&#34;, &#34;TASK_STATE_REJECTED&#34;, &#34;TASK_STATE_INPUT_REQUIRED&#34;, &#34;TASK_STATE_AUTH_REQUIRED&#34;], (if request.body.task != null then request.body.task.status.state else request.body.statusUpdate.status.state))" />
          <zeebe:property name="resultExpression" value="={toolCallResult: if request.body.task != null then request.body.task else request.body}" />
        </zeebe:properties>
