  }, {
    "id" : "inbound.context",
    "label" : "Webhook ID",
    "description" : "The JSON-RPC endpoint is {connectors base}/inbound/{webhook ID}?agent={agent ID}. Use the same webhook ID on the follow-up event.",
    "value" : "a2a-server",
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "endpoint",
    "binding" : {
      "name" : "inbound.context",
      "type" : "zeebe:property"
    },
    "type" : "String"
  }, {
    "id" : "inbound.verificationExpression",
    "value" : "=if request.body.method = \"SendMessage\" and request.body.params.message.messageId != null and (request.body.params.message.parts != null and (every part in request.body.params.message.parts satisfies part.text != null)) and request.body.params.configuration.returnImmediately = true and request.body.params.configuration.taskPushNotificationConfig.url != null then null else {statusCode: 200, headers: {\"Content-Type\": \"application/json\"}, body: {jsonrpc: \"2.0\", id: request.body.id, error: if request.body.method != \"SendMessage\" then {code: -32601, message: \"Method not found\"} else if request.body.params.message.messageId = null then {code: -32602, message: \"Invalid params: message.messageId is required\"} else if not((request.body.params.message.parts != null and (every part in request.body.params.message.parts satisfies part.text != null))) then {code: -32005, message: \"Content type not supported: this agent accepts text parts only\"} else {code: -32004, message: \"Unsupported operation: this agent runs tasks in the background and answers by push notification only. Set configuration.returnImmediately to true and configuration.taskPushNotificationConfig.url.\"}}}",
    "group" : "endpoint",
    "binding" : {
      "name" : "inbound.verificationExpression",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "inbound.responseExpression",
    "value" : "={statusCode: 200, headers: {\"Content-Type\": \"application/json\"}, body: {jsonrpc: \"2.0\", id: request.body.id, result: if request.body.params.message.taskId = null then {task: {id: (if request.body.params.message.taskId != null then request.body.params.message.taskId else request.body.params.message.messageId), contextId: (if request.body.params.message.contextId != null then request.body.params.message.contextId else (if request.body.params.message.taskId != null then request.body.params.message.taskId else request.body.params.message.messageId)), status: {state: \"TASK_STATE_SUBMITTED\"}}} else {message: {messageId: \"reply-\" + request.body.params.message.messageId, role: \"ROLE_AGENT\", taskId: request.body.params.message.taskId, contextId: (if request.body.params.message.contextId != null then request.body.params.message.contextId else (if request.body.params.message.taskId != null then request.body.params.message.taskId else request.body.params.message.messageId)), parts: [{text: \"Message received for task \" + request.body.params.message.taskId + \". If this task is waiting for input, its next update arrives as a push notification. If the task is closed, nothing receives this message and no update will follow: start a new task.\"}]}}}}",
    "group" : "endpoint",
    "binding" : {
      "name" : "inbound.responseExpression",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
