    "value" : "=request.body.params.message.messageId",
    "group" : "correlation",
    "binding" : {
      "name" : "messageIdExpression",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "correlationKeyProcess",
    "label" : "Agent ID",
    "description" : "The ID this process instance's agent is reached by, the value of the agent query parameter.",
    "value" : "=a2aAgentId",
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "required",
    "group" : "correlation",
    "binding" : {
      "name" : "correlationKey",
      "type" : "bpmn:Message#zeebe:subscription#property"
    },
    "type" : "String"
  }, {
    "id" : "messageNameUuid",
    "label" : "Message name",
    "generatedValue" : {
      "type" : "uuid"
    },
    "feel" : "optional",
    "group" : "correlation",
    "binding" : {
      "name" : "name",
      "type" : "bpmn:Message#property"
    },
    "tooltip" : "By default, this is an auto-generated random UUID. We recommend using a unique message name for each connector element in the diagram. Override to set a custom message name. Learn more about <a href=\"https://docs.camunda.io/docs/components/concepts/messages/#message-subscriptions\">message subscriptions</a> that power inbound connectors.",
    "type" : "String"
  }, {
    "id" : "resultVariable",
    "label" : "Result variable",
    "description" : "Name of variable to store the response in. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-variable\" target=\"_blank\">documentation</a>.",
    "group" : "output",
    "binding" : {
      "name" : "resultVariable",
      "type" : "zeebe:property"
    },
    "type" : "String"
  }, {
    "id" : "resultExpression",
    "label" : "Result expression",
    "description" : "Maps the SendMessage request to process variables. The push event and the follow-up event of this task read taskId, contextId and pushNotification; keep them.",
    "value" : "={taskId: (if request.body.params.message.taskId != null then request.body.params.message.taskId else request.body.params.message.messageId), contextId: (if request.body.params.message.contextId != null then request.body.params.message.contextId else (if request.body.params.message.taskId != null then request.body.params.message.taskId else request.body.params.message.messageId)), messageText: string join(for part in request.body.params.message.parts return part.text, \" \"), pushNotification: request.body.params.configuration.taskPushNotificationConfig, taskState: \"TASK_STATE_SUBMITTED\"}",
    "feel" : "required",
    "group" : "output",
    "binding" : {
      "name" : "resultExpression",
