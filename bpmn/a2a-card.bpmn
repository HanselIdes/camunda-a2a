<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_a2a_card" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="a2a-card" name="A2A Agent Card" isExecutable="true">
    <bpmn:startEvent id="CardRequested" name="Agent Card requested" zeebe:modelerTemplate="io.camunda.connectors.webhook.WebhookConnector.v1" zeebe:modelerTemplateVersion="16" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
          <zeebe:property name="inbound.method" value="get" />
          <zeebe:property name="inbound.context" value="a2a-card" />
          <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
          <zeebe:property name="inbound.auth.type" value="NONE" />
          <zeebe:property name="inbound.responseExpression" value="={statusCode: 200, headers: {&#34;Content-Type&#34;: &#34;application/json&#34;, &#34;Cache-Control&#34;: &#34;public, max-age=300&#34;, &#34;ETag&#34;: &#34;\&#34;6d5d7edbd7a94166\&#34;&#34;, &#34;Last-Modified&#34;: &#34;Thu, 15 Oct 2026 12:00:00 GMT&#34;}, body: context merge([correlation.variables.card, {supportedInterfaces: [{url: &#34;{{secrets.A2A_PUBLIC_URL}}/a2a&#34;, protocolBinding: &#34;JSONRPC&#34;, protocolVersion: &#34;1.0&#34;}]}])}" />
          <zeebe:property name="consumeUnmatchedEvents" value="true" />
          <zeebe:property name="synchronousResponse" value="true" />
          <zeebe:property name="deduplicationModeManualFlag" value="false" />
          <zeebe:property name="deduplicationMode" value="AUTO" />
          <zeebe:property name="resultVariable" value="" />
          <zeebe:property name="resultExpression" value="={}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_CardRequested_BuildCard</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="BuildCard" name="Build Agent Card">
      <bpmn:extensionElements>
        <zeebe:script expression="={name: &#34;camunda-a2a&#34;, description: &#34;An A2A 1.0 agent implemented in BPMN with out-of-the-box Camunda connectors&#34;, version: &#34;1.0.0&#34;, provider: {organization: &#34;camunda-a2a&#34;, url: &#34;https://github.com/HanselIdes/camunda-a2a&#34;}, capabilities: {streaming: false, pushNotifications: false, extendedAgentCard: false}, defaultInputModes: [&#34;text/plain&#34;, &#34;application/json&#34;], defaultOutputModes: [&#34;text/plain&#34;, &#34;application/json&#34;], skills: [{id: &#34;get_current_time&#34;, name: &#34;Get current time&#34;, description: &#34;Returns the current date and time in UTC. Use it whenever the user asks what time or date it is. Takes no arguments.&#34;, tags: [&#34;time&#34;, &#34;clock&#34;, &#34;date&#34;], examples: [&#34;What time is it?&#34;, &#34;What is today&#39;s date?&#34;]}, {id: &#34;convert_temperature&#34;, name: &#34;Convert temperature&#34;, description: &#34;Converts a temperature between Celsius and Fahrenheit. Use it when the user gives a temperature and wants it in the other unit. Arguments: the numeric value and the unit it is given in.&#34;, tags: [&#34;temperature&#34;, &#34;conversion&#34;], examples: [&#34;Convert 100 celsius to fahrenheit&#34;, &#34;What is 50 fahrenheit in celsius?&#34;]}, {id: &#34;capital_of&#34;, name: &#34;Look up capital city&#34;, description: &#34;Looks up the capital city of a country. Use it when the user asks for the capital of a country. Argument: the country name in English.&#34;, tags: [&#34;geography&#34;, &#34;capital&#34;], examples: [&#34;What is the capital of France?&#34;, &#34;Capital of Japan?&#34;]}]}" resultVariable="card" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CardRequested_BuildCard</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildCard_CardReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="CardReady" name="Agent Card ready">
      <bpmn:incoming>Flow_BuildCard_CardReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CardRequested_BuildCard" sourceRef="CardRequested" targetRef="BuildCard" />
    <bpmn:sequenceFlow id="Flow_BuildCard_CardReady" sourceRef="BuildCard" targetRef="CardReady" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="a2a-card">
      <bpmndi:BPMNShape id="CardRequested_di" bpmnElement="CardRequested">
        <dc:Bounds x="150" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="123" y="138" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BuildCard_di" bpmnElement="BuildCard">
        <dc:Bounds x="250" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardReady_di" bpmnElement="CardReady">
        <dc:Bounds x="420" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_CardRequested_BuildCard_di" bpmnElement="Flow_CardRequested_BuildCard">
        <di:waypoint x="186" y="120" />
        <di:waypoint x="250" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BuildCard_CardReady_di" bpmnElement="Flow_BuildCard_CardReady">
        <di:waypoint x="350" y="120" />
        <di:waypoint x="420" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
