<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_a2a_card_runtime" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="a2a-card-runtime" name="A2A Agent Card from the deployed agent" isExecutable="true">
    <bpmn:startEvent id="RuntimeCardRequested" name="Runtime Agent Card requested" zeebe:modelerTemplate="io.camunda.connectors.webhook.WebhookConnector.v1" zeebe:modelerTemplateVersion="16" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
          <zeebe:property name="inbound.method" value="get" />
          <zeebe:property name="inbound.context" value="a2a-card-runtime" />
          <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
          <zeebe:property name="inbound.auth.type" value="NONE" />
          <zeebe:property name="inbound.responseExpression" value="={statusCode: 200, headers: {&#34;Content-Type&#34;: &#34;application/json&#34;}, body: context merge([correlation.variables.card, {supportedInterfaces: [{url: &#34;{{secrets.A2A_PUBLIC_URL}}/a2a&#34;, protocolBinding: &#34;JSONRPC&#34;, protocolVersion: &#34;1.0&#34;}]}])}" />
          <zeebe:property name="consumeUnmatchedEvents" value="true" />
          <zeebe:property name="synchronousResponse" value="true" />
          <zeebe:property name="deduplicationModeManualFlag" value="false" />
          <zeebe:property name="deduplicationMode" value="AUTO" />
          <zeebe:property name="resultVariable" value="" />
          <zeebe:property name="resultExpression" value="={}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_RuntimeCardRequested_FindAgentDefinition</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="FindAgentDefinition" name="Find agent definition" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}/v2/process-definitions/search&#34;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={filter: {processDefinitionId: &#34;a2a-task&#34;, isLatestVersion: true}}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="18" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={definitionKey: string(response.body.items[1].processDefinitionKey)}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RuntimeCardRequested_FindAgentDefinition</bpmn:incoming>
      <bpmn:outgoing>Flow_FindAgentDefinition_ReadAgentDefinition</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ReadAgentDefinition" name="Read agent definition XML" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}/v2/process-definitions/&#34; + definitionKey + &#34;/xml&#34;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="TEXT" target="documentReturnFormat.choice" />
          <zeebe:input source="UTF-8" target="documentReturnFormat.encoding" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="18" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={xml: response.body}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FindAgentDefinition_ReadAgentDefinition</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadAgentDefinition_BuildRuntimeCard</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="BuildRuntimeCard" name="Build Agent Card from XML">
      <bpmn:extensionElements>
        <zeebe:script expression="={name: &#34;camunda-a2a&#34;, description: &#34;An A2A 1.0 agent implemented in BPMN with out-of-the-box Camunda connectors&#34;, version: &#34;1.0.0&#34;, provider: {organization: &#34;camunda-a2a&#34;, url: &#34;https://github.com/HanselIdes/camunda-a2a&#34;}, capabilities: {streaming: false, pushNotifications: false, extendedAgentCard: false}, defaultInputModes: [&#34;text/plain&#34;, &#34;application/json&#34;], defaultOutputModes: [&#34;text/plain&#34;, &#34;application/json&#34;], skills: (for inner in [substring before(substring after(xml, &#34;&#60;bpmn:adHocSubProcess &#34;), &#34;&#60;/bpmn:adHocSubProcess&#62;&#34;)] return for parts in [sublist(split(inner, &#34;&#60;bpmn:(scriptTask|serviceTask|businessRuleTask|userTask|callActivity|subProcess) id=\&#34;&#34;), 2)] return for part in parts return {id: substring before(part, &#34;\&#34;&#34;), name: substring before(substring after(part, &#34;name=\&#34;&#34;), &#34;\&#34;&#34;), description: replace(replace(replace(replace(replace(replace(replace(substring before(substring after(part, &#34;&#60;bpmn:documentation&#62;&#34;), &#34;&#60;/bpmn:documentation&#62;&#34;), &#34;&#38;quot;&#34;, &#34;\&#34;&#34;), &#34;&#38;#34;&#34;, &#34;\&#34;&#34;), &#34;&#38;apos;&#34;, &#34;&#39;&#34;), &#34;&#38;#39;&#34;, &#34;&#39;&#34;), &#34;&#38;lt;&#34;, &#34;&#60;&#34;), &#34;&#38;gt;&#34;, &#34;&#62;&#34;), &#34;&#38;amp;&#34;, &#34;&#38;&#34;), tags: split(substring before(substring after(part, &#34;name=\&#34;a2a:tags\&#34; value=\&#34;&#34;), &#34;\&#34;&#34;), &#34;,&#34;), examples: split(replace(replace(replace(replace(replace(replace(replace(substring before(substring after(part, &#34;name=\&#34;a2a:examples\&#34; value=\&#34;&#34;), &#34;\&#34;&#34;), &#34;&#38;quot;&#34;, &#34;\&#34;&#34;), &#34;&#38;#34;&#34;, &#34;\&#34;&#34;), &#34;&#38;apos;&#34;, &#34;&#39;&#34;), &#34;&#38;#39;&#34;, &#34;&#39;&#34;), &#34;&#38;lt;&#34;, &#34;&#60;&#34;), &#34;&#38;gt;&#34;, &#34;&#62;&#34;), &#34;&#38;amp;&#34;, &#34;&#38;&#34;), &#34;[|]&#34;)})[1][1]}" resultVariable="card" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReadAgentDefinition_BuildRuntimeCard</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildRuntimeCard_RuntimeCardReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="RuntimeCardReady" name="Agent Card ready">
      <bpmn:incoming>Flow_BuildRuntimeCard_RuntimeCardReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RuntimeCardRequested_FindAgentDefinition" sourceRef="RuntimeCardRequested" targetRef="FindAgentDefinition" />
    <bpmn:sequenceFlow id="Flow_FindAgentDefinition_ReadAgentDefinition" sourceRef="FindAgentDefinition" targetRef="ReadAgentDefinition" />
    <bpmn:sequenceFlow id="Flow_ReadAgentDefinition_BuildRuntimeCard" sourceRef="ReadAgentDefinition" targetRef="BuildRuntimeCard" />
    <bpmn:sequenceFlow id="Flow_BuildRuntimeCard_RuntimeCardReady" sourceRef="BuildRuntimeCard" targetRef="RuntimeCardReady" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="a2a-card-runtime">
      <bpmndi:BPMNShape id="RuntimeCardRequested_di" bpmnElement="RuntimeCardRequested">
        <dc:Bounds x="150" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="123" y="138" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FindAgentDefinition_di" bpmnElement="FindAgentDefinition">
        <dc:Bounds x="250" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReadAgentDefinition_di" bpmnElement="ReadAgentDefinition">
        <dc:Bounds x="410" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BuildRuntimeCard_di" bpmnElement="BuildRuntimeCard">
        <dc:Bounds x="570" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RuntimeCardReady_di" bpmnElement="RuntimeCardReady">
        <dc:Bounds x="730" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_RuntimeCardRequested_FindAgentDefinition_di" bpmnElement="Flow_RuntimeCardRequested_FindAgentDefinition">
        <di:waypoint x="186" y="120" />
        <di:waypoint x="250" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FindAgentDefinition_ReadAgentDefinition_di" bpmnElement="Flow_FindAgentDefinition_ReadAgentDefinition">
        <di:waypoint x="350" y="120" />
        <di:waypoint x="410" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReadAgentDefinition_BuildRuntimeCard_di" bpmnElement="Flow_ReadAgentDefinition_BuildRuntimeCard">
        <di:waypoint x="510" y="120" />
        <di:waypoint x="570" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BuildRuntimeCard_RuntimeCardReady_di" bpmnElement="Flow_BuildRuntimeCard_RuntimeCardReady">
        <di:waypoint x="670" y="120" />
        <di:waypoint x="730" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
