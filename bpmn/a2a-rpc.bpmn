<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_a2a_rpc" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Msg_reply" name="a2a-reply">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=lookup.corrId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="a2a-rpc" name="A2A JSON-RPC handler" isExecutable="true">
    <bpmn:startEvent id="RpcReceived" name="A2A request received" zeebe:modelerTemplate="io.camunda.connectors.webhook.WebhookConnector.v1" zeebe:modelerTemplateVersion="16" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
          <zeebe:property name="inbound.method" value="post" />
          <zeebe:property name="inbound.context" value="a2a" />
          <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
          <zeebe:property name="inbound.auth.type" value="NONE" />
          <zeebe:property name="inbound.responseExpression" value="={statusCode: 200, headers: {&#34;Content-Type&#34;: &#34;application/json&#34;}, body: correlation.variables.rpcResponse}" />
          <zeebe:property name="consumeUnmatchedEvents" value="true" />
          <zeebe:property name="synchronousResponse" value="true" />
          <zeebe:property name="deduplicationModeManualFlag" value="false" />
          <zeebe:property name="deduplicationMode" value="AUTO" />
          <zeebe:property name="resultVariable" value="" />
          <zeebe:property name="resultExpression" value="={rpc: request.body, hdr: request.headers}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_RpcReceived_IsPushMethod</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="ParseRequest" name="Parse request">
      <bpmn:extensionElements>
        <zeebe:script expression="={ r: if rpc instance of context then rpc else {}, p: if r.params instance of context then r.params else {}, m: if p.message instance of context then p.message else {}, cfg: if p.configuration instance of context then p.configuration else {}, ct: get value(hdr, &#34;content-type&#34;), ver: get value(hdr, &#34;a2a-version&#34;), supported: [&#34;text/plain&#34;, &#34;application/json&#34;], method: if r.method instance of string then r.method else null, id: r.id, versionOk: if ver instance of string then (ver = &#34;&#34; or ver = &#34;1&#34; or starts with(ver, &#34;1.&#34;)) else true, contentTypeOk: if ct instance of string then (starts with(lower case(ct), &#34;application/json&#34;) or starts with(lower case(ct), &#34;application/a2a+json&#34;)) else false, jsonrpcOk: r.jsonrpc = &#34;2.0&#34; and method != null, msgOk: p.message instance of context and m.messageId instance of string and m.role instance of string and m.parts instance of list, mediaOk: if m.parts instance of list then not(some part in m.parts satisfies part instance of context and part.mediaType != null and not(list contains(supported, part.mediaType))) else true, pushMethods: [&#34;CreateTaskPushNotificationConfig&#34;, &#34;GetTaskPushNotificationConfig&#34;, &#34;ListTaskPushNotificationConfigs&#34;, &#34;DeleteTaskPushNotificationConfig&#34;], pushRef: if p.task_id instance of string then p.task_id else if p.taskId instance of string then p.taskId else null, ref: if method != null and list contains(pushMethods, method) then pushRef else if p.id instance of string then p.id else null, idOk: ref instance of string and ref != &#34;&#34;, pushEnabled: pushEnabled = true, pushCfg: context(get entries({id: p.id, url: p.url, token: p.token, authentication: p.authentication})[item.value != null]), taskPush: if cfg.taskPushNotificationConfig instance of context then cfg.taskPushNotificationConfig else null, taskId: if m.taskId instance of string and m.taskId != &#34;&#34; then m.taskId else null, contextId: if m.contextId instance of string and m.contextId != &#34;&#34; then m.contextId else null, messageId: if m.messageId instance of string then m.messageId else null, blocking: cfg.returnImmediately != true, hl: if cfg.historyLength instance of number then cfg.historyLength else if p.historyLength instance of number then p.historyLength else if p.history_length instance of number then p.history_length else null, pageSize: if p.pageSize instance of number then p.pageSize else if p.page_size instance of number then p.page_size else 50, listContextId: if p.contextId instance of string and p.contextId != &#34;&#34; then p.contextId else if p.context_id instance of string and p.context_id != &#34;&#34; then p.context_id else null, listStatus: if p.status instance of string and p.status != &#34;&#34; then p.status else null, listAfter: if p.statusTimestampAfter instance of string then p.statusTimestampAfter else if p.status_timestamp_after instance of string then p.status_timestamp_after else null, pageToken: if p.pageToken instance of string then p.pageToken else if p.page_token instance of string then p.page_token else null, includeArtifacts: p.includeArtifacts = true or p.include_artifacts = true }" resultVariable="ctx" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PushSettingKnown_ParseRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_ParseRequest_ValidateRequest</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="ValidateRequest" name="Validate request">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="a2a-validate" resultVariable="verdict" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ParseRequest_ValidateRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateRequest_RouteRequest</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="RouteRequest" name="Route request" default="Flow_RouteRequest_PrepareLookup">
      <bpmn:incoming>Flow_ValidateRequest_RouteRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_RouteRequest_BuildValidationError</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteRequest_PrepareList</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteRequest_BuildDirectMessage</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteRequest_PrepareNewTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteRequest_PrepareLookup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="BuildValidationError" name="Build validation error">
      <bpmn:extensionElements>
        <zeebe:script expression="={jsonrpc: &#34;2.0&#34;, id: ctx.id, error: if verdict.reason = null then {code: verdict.code, message: verdict.message} else {code: verdict.code, message: verdict.message, data: [{&#34;@type&#34;: &#34;type.googleapis.com/google.rpc.ErrorInfo&#34;, reason: verdict.reason, domain: &#34;a2a-protocol.org&#34;}]}}" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_BuildValidationError</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildValidationError_ValidationErrorReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="ValidationErrorReady" name="Error response ready">
      <bpmn:incoming>Flow_BuildValidationError_ValidationErrorReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="PrepareList" name="Prepare task list">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for s in [if ctx.listContextId != null then replace(ctx.listContextId, &#34;[^A-Za-z0-9_:.-]&#34;, &#34;_&#34;) else &#34;&#34;] return {ctxTag: if ctx.listContextId != null then &#34;ctx-&#34; + (if string length(s) &#62; 90 then substring(s, 1, 90) else s) else null, size: if ctx.pageSize &#60; 1 then 50 else if ctx.pageSize &#62; 100 then 100 else ctx.pageSize, start: if ctx.pageToken != null and number(ctx.pageToken) != null then number(ctx.pageToken) else 0})[1]" resultVariable="listReq" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_PrepareList</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareList_SearchTasks</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="SearchTasks" name="Search task instances" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}/v2/process-instances/search&#34;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={filter: {processDefinitionId: &#34;a2a-task&#34;, state: &#34;ACTIVE&#34;, tags: if listReq.ctxTag != null then [&#34;a2a&#34;, listReq.ctxTag] else [&#34;a2a&#34;]}, sort: [{field: &#34;startDate&#34;, order: &#34;DESC&#34;}], page: {limit: 100}}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="18" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={taskIds: for i in response.body.items return (for t in i.tags[starts with(item, &#34;task-&#34;)] return substring(t, 6))[1]}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrepareList_SearchTasks</bpmn:incoming>
      <bpmn:outgoing>Flow_SearchTasks_AnyTasks</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="AnyTasks" name="Any tasks found?" default="Flow_AnyTasks_ListJoin">
      <bpmn:incoming>Flow_SearchTasks_AnyTasks</bpmn:incoming>
      <bpmn:outgoing>Flow_AnyTasks_FetchTasks</bpmn:outgoing>
      <bpmn:outgoing>Flow_AnyTasks_ListJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="FetchTasks" name="Fetch each task">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-fetch-task" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=taskIdItem" target="taskId" />
          <zeebe:input source="=ctx.hl" target="historyLength" />
          <zeebe:output source="=if is defined(taskView) then taskView else null" target="taskView" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AnyTasks_FetchTasks</bpmn:incoming>
      <bpmn:outgoing>Flow_FetchTasks_ListJoin</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=taskIds" inputElement="taskIdItem" outputCollection="taskViews" outputElement="=if is defined(taskView) then taskView else null" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="ListJoin" name="Tasks collected">
      <bpmn:incoming>Flow_AnyTasks_ListJoin</bpmn:incoming>
      <bpmn:incoming>Flow_FetchTasks_ListJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ListJoin_BuildTaskList</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="BuildTaskList" name="Build task list">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for views in [if is defined(taskViews) and taskViews != null then taskViews[item != null] else []] return for found in [sort(views[(ctx.listContextId = null or item.contextId = ctx.listContextId) and (ctx.listStatus = null or item.status.state = ctx.listStatus) and (ctx.listAfter = null or item.status.timestamp &#62; ctx.listAfter)], function(a, b) a.status.timestamp &#62; b.status.timestamp)] return for left in [count(found) - listReq.start] return for page in [if left &#60;= 0 then [] else sublist(found, listReq.start + 1, if left &#60; listReq.size then left else listReq.size)] return {jsonrpc: &#34;2.0&#34;, id: ctx.id, result: { tasks: for t in page return if ctx.includeArtifacts then t else context(get entries(t)[item.key != &#34;artifacts&#34;]), nextPageToken: if listReq.start + listReq.size &#60; count(found) then string(listReq.start + listReq.size) else &#34;&#34;, pageSize: listReq.size, totalSize: count(found)}})[1][1][1][1]" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ListJoin_BuildTaskList</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildTaskList_TaskListReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="TaskListReady" name="Task list ready">
      <bpmn:incoming>Flow_BuildTaskList_TaskListReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="BuildDirectMessage" name="Build direct message response">
      <bpmn:extensionElements>
        <zeebe:script expression="={jsonrpc: &#34;2.0&#34;, id: ctx.id, result: {message: {messageId: uuid(), contextId: if ctx.contextId != null then ctx.contextId else uuid(), role: &#34;ROLE_AGENT&#34;, parts: [{text: &#34;Direct message response&#34;}]}}}" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_BuildDirectMessage</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildDirectMessage_DirectMessageReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="DirectMessageReady" name="Message response ready">
      <bpmn:incoming>Flow_BuildDirectMessage_DirectMessageReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="PrepareNewTask" name="Prepare new task">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for cid in [if ctx.contextId != null then ctx.contextId else uuid()] return for s in [replace(cid, &#34;[^A-Za-z0-9_:.-]&#34;, &#34;_&#34;)] return {corrId: uuid(), phase: &#34;main&#34;, taskId: uuid(), contextId: cid, wrap: &#34;task&#34;, ctxTag: &#34;ctx-&#34; + (if string length(s) &#62; 90 then substring(s, 1, 90) else s)})[1][1]" resultVariable="lookup" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_PrepareNewTask</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareNewTask_CreateTask</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="CreateTask" name="Create task instance" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}/v2/process-instances&#34;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={processDefinitionId: &#34;a2a-task&#34;, variables: {taskId: lookup.taskId, contextId: lookup.contextId, req: {corrId: lookup.corrId, blocking: ctx.blocking, hl: ctx.hl, message: ctx.m, wrap: &#34;task&#34;, pushConfig: ctx.taskPush}}, tags: [&#34;a2a&#34;, &#34;task-&#34; + lookup.taskId, lookup.ctxTag]}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="18" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrepareNewTask_CreateTask</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateTask_WaitJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="PrepareLookup" name="Prepare lookup">
      <bpmn:extensionElements>
        <zeebe:script expression="= (for c in [uuid()] return if ctx.method = &#34;GetTask&#34; then {corrId: c, phase: &#34;main&#34;, msgName: &#34;a2a-get&#34;, taskId: ctx.ref, tries: 3, payload: {getReq: context(get entries({corrId: c, wrap: &#34;bare&#34;, historyLength: ctx.hl})[item.value != null])}} else if ctx.method = &#34;CancelTask&#34; then {corrId: c, phase: &#34;main&#34;, msgName: &#34;a2a-cancel&#34;, taskId: ctx.ref, tries: 3, payload: {cancelReq: {corrId: c, wrap: &#34;bare&#34;}}} else if list contains(ctx.pushMethods, ctx.method) then {corrId: c, phase: &#34;main&#34;, msgName: &#34;a2a-push&#34;, taskId: ctx.ref, tries: 3, payload: {pushReq: context(get entries({corrId: c, wrap: &#34;bare&#34;, op: ctx.method, configId: ctx.p.id, config: ctx.pushCfg, pageSize: ctx.pageSize})[item.value != null])}} else {corrId: c, phase: &#34;main&#34;, msgName: &#34;a2a-send&#34;, taskId: ctx.taskId, tries: 3, payload: {sendReq: context(get entries({corrId: c, wrap: &#34;task&#34;, message: ctx.m, historyLength: ctx.hl})[item.value != null])}})[1]" resultVariable="lookup" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_PrepareLookup</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareLookup_CorrelateJoin</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="CorrelateJoin" name="Correlate">
      <bpmn:incoming>Flow_PrepareLookup_CorrelateJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PrepareFollowUpProbe_CorrelateJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PrepareTimeoutProbe_CorrelateJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_CorrelateJoin_CorrelateToTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CorrelateToTask" name="Correlate message to task">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-correlate" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=lookup.msgName" target="messageName" />
          <zeebe:input source="=lookup.taskId" target="taskId" />
          <zeebe:input source="=lookup.payload" target="payload" />
          <zeebe:input source="=lookup.tries" target="tries" />
          <zeebe:output source="=correlated" target="correlated" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CorrelateJoin_CorrelateToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_CorrelateToTask_WasCorrelated</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="WasCorrelated" name="Task answered?" default="Flow_WasCorrelated_ProbeFollowUp">
      <bpmn:incoming>Flow_CorrelateToTask_WasCorrelated</bpmn:incoming>
      <bpmn:outgoing>Flow_WasCorrelated_WaitJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_WasCorrelated_ProbeFollowUp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ProbeFollowUp" name="Probe a follow-up?" default="Flow_ProbeFollowUp_BuildNotFound">
      <bpmn:incoming>Flow_WasCorrelated_ProbeFollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_ProbeFollowUp_PrepareFollowUpProbe</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProbeFollowUp_BuildNotFound</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="PrepareFollowUpProbe" name="Prepare follow-up probe">
      <bpmn:extensionElements>
        <zeebe:script expression="= (for c in [uuid()] return {corrId: c, phase: &#34;followProbe&#34;, msgName: &#34;a2a-get&#34;, taskId: lookup.taskId, tries: 2, payload: {getReq: {corrId: c, wrap: &#34;task&#34;}}})[1]" resultVariable="lookup" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ProbeFollowUp_PrepareFollowUpProbe</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareFollowUpProbe_CorrelateJoin</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="BuildNotFound" name="Build task not found error">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for e in [{code: -32001, message: &#34;Task not found&#34;, reason: &#34;TASK_NOT_FOUND&#34;}] return {jsonrpc: &#34;2.0&#34;, id: ctx.id, error: if e.reason = null then {code: e.code, message: e.message} else {code: e.code, message: e.message, data: [{&#34;@type&#34;: &#34;type.googleapis.com/google.rpc.ErrorInfo&#34;, reason: e.reason, domain: &#34;a2a-protocol.org&#34;}]}})[1]" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ProbeFollowUp_BuildNotFound</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildNotFound_NotFoundReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="NotFoundReady" name="Not found response ready">
      <bpmn:incoming>Flow_BuildNotFound_NotFoundReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="WaitJoin" name="Await reply">
      <bpmn:incoming>Flow_CreateTask_WaitJoin</bpmn:incoming>
      <bpmn:incoming>Flow_WasCorrelated_WaitJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitJoin_AwaitReply</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="AwaitReply" name="Await reply or timeout">
      <bpmn:incoming>Flow_WaitJoin_AwaitReply</bpmn:incoming>
      <bpmn:outgoing>Flow_AwaitReply_ReplyReceived</bpmn:outgoing>
      <bpmn:outgoing>Flow_AwaitReply_ReplyTimeout</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ReplyReceived" name="Reply received">
      <bpmn:incoming>Flow_AwaitReply_ReplyReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_ReplyReceived_IsFollowUpProbe</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ReplyReceived_def" messageRef="Msg_reply" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ReplyTimeout" name="Reply timed out">
      <bpmn:incoming>Flow_AwaitReply_ReplyTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_ReplyTimeout_AlreadyProbed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ReplyTimeout_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=if lookup.phase = "timeoutProbe" then "PT8S" else "PT25S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="IsFollowUpProbe" name="Follow-up probe?" default="Flow_IsFollowUpProbe_BuildResponse">
      <bpmn:incoming>Flow_ReplyReceived_IsFollowUpProbe</bpmn:incoming>
      <bpmn:outgoing>Flow_IsFollowUpProbe_BuildNotWaiting</bpmn:outgoing>
      <bpmn:outgoing>Flow_IsFollowUpProbe_BuildResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="BuildNotWaiting" name="Build not waiting error">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for e in [{code: -32004, message: &#34;Task is not waiting for input&#34;, reason: &#34;UNSUPPORTED_OPERATION&#34;}] return {jsonrpc: &#34;2.0&#34;, id: ctx.id, error: if e.reason = null then {code: e.code, message: e.message} else {code: e.code, message: e.message, data: [{&#34;@type&#34;: &#34;type.googleapis.com/google.rpc.ErrorInfo&#34;, reason: e.reason, domain: &#34;a2a-protocol.org&#34;}]}})[1]" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IsFollowUpProbe_BuildNotWaiting</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildNotWaiting_NotWaitingReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="NotWaitingReady" name="Not waiting response ready">
      <bpmn:incoming>Flow_BuildNotWaiting_NotWaitingReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="BuildResponse" name="Build response">
      <bpmn:extensionElements>
        <zeebe:script expression="=if is defined(replyError) and replyError != null then {jsonrpc: &#34;2.0&#34;, id: ctx.id, error: if replyError.reason = null then {code: replyError.code, message: replyError.message} else {code: replyError.code, message: replyError.message, data: [{&#34;@type&#34;: &#34;type.googleapis.com/google.rpc.ErrorInfo&#34;, reason: replyError.reason, domain: &#34;a2a-protocol.org&#34;}]}} else {jsonrpc: &#34;2.0&#34;, id: ctx.id, result: replyResult}" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IsFollowUpProbe_BuildResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildResponse_ResponseReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="ResponseReady" name="Response ready">
      <bpmn:incoming>Flow_BuildResponse_ResponseReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="AlreadyProbed" name="Already probed?" default="Flow_AlreadyProbed_PrepareTimeoutProbe">
      <bpmn:incoming>Flow_ReplyTimeout_AlreadyProbed</bpmn:incoming>
      <bpmn:outgoing>Flow_AlreadyProbed_BuildTimeoutError</bpmn:outgoing>
      <bpmn:outgoing>Flow_AlreadyProbed_PrepareTimeoutProbe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="BuildTimeoutError" name="Build timeout error">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for e in [{code: -32603, message: &#34;Internal error: the task did not answer in time&#34;}] return {jsonrpc: &#34;2.0&#34;, id: ctx.id, error: if e.reason = null then {code: e.code, message: e.message} else {code: e.code, message: e.message, data: [{&#34;@type&#34;: &#34;type.googleapis.com/google.rpc.ErrorInfo&#34;, reason: e.reason, domain: &#34;a2a-protocol.org&#34;}]}})[1]" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AlreadyProbed_BuildTimeoutError</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildTimeoutError_TimeoutReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="TimeoutReady" name="Timeout response ready">
      <bpmn:incoming>Flow_BuildTimeoutError_TimeoutReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="PrepareTimeoutProbe" name="Prepare timeout probe">
      <bpmn:extensionElements>
        <zeebe:script expression="= (for c in [uuid()] return {corrId: c, phase: &#34;timeoutProbe&#34;, msgName: &#34;a2a-get&#34;, taskId: lookup.taskId, tries: 2, payload: {getReq: {corrId: c, wrap: if ctx.method = &#34;SendMessage&#34; then &#34;task&#34; else &#34;bare&#34;}}})[1]" resultVariable="lookup" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AlreadyProbed_PrepareTimeoutProbe</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareTimeoutProbe_CorrelateJoin</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IsPushMethod" name="Push method?" default="Flow_IsPushMethod_PushSettingKnown">
      <bpmn:incoming>Flow_RpcReceived_IsPushMethod</bpmn:incoming>
      <bpmn:outgoing>Flow_IsPushMethod_ReadPushSetting</bpmn:outgoing>
      <bpmn:outgoing>Flow_IsPushMethod_PushSettingKnown</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ReadPushSetting" name="Read push setting" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}/v2/expression/evaluation&#34;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={expression: &#34;=\&#34;{{secrets.A2A_PUSH_ENABLED}}\&#34;&#34;}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="18" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={pushEnabled: response.body.result = &#34;true&#34;}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IsPushMethod_ReadPushSetting</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadPushSetting_PushSettingKnown</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PushSettingKnown" name="Push setting known">
      <bpmn:incoming>Flow_IsPushMethod_PushSettingKnown</bpmn:incoming>
      <bpmn:incoming>Flow_ReadPushSetting_PushSettingKnown</bpmn:incoming>
      <bpmn:outgoing>Flow_PushSettingKnown_ParseRequest</bpmn:outgoing>
    </bpmn:exclusiveGateway>
