      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=lookup.phase = "followProbe"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IsFollowUpProbe_BuildResponse" name="no" sourceRef="IsFollowUpProbe" targetRef="BuildResponse" />
    <bpmn:sequenceFlow id="Flow_BuildNotWaiting_NotWaitingReady" sourceRef="BuildNotWaiting" targetRef="NotWaitingReady" />
    <bpmn:sequenceFlow id="Flow_BuildResponse_ResponseReady" sourceRef="BuildResponse" targetRef="ResponseReady" />
    <bpmn:sequenceFlow id="Flow_ReplyTimeout_AlreadyProbed" sourceRef="ReplyTimeout" targetRef="AlreadyProbed" />
    <bpmn:sequenceFlow id="Flow_AlreadyProbed_BuildTimeoutError" name="yes" sourceRef="AlreadyProbed" targetRef="BuildTimeoutError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=lookup.phase = "timeoutProbe"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AlreadyProbed_PrepareTimeoutProbe" name="no" sourceRef="AlreadyProbed" targetRef="PrepareTimeoutProbe" />
    <bpmn:sequenceFlow id="Flow_BuildTimeoutError_TimeoutReady" sourceRef="BuildTimeoutError" targetRef="TimeoutReady" />
    <bpmn:sequenceFlow id="Flow_PrepareTimeoutProbe_CorrelateJoin" sourceRef="PrepareTimeoutProbe" targetRef="CorrelateJoin" />
    <bpmn:sequenceFlow id="Flow_RpcReceived_IsPushMethod" sourceRef="RpcReceived" targetRef="IsPushMethod" />
    <bpmn:sequenceFlow id="Flow_IsPushMethod_ReadPushSetting" name="push method" sourceRef="IsPushMethod" targetRef="ReadPushSetting">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rpc instance of context and rpc.method instance of string and list contains(["CreateTaskPushNotificationConfig", "GetTaskPushNotificationConfig", "ListTaskPushNotificationConfigs", "DeleteTaskPushNotificationConfig"], rpc.method)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
