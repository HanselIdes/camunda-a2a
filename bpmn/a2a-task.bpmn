<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_a2a_task" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Msg_get" name="a2a-get"><bpmn:extensionElements><zeebe:subscription correlationKey="=taskId" /></bpmn:extensionElements></bpmn:message>
  <bpmn:message id="Msg_cancel" name="a2a-cancel"><bpmn:extensionElements><zeebe:subscription correlationKey="=taskId" /></bpmn:extensionElements></bpmn:message>
  <bpmn:message id="Msg_send" name="a2a-send"><bpmn:extensionElements><zeebe:subscription correlationKey="=taskId" /></bpmn:extensionElements></bpmn:message>
  <bpmn:process id="a2a-task" name="A2A task" isExecutable="true">
    <bpmn:startEvent id="TaskSubmitted" name="Task submitted">
      <bpmn:outgoing>Flow_TaskSubmitted_CreateTaskState</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="CreateTaskState" name="Create task">
      <bpmn:extensionElements><zeebe:script expression='= {id: taskId, contextId: contextId, status: {state: "TASK_STATE_SUBMITTED", timestamp: substring(string(now()), 1, 19) + "Z"}, artifacts: [], history: [put(put(req.message, "taskId", taskId), "contextId", contextId)]}' resultVariable="task" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_TaskSubmitted_CreateTaskState</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateTaskState_SetPending</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="SetPending" name="Set reply pending">
      <bpmn:extensionElements><zeebe:script expression="=req.blocking" resultVariable="pending" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_CreateTaskState_SetPending</bpmn:incoming>
      <bpmn:outgoing>Flow_SetPending_ReturnImmediately</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ReturnImmediately" name="Return immediately?" default="Flow_ReturnImmediately_InitDone">
      <bpmn:incoming>Flow_SetPending_ReturnImmediately</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnImmediately_BuildInitialReply</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReturnImmediately_InitDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="BuildInitialReply" name="Build initial reply">
      <bpmn:extensionElements><zeebe:script expression='=(for v in [(for h in [if req.hl = null or req.hl &gt;= count(task.history) then task.history else if req.hl &lt;= 0 then [] else sublist(task.history, count(task.history) - req.hl + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &gt; 0 then task.artifacts else null, history: if count(h) &gt; 0 then h else null})[item.value != null]))[1]] return if "task" = "task" then {task: v} else v)[1]' resultVariable="initialReply" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ReturnImmediately_BuildInitialReply</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildInitialReply_PublishInitialReply</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="PublishInitialReply" name="Publish initial reply">
      <bpmn:extensionElements><zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="=req.corrId" target="corrId" /><zeebe:input source="=initialReply" target="replyResult" /><zeebe:input source="=null" target="replyError" /></zeebe:ioMapping></bpmn:extensionElements>
      <bpmn:incoming>Flow_BuildInitialReply_PublishInitialReply</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishInitialReply_InitDone</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="InitDone" name="Task initialised">
      <bpmn:incoming>Flow_ReturnImmediately_InitDone</bpmn:incoming>
      <bpmn:incoming>Flow_PublishInitialReply_InitDone</bpmn:incoming>
      <bpmn:outgoing>Flow_InitDone_Active</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Active" name="Process task">
      <bpmn:incoming>Flow_InitDone_Active</bpmn:incoming>
      <bpmn:outgoing>Flow_Active_TerminalJoin</bpmn:outgoing>
      <bpmn:startEvent id="MessageAccepted" name="Message accepted">
        <bpmn:outgoing>Flow_MessageAccepted_ClassifyJoin</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="ClassifyJoin" name="Classify next message">
        <bpmn:incoming>Flow_MessageAccepted_ClassifyJoin</bpmn:incoming>
        <bpmn:incoming>Flow_SetPendingAgain_ClassifyJoin</bpmn:incoming>
        <bpmn:outgoing>Flow_ClassifyJoin_ClassifyMessage</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:businessRuleTask id="ClassifyMessage" name="Classify message">
        <bpmn:extensionElements><zeebe:calledDecision decisionId="a2a-classify" resultVariable="sc" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_ClassifyJoin_ClassifyMessage</bpmn:incoming>
        <bpmn:outgoing>Flow_ClassifyMessage_ApplyScenario</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:scriptTask id="ApplyScenario" name="Apply scenario">
        <bpmn:extensionElements><zeebe:script expression='= (for m in [if sc.statusText != null then {messageId: uuid(), contextId: task.contextId, taskId: task.id, role: "ROLE_AGENT", parts: [{text: sc.statusText}]} else if sc.echo then {messageId: uuid(), contextId: task.contextId, taskId: task.id, role: "ROLE_AGENT", parts: [{text: "Unhandled messageId prefix: " + req.message.messageId}]} else null] return for a in [if sc.artifact = null then null else {artifactId: uuid(), name: "output", parts: if sc.artifact = "text" then [{text: "Generated text content"}] else if sc.artifact = "file" then [{raw: "dGNr", mediaType: "text/plain", filename: "output.txt"}] else if sc.artifact = "file-url" then [{url: "https://example.com/output.txt", mediaType: "text/plain", filename: "output.txt"}] else [{data: {key: "value", count: 42}}]}] return {id: task.id, contextId: task.contextId, status: context(get entries({state: sc.state, message: m, timestamp: substring(string(now()), 1, 19) + "Z"})[item.value != null]), artifacts: if a = null then task.artifacts else append(task.artifacts, a), history: if m != null then append(task.history, m) else task.history})[1][1]' resultVariable="task" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_ClassifyMessage_ApplyScenario</bpmn:incoming>
        <bpmn:outgoing>Flow_ApplyScenario_IsPending</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="IsPending" name="Reply pending?" default="Flow_IsPending_ReplyHandled">
        <bpmn:incoming>Flow_ApplyScenario_IsPending</bpmn:incoming>
        <bpmn:outgoing>Flow_IsPending_BuildReply</bpmn:outgoing>
        <bpmn:outgoing>Flow_IsPending_ReplyHandled</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="BuildReply" name="Build reply">
        <bpmn:extensionElements><zeebe:script expression='=(for v in [(for h in [if req.hl = null or req.hl &gt;= count(task.history) then task.history else if req.hl &lt;= 0 then [] else sublist(task.history, count(task.history) - req.hl + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &gt; 0 then task.artifacts else null, history: if count(h) &gt; 0 then h else null})[item.value != null]))[1]] return if "task" = "task" then {task: v} else v)[1]' resultVariable="workReply" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_IsPending_BuildReply</bpmn:incoming>
        <bpmn:outgoing>Flow_BuildReply_PublishReply</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:callActivity id="PublishReply" name="Publish reply">
        <bpmn:extensionElements><zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="=req.corrId" target="corrId" /><zeebe:input source="=workReply" target="replyResult" /><zeebe:input source="=null" target="replyError" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_BuildReply_PublishReply</bpmn:incoming>
        <bpmn:outgoing>Flow_PublishReply_MarkReplied</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:scriptTask id="MarkReplied" name="Mark replied">
        <bpmn:extensionElements><zeebe:script expression="=false" resultVariable="pending" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_PublishReply_MarkReplied</bpmn:incoming>
        <bpmn:outgoing>Flow_MarkReplied_ReplyHandled</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="ReplyHandled" name="Reply handled">
        <bpmn:incoming>Flow_IsPending_ReplyHandled</bpmn:incoming>
        <bpmn:incoming>Flow_MarkReplied_ReplyHandled</bpmn:incoming>
        <bpmn:outgoing>Flow_ReplyHandled_InputRequired</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="InputRequired" name="Input required?" default="Flow_InputRequired_WorkFinished">
        <bpmn:incoming>Flow_ReplyHandled_InputRequired</bpmn:incoming>
        <bpmn:outgoing>Flow_InputRequired_WorkFinished</bpmn:outgoing>
        <bpmn:outgoing>Flow_InputRequired_FollowJoin</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="WorkFinished" name="Work finished">
        <bpmn:incoming>Flow_InputRequired_WorkFinished</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="FollowJoin" name="Await follow-up">
        <bpmn:incoming>Flow_InputRequired_FollowJoin</bpmn:incoming>
        <bpmn:incoming>Flow_PublishMismatch_FollowJoin</bpmn:incoming>
        <bpmn:outgoing>Flow_FollowJoin_FollowUpArrives</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="FollowUpArrives" name="Follow-up arrives">
        <bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=sendReq" target="followReq" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_FollowJoin_FollowUpArrives</bpmn:incoming>
        <bpmn:outgoing>Flow_FollowUpArrives_ContextMatches</bpmn:outgoing>
        <bpmn:messageEventDefinition id="FollowUpArrives_def" messageRef="Msg_send" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="ContextMatches" name="Context matches?" default="Flow_ContextMatches_BuildContextMismatch">
        <bpmn:incoming>Flow_FollowUpArrives_ContextMatches</bpmn:incoming>
        <bpmn:outgoing>Flow_ContextMatches_RecordUserMessage</bpmn:outgoing>
        <bpmn:outgoing>Flow_ContextMatches_BuildContextMismatch</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="BuildContextMismatch" name="Build context mismatch error">
        <bpmn:extensionElements><zeebe:script expression='={code: -32602, message: "contextId does not match the task"}' resultVariable="mismatchError" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_ContextMatches_BuildContextMismatch</bpmn:incoming>
        <bpmn:outgoing>Flow_BuildContextMismatch_PublishMismatch</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:callActivity id="PublishMismatch" name="Publish mismatch error">
        <bpmn:extensionElements><zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="=followReq.corrId" target="corrId" /><zeebe:input source="=null" target="replyResult" /><zeebe:input source="=mismatchError" target="replyError" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_BuildContextMismatch_PublishMismatch</bpmn:incoming>
        <bpmn:outgoing>Flow_PublishMismatch_FollowJoin</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:scriptTask id="RecordUserMessage" name="Record user message">
        <bpmn:extensionElements><zeebe:script expression='= {id: task.id, contextId: task.contextId, status: {state: "TASK_STATE_WORKING", timestamp: substring(string(now()), 1, 19) + "Z"}, artifacts: task.artifacts, history: append(task.history, put(put(followReq.message, "taskId", task.id), "contextId", task.contextId))}' resultVariable="task" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_ContextMatches_RecordUserMessage</bpmn:incoming>
        <bpmn:outgoing>Flow_RecordUserMessage_SetRequest</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="SetRequest" name="Set current request">
        <bpmn:extensionElements><zeebe:script expression='={corrId: followReq.corrId, blocking: true, hl: followReq.historyLength, message: followReq.message, wrap: "task"}' resultVariable="req" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_RecordUserMessage_SetRequest</bpmn:incoming>
        <bpmn:outgoing>Flow_SetRequest_SetPendingAgain</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="SetPendingAgain" name="Set reply pending again">
        <bpmn:extensionElements><zeebe:script expression="=true" resultVariable="pending" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_SetRequest_SetPendingAgain</bpmn:incoming>
        <bpmn:outgoing>Flow_SetPendingAgain_ClassifyJoin</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:subProcess id="ActiveGet" name="Answer GetTask" triggeredByEvent="true">
        <bpmn:startEvent id="GetWhileActive" name="GetTask while active" isInterrupting="false">
          <bpmn:outgoing>Flow_GetWhileActive_BuildActiveView</bpmn:outgoing>
          <bpmn:messageEventDefinition id="GetWhileActive_def" messageRef="Msg_get" />
        </bpmn:startEvent>
        <bpmn:scriptTask id="BuildActiveView" name="Build task view">
          <bpmn:extensionElements><zeebe:script expression='=(for v in [(for h in [if getReq.historyLength = null or getReq.historyLength &gt;= count(task.history) then task.history else if getReq.historyLength &lt;= 0 then [] else sublist(task.history, count(task.history) - getReq.historyLength + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &gt; 0 then task.artifacts else null, history: if count(h) &gt; 0 then h else null})[item.value != null]))[1]] return if getReq.wrap = "task" then {task: v} else v)[1]' resultVariable="getView" /></bpmn:extensionElements>
          <bpmn:incoming>Flow_GetWhileActive_BuildActiveView</bpmn:incoming>
          <bpmn:outgoing>Flow_BuildActiveView_PublishActiveView</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:callActivity id="PublishActiveView" name="Publish task view">
          <bpmn:extensionElements><zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="=getReq.corrId" target="corrId" /><zeebe:input source="=getView" target="replyResult" /><zeebe:input source="=null" target="replyError" /></zeebe:ioMapping></bpmn:extensionElements>
          <bpmn:incoming>Flow_BuildActiveView_PublishActiveView</bpmn:incoming>
          <bpmn:outgoing>Flow_PublishActiveView_ActiveViewPublished</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:endEvent id="ActiveViewPublished" name="View published">
          <bpmn:incoming>Flow_PublishActiveView_ActiveViewPublished</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_GetWhileActive_BuildActiveView" sourceRef="GetWhileActive" targetRef="BuildActiveView" />
        <bpmn:sequenceFlow id="Flow_BuildActiveView_PublishActiveView" sourceRef="BuildActiveView" targetRef="PublishActiveView" />
        <bpmn:sequenceFlow id="Flow_PublishActiveView_ActiveViewPublished" sourceRef="PublishActiveView" targetRef="ActiveViewPublished" />
      </bpmn:subProcess>
      <bpmn:subProcess id="ActiveCancel" name="Cancel task" triggeredByEvent="true">
        <bpmn:startEvent id="CancelWhileActive" name="CancelTask while active">
          <bpmn:outgoing>Flow_CancelWhileActive_MarkCanceled</bpmn:outgoing>
          <bpmn:messageEventDefinition id="CancelWhileActive_def" messageRef="Msg_cancel" />
        </bpmn:startEvent>
        <bpmn:scriptTask id="MarkCanceled" name="Mark canceled">
          <bpmn:extensionElements><zeebe:script expression='= {id: task.id, contextId: task.contextId, status: {state: "TASK_STATE_CANCELED", timestamp: substring(string(now()), 1, 19) + "Z"}, artifacts: task.artifacts, history: task.history}' resultVariable="task" /></bpmn:extensionElements>
          <bpmn:incoming>Flow_CancelWhileActive_MarkCanceled</bpmn:incoming>
          <bpmn:outgoing>Flow_MarkCanceled_BuildCancelView</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:scriptTask id="BuildCancelView" name="Build canceled task view">
          <bpmn:extensionElements><zeebe:script expression='=(for v in [(for h in [if null = null or null &gt;= count(task.history) then task.history else if null &lt;= 0 then [] else sublist(task.history, count(task.history) - null + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &gt; 0 then task.artifacts else null, history: if count(h) &gt; 0 then h else null})[item.value != null]))[1]] return if cancelReq.wrap = "task" then {task: v} else v)[1]' resultVariable="cancelView" /></bpmn:extensionElements>
          <bpmn:incoming>Flow_MarkCanceled_BuildCancelView</bpmn:incoming>
          <bpmn:outgoing>Flow_BuildCancelView_PublishCancelView</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:callActivity id="PublishCancelView" name="Publish canceled task">
          <bpmn:extensionElements><zeebe:calledElement processId="a2a-publish-reply" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="=cancelReq.corrId" target="corrId" /><zeebe:input source="=cancelView" target="replyResult" /><zeebe:input source="=null" target="replyError" /></zeebe:ioMapping></bpmn:extensionElements>
          <bpmn:incoming>Flow_BuildCancelView_PublishCancelView</bpmn:incoming>
          <bpmn:outgoing>Flow_PublishCancelView_CancelPublished</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:endEvent id="CancelPublished" name="Cancel published">
          <bpmn:incoming>Flow_PublishCancelView_CancelPublished</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_CancelWhileActive_MarkCanceled" sourceRef="CancelWhileActive" targetRef="MarkCanceled" />
        <bpmn:sequenceFlow id="Flow_MarkCanceled_BuildCancelView" sourceRef="MarkCanceled" targetRef="BuildCancelView" />
        <bpmn:sequenceFlow id="Flow_BuildCancelView_PublishCancelView" sourceRef="BuildCancelView" targetRef="PublishCancelView" />
        <bpmn:sequenceFlow id="Flow_PublishCancelView_CancelPublished" sourceRef="PublishCancelView" targetRef="CancelPublished" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_MessageAccepted_ClassifyJoin" sourceRef="MessageAccepted" targetRef="ClassifyJoin" />
      <bpmn:sequenceFlow id="Flow_ClassifyJoin_ClassifyMessage" sourceRef="ClassifyJoin" targetRef="ClassifyMessage" />
      <bpmn:sequenceFlow id="Flow_ClassifyMessage_ApplyScenario" sourceRef="ClassifyMessage" targetRef="ApplyScenario" />
      <bpmn:sequenceFlow id="Flow_ApplyScenario_IsPending" sourceRef="ApplyScenario" targetRef="IsPending" />
      <bpmn:sequenceFlow id="Flow_IsPending_BuildReply" sourceRef="IsPending" targetRef="BuildReply" name="yes">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=pending = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_IsPending_ReplyHandled" sourceRef="IsPending" targetRef="ReplyHandled" name="no" />
      <bpmn:sequenceFlow id="Flow_BuildReply_PublishReply" sourceRef="BuildReply" targetRef="PublishReply" />
      <bpmn:sequenceFlow id="Flow_PublishReply_MarkReplied" sourceRef="PublishReply" targetRef="MarkReplied" />
      <bpmn:sequenceFlow id="Flow_MarkReplied_ReplyHandled" sourceRef="MarkReplied" targetRef="ReplyHandled" />
      <bpmn:sequenceFlow id="Flow_ReplyHandled_InputRequired" sourceRef="ReplyHandled" targetRef="InputRequired" />
      <bpmn:sequenceFlow id="Flow_InputRequired_WorkFinished" sourceRef="InputRequired" targetRef="WorkFinished" name="no" />
      <bpmn:sequenceFlow id="Flow_InputRequired_FollowJoin" sourceRef="InputRequired" targetRef="FollowJoin" name="yes">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task.status.state = "TASK_STATE_INPUT_REQUIRED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_FollowJoin_FollowUpArrives" sourceRef="FollowJoin" targetRef="FollowUpArrives" />
      <bpmn:sequenceFlow id="Flow_FollowUpArrives_ContextMatches" sourceRef="FollowUpArrives" targetRef="ContextMatches" />
      <bpmn:sequenceFlow id="Flow_ContextMatches_RecordUserMessage" sourceRef="ContextMatches" targetRef="RecordUserMessage" name="yes">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=followReq.message.contextId = null or followReq.message.contextId = task.contextId</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ContextMatches_BuildContextMismatch" sourceRef="ContextMatches" targetRef="BuildContextMismatch" name="no" />
      <bpmn:sequenceFlow id="Flow_BuildContextMismatch_PublishMismatch" sourceRef="BuildContextMismatch" targetRef="PublishMismatch" />
      <bpmn:sequenceFlow id="Flow_PublishMismatch_FollowJoin" sourceRef="PublishMismatch" targetRef="FollowJoin" />
      <bpmn:sequenceFlow id="Flow_RecordUserMessage_SetRequest" sourceRef="RecordUserMessage" targetRef="SetRequest" />
      <bpmn:sequenceFlow id="Flow_SetRequest_SetPendingAgain" sourceRef="SetRequest" targetRef="SetPendingAgain" />
      <bpmn:sequenceFlow id="Flow_SetPendingAgain_ClassifyJoin" sourceRef="SetPendingAgain" targetRef="ClassifyJoin" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="TerminalJoin" name="Await terminal requests">
      <bpmn:incoming>Flow_Active_TerminalJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PublishTerminalView_TerminalJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PublishNotCancelable_TerminalJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PublishTerminalSendError_TerminalJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_TerminalJoin_AwaitTerminal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="AwaitTerminal" name="Await requests or expiry">
      <bpmn:incoming>Flow_TerminalJoin_AwaitTerminal</bpmn:incoming>
      <bpmn:outgoing>Flow_AwaitTerminal_TerminalGet</bpmn:outgoing>
      <bpmn:outgoing>Flow_AwaitTerminal_TerminalCancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_AwaitTerminal_TerminalSend</bpmn:outgoing>
      <bpmn:outgoing>Flow_AwaitTerminal_TaskExpires</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="TerminalGet" name="GetTask in terminal state">
      <bpmn:incoming>Flow_AwaitTerminal_TerminalGet</bpmn:incoming>
      <bpmn:outgoing>Flow_TerminalGet_BuildTerminalView</bpmn:outgoing>
      <bpmn:messageEventDefinition id="TerminalGet_def" messageRef="Msg_get" />
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="BuildTerminalView" name="Build task view">
      <bpmn:extensionElements><zeebe:script expression='=(for v in [(for h in [if getReq.historyLength = null or getReq.historyLength &gt;= count(task.history) then task.history else if getReq.historyLength &lt;= 0 then [] else sublist(task.history, count(task.history) - getReq.historyLength + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &gt; 0 then task.artifacts else null, history: if count(h) &gt; 0 then h else null})[item.value != null]))[1]] return if getReq.wrap = "task" then {task: v} else v)[1]' resultVariable="terminalView" /></bpmn:extensionElements>
