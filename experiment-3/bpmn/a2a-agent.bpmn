<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Collaboration_a2a_agent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_a2a_agent">
    <bpmn:documentation>An A2A 1.0 server agent: the Agent Card and one A2A task, worked on by an AI agent with its tools. Everything protocol-specific (JSON-RPC, task state, push notifications) is in a2a-protocol.bpmn, which is deployed unchanged next to this diagram.</bpmn:documentation>
    <bpmn:participant id="Pool_a2a-card" name="Agent Card" processRef="a2a-card" />
    <bpmn:participant id="Pool_a2a-agent" name="A2A task" processRef="a2a-agent" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_followUp" name="a2a-send">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=task.id" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="AgentFailed" name="AgentFailed" errorCode="AGENT_FAILED" />
  <bpmn:process id="a2a-card" name="A2A Agent Card" isExecutable="true">
    <bpmn:startEvent id="CardRequested" name="Agent Card requested" zeebe:modelerTemplate="dev.hansel.a2a.server.card.v1" zeebe:modelerTemplateVersion="4" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
          <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
          <zeebe:property name="inbound.auth.type" value="NONE" />
          <zeebe:property name="synchronousResponse" value="false" />
          <zeebe:property name="consumeUnmatchedEvents" value="true" />
          <zeebe:property name="deduplicationModeManualFlag" value="false" />
          <zeebe:property name="deduplicationMode" value="AUTO" />
          <zeebe:property name="inbound.method" value="get" />
          <zeebe:property name="inbound.context" value="a2a-card" />
          <zeebe:property name="inbound.responseExpression" value="={card: {name: &#34;Task agent&#34;, description: &#34;Answers questions with its tools and asks for clarification when a request is ambiguous.&#34;, version: &#34;1.0.0&#34;, provider: {organization: &#34;camunda-a2a&#34;, url: &#34;https://github.com/HanselIdes/camunda-a2a&#34;}, skills: [{id: &#34;convert_temperature&#34;, name: &#34;Convert temperature&#34;, description: &#34;Converts a temperature between celsius, fahrenheit and kelvin. Returns the converted value and its unit. Use it for every temperature conversion instead of calculating yourself.&#34;, tags: [&#34;temperature&#34;, &#34;conversion&#34;], examples: [&#34;Convert 100 celsius to fahrenheit&#34;, &#34;What is 50 fahrenheit in kelvin?&#34;]}, {id: &#34;list_tech_devices&#34;, name: &#34;Get list of all Tech Stuff&#34;, description: &#34;Lists the devices (phones, laptops, tablets and similar) in a public sample catalog (api.restful-api.dev). The catalog is demo data, not a real inventory.&#34;, tags: [&#34;devices&#34;, &#34;catalog&#34;], examples: [&#34;Which tech devices are in the catalog?&#34;, &#34;List the phones you know&#34;]}]}, response: {statusCode: 200, headers: {&#34;Content-Type&#34;: &#34;application/json&#34;, &#34;Cache-Control&#34;: &#34;public, max-age=300&#34;, &#34;ETag&#34;: &#34;\&#34;5206a40f1f55e018\&#34;&#34;, &#34;Last-Modified&#34;: &#34;Thu, 15 Oct 2026 12:00:00 GMT&#34;}, body: context merge([card, { supportedInterfaces: [{url: &#34;{{secrets.A2A_PUBLIC_URL}}/a2a&#34;, protocolBinding: &#34;JSONRPC&#34;, protocolVersion: &#34;1.0&#34;}], capabilities: {streaming: false, pushNotifications: &#34;{{secrets.A2A_PUSH_ENABLED}}&#34; = &#34;true&#34;, extendedAgentCard: false}, defaultInputModes: [&#34;text/plain&#34;, &#34;application/json&#34;], defaultOutputModes: [&#34;text/plain&#34;, &#34;application/json&#34;]}])}}.response" />
          <zeebe:property name="resultVariable" value="" />
          <zeebe:property name="resultExpression" value="" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_CardRequested_CardServed</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="CardServed" name="Card served">
      <bpmn:incoming>Flow_CardRequested_CardServed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CardRequested_CardServed" sourceRef="CardRequested" targetRef="CardServed" />
  </bpmn:process>
  <bpmn:process id="a2a-agent" name="A2A task" isExecutable="true">
    <bpmn:callActivity id="UpdateTask" name="Update A2A task">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-task-update" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=task" target="task" />
          <zeebe:input source="={agent: agent}" target="outcome" />
          <zeebe:output source="=task" target="task" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AgentTools_UpdateTask</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateTask_InputRequired</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateCatchEvent id="FollowUp" name="Follow-up received">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="={id: task.id, contextId: task.contextId, rev: task.rev + 1, status: {state: &#34;TASK_STATE_WORKING&#34;, timestamp: substring(string(now()), 1, 19) + &#34;Z&#34;}, artifacts: task.artifacts, history: append(task.history, put(put(followUp.message, &#34;taskId&#34;, task.id), &#34;contextId&#34;, task.contextId))}" target="task" />
          <zeebe:output source="=followUp" target="req" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InputRequired_FollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUp_NextTurn</bpmn:outgoing>
      <bpmn:messageEventDefinition id="FollowUp_def" messageRef="Msg_followUp" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="InputRequired" name="Input required?" default="Flow_InputRequired_TaskDone">
      <bpmn:incoming>Flow_UpdateTask_InputRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_InputRequired_FollowUp</bpmn:outgoing>
      <bpmn:outgoing>Flow_InputRequired_TaskDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="TaskDone" name="Task done">
      <bpmn:incoming>Flow_InputRequired_TaskDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="NextTurn">
      <bpmn:incoming>Flow_TaskReceived_NextTurn</bpmn:incoming>
      <bpmn:incoming>Flow_FollowUp_NextTurn</bpmn:incoming>
      <bpmn:outgoing>Flow_NextTurn_AgentTools</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="TaskReceived" name="A2A task received">
      <bpmn:outgoing>Flow_TaskReceived_NextTurn</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:adHocSubProcess id="AgentTools" name="A2A Server Agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="openai" target="provider.type" />
          <zeebe:input source="completions" target="provider.openai.api.type" />
          <zeebe:input source="custom" target="provider.openai.backend.type" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_API_ENDPOINT}}" target="provider.openai.backend.custom.endpoint" />
          <zeebe:input source="apiKey" target="provider.openai.backend.custom.authentication.type" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_API_KEY}}" target="provider.openai.backend.custom.authentication.apiKey" />
          <zeebe:input source="PT180S" target="provider.openai.timeouts.timeout" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_DEFAULT_MODEL}}" target="provider.openai.model.model" />
          <zeebe:input source="modelDefault" target="provider.openai.api.completions.effort" />
          <zeebe:input source="=0" target="provider.openai.api.completions.temperature" />
          <zeebe:input source="=&#34;You are TaskAgent, a remote agent that A2A clients send tasks to. Answer each task from these sources, in this order:&#10;&#10;1. Your own tools. Use every tool that fits the task. Never invent a tool.&#10;2. The client. If the task is ambiguous, or you need information or work that your tools cannot give, start your reply with the exact marker NEED_INPUT: followed by your question, and call no tool.&#10;3. Your own knowledge, as a best-effort answer that you mark as such.&#10;&#10;Reply in plain text.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=string join(for part in req.message.parts return if part.text != null then part.text else &#34;&#34;, &#34; &#34;)" target="data.userPrompt.prompt" />
          <zeebe:input source="=agent.context" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=8" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="true" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="1" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" />
          <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;AGENT_FAILED&#34;, string(error.message)) else null" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult,&#10;  completedAt: now()&#10;}" />
        <zeebe:agentDefinition agentType="aiAgentSubProcess" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NextTurn_AgentTools</bpmn:incoming>
      <bpmn:outgoing>Flow_AgentTools_UpdateTask</bpmn:outgoing>
      <bpmn:scriptTask id="convert_temperature" name="Convert temperature">
        <bpmn:documentation>Converts a temperature between celsius, fahrenheit and kelvin. Returns the converted value and its unit. Use it for every temperature conversion instead of calculating yourself.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:properties>
            <zeebe:property name="a2a:tags" value="temperature,conversion" />
            <zeebe:property name="a2a:examples" value="Convert 100 celsius to fahrenheit|What is 50 fahrenheit in kelvin?" />
          </zeebe:properties>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.value, &#34;The temperature to convert&#34;, &#34;number&#34;)" target="value" />
            <zeebe:input source="=fromAi(toolCall.fromUnit, &#34;The unit of the value&#34;, &#34;string&#34;, {enum: [&#34;celsius&#34;, &#34;fahrenheit&#34;, &#34;kelvin&#34;]})" target="fromUnit" />
            <zeebe:input source="=fromAi(toolCall.toUnit, &#34;The unit to convert to&#34;, &#34;string&#34;, {enum: [&#34;celsius&#34;, &#34;fahrenheit&#34;, &#34;kelvin&#34;]})" target="toUnit" />
          </zeebe:ioMapping>
          <zeebe:script expression="={ celsius: if fromUnit = &#34;fahrenheit&#34; then (value - 32) * 5 / 9 else if fromUnit = &#34;kelvin&#34; then value - 273.15 else value, converted: if toUnit = &#34;fahrenheit&#34; then celsius * 9 / 5 + 32 else if toUnit = &#34;kelvin&#34; then celsius + 273.15 else celsius, result: {value: decimal(converted, 2), unit: toUnit}}.result" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="list_tech_devices" name="Get list of all Tech Stuff" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Lists the devices (phones, laptops, tablets and similar) in a public sample catalog (api.restful-api.dev). The catalog is demo data, not a real inventory.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:properties>
            <zeebe:property name="a2a:tags" value="devices,catalog" />
            <zeebe:property name="a2a:examples" value="Which tech devices are in the catalog?|List the phones you know" />
          </zeebe:properties>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="https://api.restful-api.dev/objects" target="url" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="JSON" target="documentReturnFormat.choice" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="18" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={toolCallResult: response.body}" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:callActivity id="ReportFailure" name="Report failure">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-task-update" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=task" target="task" />
          <zeebe:input source="={state: &#34;TASK_STATE_FAILED&#34;, text: &#34;The agent could not complete the request.&#34;}" target="outcome" />
          <zeebe:output source="=task" target="task" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AgentError_ReportFailure</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportFailure_TaskFailed</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="TaskFailed" name="Task failed">
      <bpmn:incoming>Flow_ReportFailure_TaskFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="AgentError" name="Agent failed" attachedToRef="AgentTools">
      <bpmn:outgoing>Flow_AgentError_ReportFailure</bpmn:outgoing>
      <bpmn:errorEventDefinition id="AgentError_def" errorRef="AgentFailed" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_AgentTools_UpdateTask" sourceRef="AgentTools" targetRef="UpdateTask" />
    <bpmn:sequenceFlow id="Flow_UpdateTask_InputRequired" sourceRef="UpdateTask" targetRef="InputRequired" />
    <bpmn:sequenceFlow id="Flow_InputRequired_FollowUp" name="yes" sourceRef="InputRequired" targetRef="FollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task.status.state = "TASK_STATE_INPUT_REQUIRED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FollowUp_NextTurn" sourceRef="FollowUp" targetRef="NextTurn" />
    <bpmn:sequenceFlow id="Flow_InputRequired_TaskDone" name="no" sourceRef="InputRequired" targetRef="TaskDone" />
    <bpmn:sequenceFlow id="Flow_TaskReceived_NextTurn" sourceRef="TaskReceived" targetRef="NextTurn" />
    <bpmn:sequenceFlow id="Flow_NextTurn_AgentTools" sourceRef="NextTurn" targetRef="AgentTools" />
    <bpmn:sequenceFlow id="Flow_AgentError_ReportFailure" sourceRef="AgentError" targetRef="ReportFailure" />
    <bpmn:sequenceFlow id="Flow_ReportFailure_TaskFailed" sourceRef="ReportFailure" targetRef="TaskFailed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_a2a_agent">
      <bpmndi:BPMNShape id="Pool_a2a-card_di" bpmnElement="Pool_a2a-card" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="336" height="116" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardRequested_di" bpmnElement="CardRequested">
        <dc:Bounds x="250" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="240" y="116" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardServed_di" bpmnElement="CardServed">
        <dc:Bounds x="380" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="368" y="116" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_CardRequested_CardServed_di" bpmnElement="Flow_CardRequested_CardServed">
        <di:waypoint x="286" y="98" />
        <di:waypoint x="380" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Pool_a2a-agent_di" bpmnElement="Pool_a2a-agent" isHorizontal="true">
        <dc:Bounds x="160" y="196" width="1116" height="500" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UpdateTask_di" bpmnElement="UpdateTask">
        <dc:Bounds x="900" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FollowUp_di" bpmnElement="FollowUp">
        <dc:Bounds x="1160" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1154" y="388" width="48" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InputRequired_di" bpmnElement="InputRequired" isMarkerVisible="true">
        <dc:Bounds x="1050" y="345" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1038" y="395" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskDone_di" bpmnElement="TaskDone">
        <dc:Bounds x="1160" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1153" y="498" width="51" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NextTurn_di" bpmnElement="NextTurn" isMarkerVisible="true">
        <dc:Bounds x="330" y="351" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskReceived_di" bpmnElement="TaskReceived">
        <dc:Bounds x="250" y="358" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="224" y="394" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AgentTools_di" bpmnElement="AgentTools" isExpanded="true">
        <dc:Bounds x="430" y="236" width="400" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="convert_temperature_di" bpmnElement="convert_temperature">
        <dc:Bounds x="495" y="336" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="list_tech_devices_di" bpmnElement="list_tech_devices">
        <dc:Bounds x="645" y="336" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReportFailure_di" bpmnElement="ReportFailure">
        <dc:Bounds x="900" y="576" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskFailed_di" bpmnElement="TaskFailed">
        <dc:Bounds x="1050" y="598" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1042" y="634" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AgentError_di" bpmnElement="AgentError">
        <dc:Bounds x="790" y="498" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="779" y="534" width="59" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_NextTurn_AgentTools_di" bpmnElement="Flow_NextTurn_AgentTools">
        <di:waypoint x="380" y="376" />
        <di:waypoint x="430" y="376" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AgentTools_UpdateTask_di" bpmnElement="Flow_AgentTools_UpdateTask">
        <di:waypoint x="830" y="370" />
        <di:waypoint x="900" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FollowUp_NextTurn_di" bpmnElement="Flow_FollowUp_NextTurn">
        <di:waypoint x="1178" y="352" />
        <di:waypoint x="1178" y="216" />
        <di:waypoint x="355" y="216" />
        <di:waypoint x="355" y="351" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AgentError_ReportFailure_di" bpmnElement="Flow_AgentError_ReportFailure">
        <di:waypoint x="808" y="534" />
        <di:waypoint x="808" y="616" />
        <di:waypoint x="900" y="616" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReportFailure_TaskFailed_di" bpmnElement="Flow_ReportFailure_TaskFailed">
        <di:waypoint x="1000" y="616" />
        <di:waypoint x="1050" y="616" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_UpdateTask_InputRequired_di" bpmnElement="Flow_UpdateTask_InputRequired">
        <di:waypoint x="1000" y="370" />
        <di:waypoint x="1050" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InputRequired_FollowUp_di" bpmnElement="Flow_InputRequired_FollowUp">
        <di:waypoint x="1100" y="370" />
