          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&quot;{{secrets.ENGINE_URL}}&quot; + &quot;/v2/process-instances&quot;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={processDefinitionId: &quot;a2a-push-notify&quot;, variables: {configs: for i in configItems return from json(i.value), payload: (for v in [(for h in [if null = null or null &gt;= count(task.history) then task.history else if null &lt;= 0 then [] else sublist(task.history, count(task.history) - null + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &gt; 0 then task.artifacts else null, history: if count(h) &gt; 0 then h else null})[item.value != null]))[1]] return if &quot;task&quot; = &quot;task&quot; then {task: v} else v)[1]}}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
