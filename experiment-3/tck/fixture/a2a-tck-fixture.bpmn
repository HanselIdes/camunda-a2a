<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_a2a_tck_fixture" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Msg_followUp" name="a2a-send"><bpmn:extensionElements><zeebe:subscription correlationKey="=task.id" /></bpmn:extensionElements></bpmn:message>
  <bpmn:process id="a2a-tck-fixture" name="A2A TCK fixture" isExecutable="true">
    <bpmn:startEvent id="TaskReceived" name="Task received">
      <bpmn:outgoing>Flow_TaskReceived_NextTurn</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="NextTurn">
      <bpmn:incoming>Flow_TaskReceived_NextTurn</bpmn:incoming>
      <bpmn:incoming>Flow_FollowUp_NextTurn</bpmn:incoming>
      <bpmn:outgoing>Flow_NextTurn_ClassifyMessage</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="ClassifyMessage" name="Classify message">
      <bpmn:extensionElements><zeebe:calledDecision decisionId="a2a-classify" resultVariable="sc" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_NextTurn_ClassifyMessage</bpmn:incoming>
      <bpmn:outgoing>Flow_ClassifyMessage_ApplyScenario</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="ApplyScenario" name="Apply scenario">
      <bpmn:extensionElements><zeebe:script expression='={state: sc.state, text: if sc.statusText != null then sc.statusText else if sc.echo then "Unhandled messageId prefix: " + req.message.messageId else null, artifacts: if sc.artifact = null then null else [{artifactId: uuid(), name: "output", parts: if sc.artifact = "text" then [{text: "Generated text content"}] else if sc.artifact = "file" then [{raw: "dGNr", mediaType: "text/plain", filename: "output.txt"}] else if sc.artifact = "file-url" then [{url: "https://example.com/output.txt", mediaType: "text/plain", filename: "output.txt"}] else [{data: {key: "value", count: 42}}]}]}' resultVariable="outcome" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ClassifyMessage_ApplyScenario</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplyScenario_UpdateTask</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="UpdateTask" name="Update A2A task">
      <bpmn:extensionElements><zeebe:calledElement processId="a2a-task-update" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="=task" target="task" /><zeebe:input source="=outcome" target="outcome" /><zeebe:output source="=task" target="task" /></zeebe:ioMapping></bpmn:extensionElements>
      <bpmn:incoming>Flow_ApplyScenario_UpdateTask</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateTask_InputRequired</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="InputRequired" name="Input required?" default="Flow_InputRequired_TaskDone">
      <bpmn:incoming>Flow_UpdateTask_InputRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_InputRequired_FollowUp</bpmn:outgoing>
      <bpmn:outgoing>Flow_InputRequired_TaskDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="FollowUp" name="Follow-up received">
      <bpmn:extensionElements><zeebe:ioMapping><zeebe:output source='={id: task.id, contextId: task.contextId, rev: task.rev + 1, status: {state: "TASK_STATE_WORKING", timestamp: substring(string(now()), 1, 19) + "Z"}, artifacts: task.artifacts, history: append(task.history, put(put(followUp.message, "taskId", task.id), "contextId", task.contextId))}' target="task" /><zeebe:output source="=followUp" target="req" /></zeebe:ioMapping></bpmn:extensionElements>
      <bpmn:incoming>Flow_InputRequired_FollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUp_NextTurn</bpmn:outgoing>
      <bpmn:messageEventDefinition id="FollowUp_def" messageRef="Msg_followUp" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="TaskDone" name="Task done">
      <bpmn:incoming>Flow_InputRequired_TaskDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TaskReceived_NextTurn" sourceRef="TaskReceived" targetRef="NextTurn" />
    <bpmn:sequenceFlow id="Flow_NextTurn_ClassifyMessage" sourceRef="NextTurn" targetRef="ClassifyMessage" />
    <bpmn:sequenceFlow id="Flow_ClassifyMessage_ApplyScenario" sourceRef="ClassifyMessage" targetRef="ApplyScenario" />
    <bpmn:sequenceFlow id="Flow_ApplyScenario_UpdateTask" sourceRef="ApplyScenario" targetRef="UpdateTask" />
    <bpmn:sequenceFlow id="Flow_UpdateTask_InputRequired" sourceRef="UpdateTask" targetRef="InputRequired" />
    <bpmn:sequenceFlow id="Flow_InputRequired_FollowUp" sourceRef="InputRequired" targetRef="FollowUp" name="yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task.status.state = "TASK_STATE_INPUT_REQUIRED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InputRequired_TaskDone" sourceRef="InputRequired" targetRef="TaskDone" name="no" />
    <bpmn:sequenceFlow id="Flow_FollowUp_NextTurn" sourceRef="FollowUp" targetRef="NextTurn" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="a2a-tck-fixture">
      <bpmndi:BPMNShape id="TaskReceived_di" bpmnElement="TaskReceived">
        <dc:Bounds x="150" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NextTurn_di" bpmnElement="NextTurn">
        <dc:Bounds x="230" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClassifyMessage_di" bpmnElement="ClassifyMessage">
        <dc:Bounds x="330" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApplyScenario_di" bpmnElement="ApplyScenario">
        <dc:Bounds x="480" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UpdateTask_di" bpmnElement="UpdateTask">
        <dc:Bounds x="630" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InputRequired_di" bpmnElement="InputRequired">
        <dc:Bounds x="780" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FollowUp_di" bpmnElement="FollowUp">
        <dc:Bounds x="890" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskDone_di" bpmnElement="TaskDone">
        <dc:Bounds x="890" y="372" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_TaskReceived_NextTurn_di" bpmnElement="Flow_TaskReceived_NextTurn">
        <di:waypoint x="186" y="280" />
        <di:waypoint x="230" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NextTurn_ClassifyMessage_di" bpmnElement="Flow_NextTurn_ClassifyMessage">
        <di:waypoint x="280" y="280" />
        <di:waypoint x="330" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ClassifyMessage_ApplyScenario_di" bpmnElement="Flow_ClassifyMessage_ApplyScenario">
        <di:waypoint x="430" y="280" />
        <di:waypoint x="480" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApplyScenario_UpdateTask_di" bpmnElement="Flow_ApplyScenario_UpdateTask">
        <di:waypoint x="580" y="280" />
        <di:waypoint x="630" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_UpdateTask_InputRequired_di" bpmnElement="Flow_UpdateTask_InputRequired">
        <di:waypoint x="730" y="280" />
        <di:waypoint x="780" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InputRequired_FollowUp_di" bpmnElement="Flow_InputRequired_FollowUp">
        <di:waypoint x="830" y="280" />
        <di:waypoint x="890" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InputRequired_TaskDone_di" bpmnElement="Flow_InputRequired_TaskDone">
        <di:waypoint x="805" y="305" />
        <di:waypoint x="805" y="390" />
        <di:waypoint x="890" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FollowUp_NextTurn_di" bpmnElement="Flow_FollowUp_NextTurn">
        <di:waypoint x="908" y="262" />
        <di:waypoint x="908" y="135" />
        <di:waypoint x="255" y="135" />
        <di:waypoint x="255" y="255" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
