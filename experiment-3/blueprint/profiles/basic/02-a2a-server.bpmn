<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Collaboration_a2a_protocol" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_a2a_protocol">
    <bpmn:documentation>The A2A 1.0 JSON-RPC binding, deployed unchanged next to an agent diagram. The endpoint starts the process named by the secret A2A_AGENT_PROCESS for each new task and answers every other method from engine state. Not meant to be edited.</bpmn:documentation>
    <bpmn:participant id="Pool_a2a-rpc" name="02 A2A Server - Protocol and Discovery" processRef="a2a-rpc" />
    <bpmn:participant id="Pool_a2a-task-update" name="Update A2A task (called by the agent)" processRef="a2a-task-update" />
    <bpmn:participant id="Pool_a2a-await" name="Wait until engine state is visible" processRef="a2a-await" />
    <bpmn:participant id="Pool_a2a-correlate" name="Hand a follow-up to a task" processRef="a2a-correlate" />
    <bpmn:participant id="Pool_a2a-list-collect" name="Collect all indexed task pages" processRef="a2a-list-collect" />
  </bpmn:collaboration>
  <bpmn:error id="NotFound" name="NotFound" errorCode="NOT_FOUND" />
  <bpmn:process id="a2a-rpc" name="02 A2A Server - Protocol and Discovery" isExecutable="true">
    <bpmn:startEvent id="RpcReceived" name="A2A request received" zeebe:modelerTemplate="dev.hansel.a2a.core.rpc.v1" zeebe:modelerTemplateVersion="1">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
          <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
          <zeebe:property name="inbound.auth.type" value="APIKEY" />
          <zeebe:property name="synchronousResponse" value="true" />
          <zeebe:property name="consumeUnmatchedEvents" value="true" />
          <zeebe:property name="deduplicationModeManualFlag" value="false" />
          <zeebe:property name="deduplicationMode" value="AUTO" />
          <zeebe:property name="inbound.method" value="post" />
          <zeebe:property name="inbound.context" value="a2a" />
          <zeebe:property name="inbound.responseExpression" value="={statusCode: 200, headers: {&quot;Content-Type&quot;: &quot;application/json&quot;}, body: correlation.variables.rpcResponse}" />
          <zeebe:property name="resultVariable" value="" />
          <zeebe:property name="resultExpression" value="={rpc: request.body, hdr: {&quot;content-type&quot;: request.headers.`content-type`, &quot;a2a-version&quot;: request.headers.`a2a-version`}}" />
          <zeebe:property name="inbound.auth.apiKey" value="=camunda.secrets.A2A_API_KEY" />
          <zeebe:property name="inbound.auth.apiKeyLocator" value="=request.headers.`x-a2a-api-key`" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_RpcReceived_IsPushMethod</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="IsPushMethod" name="Push involved?" default="Flow_IsPushMethod_PushSettingKnown">
      <bpmn:incoming>Flow_RpcReceived_IsPushMethod</bpmn:incoming>
      <bpmn:outgoing>Flow_IsPushMethod_ReadPushSetting</bpmn:outgoing>
      <bpmn:outgoing>Flow_IsPushMethod_PushSettingKnown</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ReadPushSetting" name="Read push setting">
      <bpmn:extensionElements>
        <zeebe:script expression="=false" resultVariable="pushEnabled" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IsPushMethod_ReadPushSetting</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadPushSetting_PushSettingKnown</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="PushSettingKnown">
      <bpmn:incoming>Flow_IsPushMethod_PushSettingKnown</bpmn:incoming>
      <bpmn:incoming>Flow_ReadPushSetting_PushSettingKnown</bpmn:incoming>
      <bpmn:outgoing>Flow_PushSettingKnown_ParseRequest</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ParseRequest" name="Parse request">
      <bpmn:extensionElements>
        <zeebe:script expression="={ r: if rpc instance of context then rpc else {}, p: if r.params instance of context then r.params else {}, m: if p.message instance of context then p.message else {}, cfg: if p.configuration instance of context then p.configuration else {}, ct: get value(hdr, &quot;content-type&quot;), ver: get value(hdr, &quot;a2a-version&quot;), supported: [&quot;text/plain&quot;, &quot;application/json&quot;], method: if r.method instance of string then r.method else null, id: r.id, versionOk: if ver instance of string then matches(ver, &quot;^1[.]0([.][0-9]+)?$&quot;) else false, contentTypeOk: if ct instance of string then (starts with(lower case(ct), &quot;application/json&quot;) or starts with(lower case(ct), &quot;application/a2a+json&quot;)) else false, jsonrpcOk: r.jsonrpc = &quot;2.0&quot; and method != null, msgOk: p.message instance of context and m.messageId instance of string and m.role instance of string and m.parts instance of list, mediaOk: if m.parts instance of list then not(some part in m.parts satisfies part instance of context and part.mediaType != null and not(list contains(supported, part.mediaType))) else true, pushMethods: [&quot;CreateTaskPushNotificationConfig&quot;, &quot;GetTaskPushNotificationConfig&quot;, &quot;ListTaskPushNotificationConfigs&quot;, &quot;DeleteTaskPushNotificationConfig&quot;], pushRef: if p.task_id instance of string then p.task_id else if p.taskId instance of string then p.taskId else null, ref: if method != null and list contains(pushMethods, method) then pushRef else if p.id instance of string then p.id else null, idOk: ref instance of string and ref != &quot;&quot;, pushEnabled: pushEnabled = true, pushCfg: context(get entries({id: p.id, url: p.url, token: p.token, authentication: p.authentication})[item.value != null]), taskPush: if cfg.taskPushNotificationConfig instance of context then cfg.taskPushNotificationConfig else null, taskId: if m.taskId instance of string and m.taskId != &quot;&quot; then m.taskId else null, contextId: if m.contextId instance of string and m.contextId != &quot;&quot; then m.contextId else null, messageId: if m.messageId instance of string then m.messageId else null, blocking: cfg.returnImmediately != true, hl: if cfg.historyLength instance of number then cfg.historyLength else if p.historyLength instance of number then p.historyLength else if p.history_length instance of number then p.history_length else null, pageSize: if p.pageSize instance of number then p.pageSize else if p.page_size instance of number then p.page_size else 50, listContextId: if p.contextId instance of string and p.contextId != &quot;&quot; then p.contextId else if p.context_id instance of string and p.context_id != &quot;&quot; then p.context_id else null, listStatus: if p.status instance of string and p.status != &quot;&quot; then p.status else null, listAfter: if p.statusTimestampAfter instance of string then p.statusTimestampAfter else if p.status_timestamp_after instance of string then p.status_timestamp_after else null, pageToken: if p.pageToken instance of string then p.pageToken else if p.page_token instance of string then p.page_token else null, includeArtifacts: p.includeArtifacts = true or p.include_artifacts = true }" resultVariable="ctx" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PushSettingKnown_ParseRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_ParseRequest_ValidateRequest</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="ValidateRequest" name="Validate request">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="a2a-validate" resultVariable="verdict" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ParseRequest_ValidateRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateRequest_RouteRequest</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="RouteRequest" name="Route request" default="Flow_RouteRequest_PrepareLookup">
      <bpmn:incoming>Flow_ValidateRequest_RouteRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_RouteRequest_BuildValidationError</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteRequest_PrepareList</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteRequest_PrepareNewTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteRequest_PrepareLookup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="BuildValidationError" name="Build validation error">
      <bpmn:extensionElements>
        <zeebe:script expression="={jsonrpc: &quot;2.0&quot;, id: ctx.id, error: if verdict.reason = null then {code: verdict.code, message: verdict.message} else {code: verdict.code, message: verdict.message, data: [{&quot;@type&quot;: &quot;type.googleapis.com/google.rpc.ErrorInfo&quot;, reason: verdict.reason, domain: &quot;a2a-protocol.org&quot;}]}}" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_BuildValidationError</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildValidationError_ValidationErrorReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="ValidationErrorReady" name="Error response ready">
      <bpmn:incoming>Flow_BuildValidationError_ValidationErrorReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="PrepareList" name="Prepare task list">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for s in [if ctx.listContextId != null then replace(ctx.listContextId, &quot;[^A-Za-z0-9_:.-]&quot;, &quot;_&quot;) else &quot;&quot;] return {ctxTag: if ctx.listContextId != null then &quot;ctx-&quot; + (if string length(s) &gt; 90 then substring(s, 1, 90) else s) else null, size: if ctx.pageSize &lt; 1 then 50 else if ctx.pageSize &gt; 100 then 100 else ctx.pageSize, start: if ctx.pageToken != null and number(ctx.pageToken) != null then number(ctx.pageToken) else 0})[1]" resultVariable="listReq" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_PrepareList</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareList_CollectTaskList</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="BuildTaskList" name="Build task list">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for taskViews in [if is defined(taskItems) and taskItems != null then for i in taskItems return (for task in [i.value] return (for h in [if ctx.hl = null or ctx.hl &gt;= count(task.history) then task.history else if ctx.hl &lt;= 0 then [] else sublist(task.history, count(task.history) - ctx.hl + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &gt; 0 then task.artifacts else null, history: if count(h) &gt; 0 then h else null})[item.value != null]))[1])[1] else []] return (for views in [if is defined(taskViews) and taskViews != null then taskViews[item != null] else []] return for found in [sort(views[(ctx.listContextId = null or item.contextId = ctx.listContextId) and (ctx.listStatus = null or item.status.state = ctx.listStatus) and (ctx.listAfter = null or item.status.timestamp &gt; ctx.listAfter)], function(a, b) if a.status.timestamp = b.status.timestamp then a.id &gt; b.id else a.status.timestamp &gt; b.status.timestamp)] return for left in [count(found) - listReq.start] return for page in [if left &lt;= 0 then [] else sublist(found, listReq.start + 1, if left &lt; listReq.size then left else listReq.size)] return {jsonrpc: &quot;2.0&quot;, id: ctx.id, result: { tasks: for t in page return if ctx.includeArtifacts then t else context(get entries(t)[item.key != &quot;artifacts&quot;]), nextPageToken: if listReq.start + listReq.size &lt; count(found) then string(listReq.start + listReq.size) else &quot;&quot;, pageSize: listReq.size, totalSize: count(found)}})[1][1][1][1])[1]" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ListCollected_BuildTaskList</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildTaskList_TaskListReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="TaskListReady" name="Task list ready">
      <bpmn:incoming>Flow_BuildTaskList_TaskListReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="PrepareNewTask" name="Prepare new task">
      <bpmn:extensionElements>
        <zeebe:script expression="= (for cid in [if ctx.contextId != null then ctx.contextId else uuid()] return for s in [replace(cid, &quot;[^A-Za-z0-9_:.-]&quot;, &quot;_&quot;)] return for tid in [uuid()] return {taskId: tid, contextId: cid, ctxTag: &quot;ctx-&quot; + (if string length(s) &gt; 90 then substring(s, 1, 90) else s), task: {id: tid, contextId: cid, rev: 1, status: {state: &quot;TASK_STATE_WORKING&quot;, timestamp: substring(string(now()), 1, 19) + &quot;Z&quot;}, artifacts: [], history: [put(put(ctx.m, &quot;taskId&quot;, tid), &quot;contextId&quot;, cid)]}, push: if ctx.pushEnabled and ctx.taskPush != null then put(put(ctx.taskPush, &quot;taskId&quot;, tid), &quot;id&quot;, if ctx.taskPush.id instance of string then ctx.taskPush.id else uuid()) else null})[1][1][1]" resultVariable="lookup" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_PrepareNewTask</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareNewTask_CreateTask</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="CreateTask" name="Start agent process" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=camunda.secrets.ENGINE_URL + &quot;/v2/process-instances&quot;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={processDefinitionId: camunda.secrets.A2A_AGENT_PROCESS, variables: {task: lookup.task, req: {message: ctx.m, blocking: ctx.blocking, hl: ctx.hl}}, tags: [&quot;a2a&quot;, &quot;task-&quot; + lookup.taskId, lookup.ctxTag]}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
          <zeebe:input source="=camunda.secrets.ENGINE_USERNAME" target="authentication.username" />
          <zeebe:input source="=camunda.secrets.ENGINE_PASSWORD" target="authentication.password" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={created: response.body.processInstanceKey}" />
          <zeebe:header key="errorExpression" value="=if string(error.code) = &quot;404&quot; then bpmnError(&quot;NOT_FOUND&quot;, &quot;not found&quot;) else if string(error.code) = &quot;409&quot; then bpmnError(&quot;CONFLICT&quot;, &quot;already exists&quot;) else null" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrepareNewTask_CreateTask</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateTask_AwaitNewTask</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="AwaitNewTask" name="Await task">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-await" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="={path: &quot;/v2/variables/search?truncateValues=false&quot;, body: {filter: {name: &quot;task&quot;, processInstanceKey: created, scopeKey: created}, page: {limit: 1}}}" target="probe" />
          <zeebe:input source="={kind: &quot;task&quot;, minRev: 1, settled: ctx.blocking}" target="until" />
          <zeebe:input source="=string(now() + duration(&quot;PT&quot; + string(if ctx.blocking then 20 else 5) + &quot;S&quot;))" target="deadline" />
          <zeebe:output source="=check.seen" target="seen" />
          <zeebe:output source="=check.visible" target="visible" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreateTask_AwaitNewTask</bpmn:incoming>
      <bpmn:outgoing>Flow_AwaitNewTask_BuildNewTaskResponse</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:scriptTask id="BuildNewTaskResponse" name="Build task response">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for task in [if seen != null then seen else lookup.task] return {jsonrpc: &quot;2.0&quot;, id: ctx.id, result: if task.responseMode = &quot;message&quot; and task.status.state = &quot;TASK_STATE_COMPLETED&quot; and task.status.message != null and count(task.artifacts) = 0 then {message: task.status.message} else (for v in [(for h in [if ctx.hl = null or ctx.hl &gt;= count(task.history) then task.history else if ctx.hl &lt;= 0 then [] else sublist(task.history, count(task.history) - ctx.hl + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &gt; 0 then task.artifacts else null, history: if count(h) &gt; 0 then h else null})[item.value != null]))[1]] return if &quot;task&quot; = &quot;task&quot; then {task: v} else v)[1]})[1]" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AwaitNewTask_BuildNewTaskResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildNewTaskResponse_NewTaskReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="NewTaskReady" name="Task response ready">
      <bpmn:incoming>Flow_BuildNewTaskResponse_NewTaskReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="PrepareLookup" name="Prepare lookup">
      <bpmn:extensionElements>
        <zeebe:script expression="={taskId: if ctx.method = &quot;SendMessage&quot; then ctx.taskId else ctx.ref, indexDeadline: string(now() + duration(&quot;PT3S&quot;))}" resultVariable="lookup" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_PrepareLookup</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareLookup_LookupJoin</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="FindTask" name="Find task" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=camunda.secrets.ENGINE_URL + &quot;/v2/process-instances/search&quot;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={filter: {processDefinitionId: camunda.secrets.A2A_AGENT_PROCESS, tags: [&quot;task-&quot; + lookup.taskId]}, page: {limit: 1}}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
          <zeebe:input source="=camunda.secrets.ENGINE_USERNAME" target="authentication.username" />
          <zeebe:input source="=camunda.secrets.ENGINE_PASSWORD" target="authentication.password" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={found: if count(response.body.items) &gt; 0 then response.body.items[1].processInstanceKey else null}" />
          <zeebe:header key="errorExpression" value="=if string(error.code) = &quot;404&quot; then bpmnError(&quot;NOT_FOUND&quot;, &quot;not found&quot;) else if string(error.code) = &quot;409&quot; then bpmnError(&quot;CONFLICT&quot;, &quot;already exists&quot;) else null" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LookupJoin_FindTask</bpmn:incoming>
      <bpmn:outgoing>Flow_FindTask_TaskKnown</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TaskKnown" name="Task known?" default="Flow_TaskKnown_LookupTimeLeft">
      <bpmn:incoming>Flow_FindTask_TaskKnown</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskKnown_ReadTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_TaskKnown_LookupTimeLeft</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="ReadTask" name="Read task">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-await" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="={path: &quot;/v2/variables/search?truncateValues=false&quot;, body: {filter: {name: &quot;task&quot;, processInstanceKey: found, scopeKey: found}, page: {limit: 1}}}" target="probe" />
          <zeebe:input source="={kind: &quot;task&quot;, minRev: 0}" target="until" />
          <zeebe:input source="=lookup.indexDeadline" target="deadline" />
          <zeebe:output source="=check.seen" target="task" />
          <zeebe:output source="=check.visible" target="visible" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TaskKnown_ReadTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadTask_RouteMethod</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="RouteMethod" name="Method" default="Flow_RouteMethod_NotFoundJoin">
      <bpmn:incoming>Flow_ReadTask_RouteMethod</bpmn:incoming>
      <bpmn:outgoing>Flow_RouteMethod_NotFoundJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteMethod_BuildTaskView</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteMethod_Cancelable</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteMethod_CheckFollowUp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="NotFoundJoin">
      <bpmn:incoming>Flow_RouteMethod_NotFoundJoin</bpmn:incoming>
      <bpmn:incoming>Flow_LookupTimeLeft_NotFoundJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_NotFoundJoin_BuildNotFound</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="BuildNotFound" name="Build task not found error">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for e in [{code: -32001, message: &quot;Task not found&quot;, reason: &quot;TASK_NOT_FOUND&quot;}] return {jsonrpc: &quot;2.0&quot;, id: ctx.id, error: if e.reason = null then {code: e.code, message: e.message} else {code: e.code, message: e.message, data: [{&quot;@type&quot;: &quot;type.googleapis.com/google.rpc.ErrorInfo&quot;, reason: e.reason, domain: &quot;a2a-protocol.org&quot;}]}})[1]" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotFoundJoin_BuildNotFound</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildNotFound_NotFoundReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="NotFoundReady" name="Not found response ready">
      <bpmn:incoming>Flow_BuildNotFound_NotFoundReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="BuildTaskView" name="Build task view">
      <bpmn:extensionElements>
        <zeebe:script expression="={jsonrpc: &quot;2.0&quot;, id: ctx.id, result: (for h in [if ctx.hl = null or ctx.hl &gt;= count(task.history) then task.history else if ctx.hl &lt;= 0 then [] else sublist(task.history, count(task.history) - ctx.hl + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &gt; 0 then task.artifacts else null, history: if count(h) &gt; 0 then h else null})[item.value != null]))[1]}" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteMethod_BuildTaskView</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildTaskView_TaskViewReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="TaskViewReady" name="Task response ready">
      <bpmn:incoming>Flow_BuildTaskView_TaskViewReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Cancelable" name="Cancelable?" default="Flow_Cancelable_NotCancelableJoin">
      <bpmn:incoming>Flow_RouteMethod_Cancelable</bpmn:incoming>
      <bpmn:outgoing>Flow_Cancelable_NotCancelableJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cancelable_RequestCancellation</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="AwaitCanceled" name="Await canceled task">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-await" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="={path: &quot;/v2/variables/search?truncateValues=false&quot;, body: {filter: {name: &quot;task&quot;, processInstanceKey: found, scopeKey: found}, page: {limit: 1}}}" target="probe" />
          <zeebe:input source="={kind: &quot;task&quot;, minRev: task.rev + 1, settled: true}" target="until" />
          <zeebe:input source="=string(now() + duration(&quot;PT&quot; + string(5) + &quot;S&quot;))" target="deadline" />
          <zeebe:output source="=check.seen" target="seen" />
          <zeebe:output source="=check.visible" target="visible" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RequestCancellation_AwaitCanceled</bpmn:incoming>
      <bpmn:outgoing>Flow_AwaitCanceled_CancellationOutcome</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:scriptTask id="BuildCanceledView" name="Build canceled task view">
      <bpmn:extensionElements>
        <zeebe:script expression="={jsonrpc: &quot;2.0&quot;, id: ctx.id, result: (for h in [if null = null or null &gt;= count(seen.history) then seen.history else if null &lt;= 0 then [] else sublist(seen.history, count(seen.history) - null + 1)] return context(get entries({id: seen.id, contextId: seen.contextId, status: seen.status, artifacts: if count(seen.artifacts) &gt; 0 then seen.artifacts else null, history: if count(h) &gt; 0 then h else null})[item.value != null]))[1]}" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CancellationOutcome_BuildCanceledView</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildCanceledView_CanceledReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="CanceledReady" name="Cancel response ready">
      <bpmn:incoming>Flow_BuildCanceledView_CanceledReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="NotCancelableJoin">
      <bpmn:incoming>Flow_Cancelable_NotCancelableJoin</bpmn:incoming>
      <bpmn:incoming>Flow_CancellationOutcome_NotCancelableJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_NotCancelableJoin_BuildNotCancelable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="BuildNotCancelable" name="Build not cancelable error">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for e in [{code: -32002, message: &quot;Task is terminal or its process did not accept the required a2a-cancel message&quot;, reason: &quot;TASK_NOT_CANCELABLE&quot;}] return {jsonrpc: &quot;2.0&quot;, id: ctx.id, error: if e.reason = null then {code: e.code, message: e.message} else {code: e.code, message: e.message, data: [{&quot;@type&quot;: &quot;type.googleapis.com/google.rpc.ErrorInfo&quot;, reason: e.reason, domain: &quot;a2a-protocol.org&quot;}]}})[1]" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotCancelableJoin_BuildNotCancelable</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildNotCancelable_NotCancelableReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="NotCancelableReady" name="Not cancelable response ready">
      <bpmn:incoming>Flow_BuildNotCancelable_NotCancelableReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="CheckFollowUp" name="Check follow-up">
      <bpmn:extensionElements>
        <zeebe:script expression="=if ctx.contextId != null and ctx.contextId != task.contextId then {code: -32602, message: &quot;contextId does not match the task&quot;} else if list contains([&quot;TASK_STATE_COMPLETED&quot;, &quot;TASK_STATE_CANCELED&quot;, &quot;TASK_STATE_FAILED&quot;, &quot;TASK_STATE_REJECTED&quot;], task.status.state) then {code: -32004, message: &quot;Task is in a terminal state and cannot accept messages&quot;, reason: &quot;UNSUPPORTED_OPERATION&quot;} else null" resultVariable="followError" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteMethod_CheckFollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckFollowUp_FollowUpAccepted</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="FollowUpAccepted" name="Accepted?" default="Flow_FollowUpAccepted_FollowUpErrorJoin">
      <bpmn:incoming>Flow_CheckFollowUp_FollowUpAccepted</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUpAccepted_CorrelateFollowUp</bpmn:outgoing>
      <bpmn:outgoing>Flow_FollowUpAccepted_FollowUpErrorJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CorrelateFollowUp" name="Hand follow-up to the task">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-correlate" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;a2a-send&quot;" target="messageName" />
          <zeebe:input source="=task.id" target="taskId" />
          <zeebe:input source="=3" target="tries" />
          <zeebe:input source="={followUp: {message: ctx.m, blocking: ctx.blocking, hl: ctx.hl}}" target="payload" />
          <zeebe:output source="=correlated" target="correlated" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FollowUpAccepted_CorrelateFollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_CorrelateFollowUp_TaskWaiting</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="TaskWaiting" name="Task was waiting?" default="Flow_TaskWaiting_FollowUpErrorJoin">
      <bpmn:incoming>Flow_CorrelateFollowUp_TaskWaiting</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskWaiting_AwaitFollowUp</bpmn:outgoing>
      <bpmn:outgoing>Flow_TaskWaiting_FollowUpErrorJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="AwaitFollowUp" name="Await task">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-await" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="={path: &quot;/v2/variables/search?truncateValues=false&quot;, body: {filter: {name: &quot;task&quot;, processInstanceKey: found, scopeKey: found}, page: {limit: 1}}}" target="probe" />
          <zeebe:input source="={kind: &quot;task&quot;, minRev: 0, messageId: ctx.messageId, settled: ctx.blocking}" target="until" />
          <zeebe:input source="=string(now() + duration(&quot;PT&quot; + string(if ctx.blocking then 20 else 5) + &quot;S&quot;))" target="deadline" />
          <zeebe:output source="=check.seen" target="seen" />
          <zeebe:output source="=check.visible" target="visible" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TaskWaiting_AwaitFollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_AwaitFollowUp_BuildFollowUpResponse</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:scriptTask id="BuildFollowUpResponse" name="Build task response">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for task in [if seen != null then seen else task] return {jsonrpc: &quot;2.0&quot;, id: ctx.id, result: if task.responseMode = &quot;message&quot; and task.status.state = &quot;TASK_STATE_COMPLETED&quot; and task.status.message != null and count(task.artifacts) = 0 then {message: task.status.message} else (for v in [(for h in [if ctx.hl = null or ctx.hl &gt;= count(task.history) then task.history else if ctx.hl &lt;= 0 then [] else sublist(task.history, count(task.history) - ctx.hl + 1)] return context(get entries({id: task.id, contextId: task.contextId, status: task.status, artifacts: if count(task.artifacts) &gt; 0 then task.artifacts else null, history: if count(h) &gt; 0 then h else null})[item.value != null]))[1]] return if &quot;task&quot; = &quot;task&quot; then {task: v} else v)[1]})[1]" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AwaitFollowUp_BuildFollowUpResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildFollowUpResponse_FollowUpReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="FollowUpReady" name="Task response ready">
      <bpmn:incoming>Flow_BuildFollowUpResponse_FollowUpReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="BuildFollowUpError" name="Build follow-up error">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for e in [if followError != null then followError else {code: -32004, message: &quot;Task is not waiting for input&quot;, reason: &quot;UNSUPPORTED_OPERATION&quot;}] return {jsonrpc: &quot;2.0&quot;, id: ctx.id, error: if e.reason = null then {code: e.code, message: e.message} else {code: e.code, message: e.message, data: [{&quot;@type&quot;: &quot;type.googleapis.com/google.rpc.ErrorInfo&quot;, reason: e.reason, domain: &quot;a2a-protocol.org&quot;}]}})[1]" resultVariable="rpcResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FollowUpErrorJoin_BuildFollowUpError</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildFollowUpError_FollowUpErrorReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="FollowUpErrorJoin">
      <bpmn:incoming>Flow_FollowUpAccepted_FollowUpErrorJoin</bpmn:incoming>
      <bpmn:incoming>Flow_TaskWaiting_FollowUpErrorJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUpErrorJoin_BuildFollowUpError</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="FollowUpErrorReady" name="Error response ready">
      <bpmn:incoming>Flow_BuildFollowUpError_FollowUpErrorReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RpcReceived_IsPushMethod" sourceRef="RpcReceived" targetRef="IsPushMethod" />
    <bpmn:sequenceFlow id="Flow_IsPushMethod_ReadPushSetting" name="push" sourceRef="IsPushMethod" targetRef="ReadPushSetting">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rpc instance of context and rpc.method instance of string and (list contains(["CreateTaskPushNotificationConfig", "GetTaskPushNotificationConfig", "ListTaskPushNotificationConfigs", "DeleteTaskPushNotificationConfig"], rpc.method) or (rpc.method = "SendMessage" and rpc.params.configuration.taskPushNotificationConfig != null))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IsPushMethod_PushSettingKnown" name="other" sourceRef="IsPushMethod" targetRef="PushSettingKnown" />
    <bpmn:sequenceFlow id="Flow_ReadPushSetting_PushSettingKnown" sourceRef="ReadPushSetting" targetRef="PushSettingKnown" />
    <bpmn:sequenceFlow id="Flow_PushSettingKnown_ParseRequest" sourceRef="PushSettingKnown" targetRef="ParseRequest" />
    <bpmn:sequenceFlow id="Flow_ParseRequest_ValidateRequest" sourceRef="ParseRequest" targetRef="ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_ValidateRequest_RouteRequest" sourceRef="ValidateRequest" targetRef="RouteRequest" />
    <bpmn:sequenceFlow id="Flow_RouteRequest_BuildValidationError" name="invalid" sourceRef="RouteRequest" targetRef="BuildValidationError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdict.route = "error"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteRequest_PrepareList" name="list" sourceRef="RouteRequest" targetRef="PrepareList">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdict.route = "ListTasks"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteRequest_PrepareNewTask" name="new task" sourceRef="RouteRequest" targetRef="PrepareNewTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdict.route = "SendMessage" and ctx.taskId = null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteRequest_PrepareLookup" name="task method" sourceRef="RouteRequest" targetRef="PrepareLookup" />
    <bpmn:sequenceFlow id="Flow_BuildValidationError_ValidationErrorReady" sourceRef="BuildValidationError" targetRef="ValidationErrorReady" />
    <bpmn:sequenceFlow id="Flow_BuildTaskList_TaskListReady" sourceRef="BuildTaskList" targetRef="TaskListReady" />
    <bpmn:sequenceFlow id="Flow_CreateTask_AwaitNewTask" sourceRef="CreateTask" targetRef="AwaitNewTask" />
    <bpmn:sequenceFlow id="Flow_AwaitNewTask_BuildNewTaskResponse" sourceRef="AwaitNewTask" targetRef="BuildNewTaskResponse" />
    <bpmn:sequenceFlow id="Flow_BuildNewTaskResponse_NewTaskReady" sourceRef="BuildNewTaskResponse" targetRef="NewTaskReady" />
    <bpmn:sequenceFlow id="Flow_FindTask_TaskKnown" sourceRef="FindTask" targetRef="TaskKnown" />
    <bpmn:sequenceFlow id="Flow_TaskKnown_ReadTask" name="yes" sourceRef="TaskKnown" targetRef="ReadTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=found != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReadTask_RouteMethod" sourceRef="ReadTask" targetRef="RouteMethod" />
    <bpmn:sequenceFlow id="Flow_RouteMethod_NotFoundJoin" name="task not visible" sourceRef="RouteMethod" targetRef="NotFoundJoin" />
    <bpmn:sequenceFlow id="Flow_RouteMethod_BuildTaskView" name="GetTask" sourceRef="RouteMethod" targetRef="BuildTaskView">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task != null and ctx.method = "GetTask"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteMethod_Cancelable" name="CancelTask" sourceRef="RouteMethod" targetRef="Cancelable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task != null and ctx.method = "CancelTask"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteMethod_CheckFollowUp" name="SendMessage" sourceRef="RouteMethod" targetRef="CheckFollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task != null and ctx.method = "SendMessage"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotFoundJoin_BuildNotFound" sourceRef="NotFoundJoin" targetRef="BuildNotFound" />
    <bpmn:sequenceFlow id="Flow_BuildNotFound_NotFoundReady" sourceRef="BuildNotFound" targetRef="NotFoundReady" />
    <bpmn:sequenceFlow id="Flow_BuildTaskView_TaskViewReady" sourceRef="BuildTaskView" targetRef="TaskViewReady" />
    <bpmn:sequenceFlow id="Flow_Cancelable_NotCancelableJoin" name="no" sourceRef="Cancelable" targetRef="NotCancelableJoin" />
    <bpmn:sequenceFlow id="Flow_BuildCanceledView_CanceledReady" sourceRef="BuildCanceledView" targetRef="CanceledReady" />
    <bpmn:sequenceFlow id="Flow_NotCancelableJoin_BuildNotCancelable" sourceRef="NotCancelableJoin" targetRef="BuildNotCancelable" />
    <bpmn:sequenceFlow id="Flow_BuildNotCancelable_NotCancelableReady" sourceRef="BuildNotCancelable" targetRef="NotCancelableReady" />
    <bpmn:sequenceFlow id="Flow_CheckFollowUp_FollowUpAccepted" sourceRef="CheckFollowUp" targetRef="FollowUpAccepted" />
    <bpmn:sequenceFlow id="Flow_FollowUpAccepted_CorrelateFollowUp" name="yes" sourceRef="FollowUpAccepted" targetRef="CorrelateFollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=followError = null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FollowUpAccepted_FollowUpErrorJoin" name="no" sourceRef="FollowUpAccepted" targetRef="FollowUpErrorJoin" />
    <bpmn:sequenceFlow id="Flow_CorrelateFollowUp_TaskWaiting" sourceRef="CorrelateFollowUp" targetRef="TaskWaiting" />
    <bpmn:sequenceFlow id="Flow_TaskWaiting_AwaitFollowUp" name="yes" sourceRef="TaskWaiting" targetRef="AwaitFollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=correlated = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TaskWaiting_FollowUpErrorJoin" name="no" sourceRef="TaskWaiting" targetRef="FollowUpErrorJoin" />
    <bpmn:sequenceFlow id="Flow_AwaitFollowUp_BuildFollowUpResponse" sourceRef="AwaitFollowUp" targetRef="BuildFollowUpResponse" />
    <bpmn:sequenceFlow id="Flow_BuildFollowUpResponse_FollowUpReady" sourceRef="BuildFollowUpResponse" targetRef="FollowUpReady" />
    <bpmn:sequenceFlow id="Flow_FollowUpErrorJoin_BuildFollowUpError" sourceRef="FollowUpErrorJoin" targetRef="BuildFollowUpError" />
    <bpmn:sequenceFlow id="Flow_BuildFollowUpError_FollowUpErrorReady" sourceRef="BuildFollowUpError" targetRef="FollowUpErrorReady" />
    <bpmn:sequenceFlow id="Flow_PrepareNewTask_CreateTask" sourceRef="PrepareNewTask" targetRef="CreateTask" />
    <bpmn:exclusiveGateway id="LookupTimeLeft" name="Lookup time left?" default="Flow_LookupTimeLeft_NotFoundJoin">
      <bpmn:incoming>Flow_TaskKnown_LookupTimeLeft</bpmn:incoming>
      <bpmn:outgoing>Flow_LookupTimeLeft_WaitForIndex</bpmn:outgoing>
      <bpmn:outgoing>Flow_LookupTimeLeft_NotFoundJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="LookupJoin">
      <bpmn:incoming>Flow_PrepareLookup_LookupJoin</bpmn:incoming>
      <bpmn:incoming>Flow_WaitForIndex_LookupJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_LookupJoin_FindTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="WaitForIndex" name="Await task index">
      <bpmn:incoming>Flow_LookupTimeLeft_WaitForIndex</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForIndex_LookupJoin</bpmn:outgoing>
      <bpmn:timerEventDefinition id="WaitForIndex_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT0.25S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_PrepareLookup_LookupJoin" sourceRef="PrepareLookup" targetRef="LookupJoin" />
    <bpmn:sequenceFlow id="Flow_LookupJoin_FindTask" sourceRef="LookupJoin" targetRef="FindTask" />
    <bpmn:sequenceFlow id="Flow_TaskKnown_LookupTimeLeft" sourceRef="TaskKnown" targetRef="LookupTimeLeft" name="not indexed" />
    <bpmn:sequenceFlow id="Flow_LookupTimeLeft_WaitForIndex" sourceRef="LookupTimeLeft" targetRef="WaitForIndex" name="retry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=now() &lt; date and time(lookup.indexDeadline)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_LookupTimeLeft_NotFoundJoin" sourceRef="LookupTimeLeft" targetRef="NotFoundJoin" name="expired" />
    <bpmn:sequenceFlow id="Flow_WaitForIndex_LookupJoin" sourceRef="WaitForIndex" targetRef="LookupJoin" />
    <bpmn:callActivity id="RequestCancellation" name="Request atomic cancellation">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-correlate" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input target="messageName" source="=&quot;a2a-cancel&quot;" />
          <zeebe:input target="taskId" source="=task.id" />
          <zeebe:input target="tries" source="=3" />
          <zeebe:input target="payload" source="={}" />
          <zeebe:output source="=correlated" target="correlated" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Cancelable_RequestCancellation</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestCancellation_AwaitCanceled</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="CancellationOutcome" name="Terminal outcome visible?" default="Flow_CancellationOutcome_CancellationTimeout">
      <bpmn:incoming>Flow_AwaitCanceled_CancellationOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_CancellationOutcome_BuildCanceledView</bpmn:outgoing>
      <bpmn:outgoing>Flow_CancellationOutcome_NotCancelableJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_CancellationOutcome_CancellationTimeout</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="CancellationTimeout" name="Report cancellation visibility failure">
      <bpmn:extensionElements>
        <zeebe:script resultVariable="rpcResponse" expression="=(for e in [{code: -32603, message: &quot;Cancellation outcome was not visible before the deadline&quot;, reason: &quot;DEADLINE_EXCEEDED&quot;}] return {jsonrpc: &quot;2.0&quot;, id: ctx.id, error: if e.reason = null then {code: e.code, message: e.message} else {code: e.code, message: e.message, data: [{&quot;@type&quot;: &quot;type.googleapis.com/google.rpc.ErrorInfo&quot;, reason: e.reason, domain: &quot;a2a-protocol.org&quot;}]}})[1]" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CancellationOutcome_CancellationTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_CancellationTimeout_CancellationErrorReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="CancellationErrorReady" name="Cancellation failed">
      <bpmn:incoming>Flow_CancellationTimeout_CancellationErrorReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Cancelable_RequestCancellation" sourceRef="Cancelable" targetRef="RequestCancellation" name="active">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(list contains(["TASK_STATE_COMPLETED", "TASK_STATE_CANCELED", "TASK_STATE_FAILED", "TASK_STATE_REJECTED"], task.status.state))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RequestCancellation_AwaitCanceled" sourceRef="RequestCancellation" targetRef="AwaitCanceled" />
    <bpmn:sequenceFlow id="Flow_AwaitCanceled_CancellationOutcome" sourceRef="AwaitCanceled" targetRef="CancellationOutcome" />
    <bpmn:sequenceFlow id="Flow_CancellationOutcome_BuildCanceledView" sourceRef="CancellationOutcome" targetRef="BuildCanceledView" name="canceled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=visible and seen.status.state = "TASK_STATE_CANCELED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CancellationOutcome_NotCancelableJoin" sourceRef="CancellationOutcome" targetRef="NotCancelableJoin" name="not canceled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=seen != null and seen.status.state != "TASK_STATE_CANCELED" and ((visible and list contains(["TASK_STATE_COMPLETED", "TASK_STATE_CANCELED", "TASK_STATE_FAILED", "TASK_STATE_REJECTED"], seen.status.state)) or not(correlated))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CancellationOutcome_CancellationTimeout" sourceRef="CancellationOutcome" targetRef="CancellationTimeout" name="not visible" />
    <bpmn:sequenceFlow id="Flow_CancellationTimeout_CancellationErrorReady" sourceRef="CancellationTimeout" targetRef="CancellationErrorReady" />
    <bpmn:callActivity id="CollectTaskList" name="Collect all task pages">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-list-collect" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=listReq" target="listReq" />
          <zeebe:output source="=listing.items" target="taskItems" />
          <zeebe:output source="=listing.failure" target="listFailure" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrepareList_CollectTaskList</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectTaskList_ListCollected</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="ListCollected" name="Complete task collection?" default="Flow_ListCollected_BuildListFailure">
      <bpmn:incoming>Flow_CollectTaskList_ListCollected</bpmn:incoming>
      <bpmn:outgoing>Flow_ListCollected_BuildTaskList</bpmn:outgoing>
      <bpmn:outgoing>Flow_ListCollected_BuildListFailure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="BuildListFailure" name="Report incomplete task list">
      <bpmn:extensionElements>
        <zeebe:script resultVariable="rpcResponse" expression="=(for e in [listFailure] return {jsonrpc: &quot;2.0&quot;, id: ctx.id, error: if e.reason = null then {code: e.code, message: e.message} else {code: e.code, message: e.message, data: [{&quot;@type&quot;: &quot;type.googleapis.com/google.rpc.ErrorInfo&quot;, reason: e.reason, domain: &quot;a2a-protocol.org&quot;}]}})[1]" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ListCollected_BuildListFailure</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildListFailure_ListFailureReady</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="ListFailureReady" name="Listing failed">
      <bpmn:incoming>Flow_BuildListFailure_ListFailureReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PrepareList_CollectTaskList" sourceRef="PrepareList" targetRef="CollectTaskList" />
    <bpmn:sequenceFlow id="Flow_CollectTaskList_ListCollected" sourceRef="CollectTaskList" targetRef="ListCollected" />
    <bpmn:sequenceFlow id="Flow_ListCollected_BuildTaskList" sourceRef="ListCollected" targetRef="BuildTaskList" name="complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=listFailure = null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ListCollected_BuildListFailure" sourceRef="ListCollected" targetRef="BuildListFailure" name="incomplete" />
    <bpmn:sequenceFlow id="Flow_BuildListFailure_ListFailureReady" sourceRef="BuildListFailure" targetRef="ListFailureReady" />
    <bpmn:startEvent id="CardRequested" name="Agent Card requested" zeebe:modelerTemplate="dev.hansel.a2a.core.card.v1" zeebe:modelerTemplateVersion="1">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
          <zeebe:property name="inbound.context" value="a2a-card" />
          <zeebe:property name="inbound.auth.type" value="NONE" />
          <zeebe:property name="inbound.method" value="get" />
          <zeebe:property name="inbound.responseExpression" value="={rpcUrl: get value(correlation.activatedElement.delegate.properties, &quot;inbound.publicRpcUrl&quot;), response: if rpcUrl instance of string and matches(rpcUrl, &quot;^https://[^ /]+/[^ ]*$&quot;) then {statusCode: 200, headers: {&quot;Content-Type&quot;: &quot;application/json&quot;}, body: {name: &quot;Synthetic card-dispute reviewer&quot;, version: &quot;0.1.0&quot;, description: &quot;Non-production community demonstration. Reconciles synthetic charges for human review; &quot; + &quot;performs no financial actions.&quot;, provider: {organization: &quot;HanselIdes&quot;, url: &quot;https://github.com/HanselIdes/camunda-a2a&quot;}, supportedInterfaces: [{url: rpcUrl, protocolBinding: &quot;JSONRPC&quot;, protocolVersion: &quot;1.0&quot;}], capabilities: {streaming: false, pushNotifications: false, extendedAgentCard: false}, defaultInputModes: [&quot;text/plain&quot;], defaultOutputModes: [&quot;text/plain&quot;, &quot;application/json&quot;], securitySchemes: {a2aApiKey: {apiKeySecurityScheme: {location: &quot;header&quot;, name: &quot;X-A2A-Api-Key&quot;}}}, securityRequirements: [{schemes: {a2aApiKey: {}}}], skills: [{id: &quot;review_duplicate_charge&quot;, name: &quot;Reconcile synthetic charges&quot;, description: &quot;Call for every review. Checks explicit client confirmation; without it returns confirmation instructions. Reconciles only validated client-supplied synthetic amounts; accepts no model financial parameters. Returns arithmetic evidence for human review, not a refund authorization or fraud determination.&quot;, tags: [&quot;synthetic&quot;, &quot;card-dispute&quot;, &quot;reconciliation&quot;], examples: [&quot;Synthetic example only: Northwind Electronics charged USD 49.95 twice for one order. The expected charge was USD 49.95. Reconcile the two charges with your tool.&quot;]}]}} else {statusCode: 500, body: {error: &quot;Configure the Agent Card HTTPS public RPC URL&quot;}}}.response" />
          <zeebe:property name="inbound.publicRpcUrl" value="" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_CardRequested_CardServed</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CardRequested_message" messageRef="AgentCardRequestMessage" />
    </bpmn:startEvent>
    <bpmn:endEvent id="CardServed" name="Card served">
      <bpmn:incoming>Flow_CardRequested_CardServed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CardRequested_CardServed" sourceRef="CardRequested" targetRef="CardServed" />
  </bpmn:process>
  <bpmn:process id="a2a-task-update" name="A2A task update" isExecutable="true">
    <bpmn:startEvent id="TurnFinished" name="Turn finished">
      <bpmn:outgoing>Flow_TurnFinished_ApplyOutcome</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="ApplyOutcome" name="Apply outcome">
      <bpmn:extensionElements>
        <zeebe:script expression="= (for o in [(if outcome.agent != null then (for r in [(if outcome.agent.responseText instance of string then trim(outcome.agent.responseText) else &quot;The agent produced no answer.&quot;)] return for ask in [starts with(r, &quot;NEED_INPUT:&quot;)] return for t in [if ask then trim(substring(r, 12)) else r] return for a in [(for calls in [flatten(for m in outcome.agent.context.conversation.messages[item.role = &quot;assistant&quot; and item.toolCalls != null] return for tc in m.toolCalls return {name: tc.name, arguments: tc.arguments})] return if count(calls) = 0 then null else {artifactId: uuid(), name: &quot;tool-trace&quot;, parts: [{data: {toolCalls: calls}}]})[1]] return {state: if ask then &quot;TASK_STATE_INPUT_REQUIRED&quot; else &quot;TASK_STATE_COMPLETED&quot;, text: t, replaceAnswer: true, artifacts: concatenate([{artifactId: uuid(), name: if ask then &quot;question&quot; else &quot;answer&quot;, parts: [{text: t}]}], if a = null then [] else [a])})[1][1][1][1] else outcome)] return for m in [if o.text = null then null else {messageId: uuid(), contextId: task.contextId, taskId: task.id, role: &quot;ROLE_AGENT&quot;, parts: [{text: o.text}]}] return {responseMode: if o.responseMode = &quot;message&quot; then &quot;message&quot; else &quot;task&quot;, id: task.id, contextId: task.contextId, rev: task.rev + 1, status: context(get entries({state: o.state, message: m, timestamp: substring(string(now()), 1, 19) + &quot;Z&quot;})[item.value != null]), artifacts: concatenate(if o.replaceAnswer = true then task.artifacts[not(list contains([&quot;tool-trace&quot;, &quot;answer&quot;, &quot;question&quot;], item.name))] else task.artifacts, if o.artifacts = null then [] else o.artifacts), history: if m = null then task.history else append(task.history, m)})[1][1]" resultVariable="task" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TurnFinished_ApplyOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplyOutcome_TaskUpdated</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="TaskUpdated" name="Task updated">
      <bpmn:incoming>Flow_ApplyOutcome_TaskUpdated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TurnFinished_ApplyOutcome" sourceRef="TurnFinished" targetRef="ApplyOutcome" />
    <bpmn:sequenceFlow id="Flow_ApplyOutcome_TaskUpdated" sourceRef="ApplyOutcome" targetRef="TaskUpdated" />
  </bpmn:process>
  <bpmn:process id="a2a-await" name="A2A await visible state" isExecutable="true">
    <bpmn:startEvent id="AwaitRequested" name="Wait requested">
      <bpmn:outgoing>Flow_AwaitRequested_LookAgain</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="LookAgain">
      <bpmn:incoming>Flow_AwaitRequested_LookAgain</bpmn:incoming>
      <bpmn:incoming>Flow_WaitAMoment_LookAgain</bpmn:incoming>
      <bpmn:outgoing>Flow_LookAgain_ReadState</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ReadState" name="Read engine state" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=camunda.secrets.ENGINE_URL + probe.path" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="=probe.body" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
          <zeebe:input source="=camunda.secrets.ENGINE_USERNAME" target="authentication.username" />
          <zeebe:input source="=camunda.secrets.ENGINE_PASSWORD" target="authentication.password" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={items: for i in response.body.items return context merge([i, {value: from json(i.value)}])}" />
          <zeebe:header key="errorExpression" value="=if string(error.code) = &quot;404&quot; then bpmnError(&quot;NOT_FOUND&quot;, &quot;not found&quot;) else if string(error.code) = &quot;409&quot; then bpmnError(&quot;CONFLICT&quot;, &quot;already exists&quot;) else null" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LookAgain_ReadState</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadState_CheckState</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="CheckState" name="Check state">
      <bpmn:extensionElements>
        <zeebe:script expression="= (for v in [if count(items) &gt; 0 then items[1].value else null] return {attempt: (if is defined(check) and check != null then check.attempt else 0) + 1, seen: v, visible: if until.kind = &quot;absent&quot; then v = null else if until.kind = &quot;present&quot; then v != null and (until.value = null or v = until.value) else v != null and v.rev &gt;= until.minRev and (until.settled != true or list contains([&quot;TASK_STATE_COMPLETED&quot;, &quot;TASK_STATE_CANCELED&quot;, &quot;TASK_STATE_FAILED&quot;, &quot;TASK_STATE_REJECTED&quot;, &quot;TASK_STATE_INPUT_REQUIRED&quot;, &quot;TASK_STATE_AUTH_REQUIRED&quot;], v.status.state)) and (until.messageId = null or (some h in v.history satisfies h.messageId = until.messageId))})[1]" resultVariable="check" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReadState_CheckState</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckState_IsVisible</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IsVisible" name="Visible?" default="Flow_IsVisible_TriesLeft">
      <bpmn:incoming>Flow_CheckState_IsVisible</bpmn:incoming>
      <bpmn:outgoing>Flow_IsVisible_Visible</bpmn:outgoing>
      <bpmn:outgoing>Flow_IsVisible_TriesLeft</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Visible" name="Visible">
      <bpmn:incoming>Flow_IsVisible_Visible</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="TriesLeft" name="Time left?" default="Flow_TriesLeft_GaveUp">
      <bpmn:incoming>Flow_IsVisible_TriesLeft</bpmn:incoming>
      <bpmn:outgoing>Flow_TriesLeft_WaitAMoment</bpmn:outgoing>
      <bpmn:outgoing>Flow_TriesLeft_GaveUp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="WaitAMoment" name="Wait a moment">
      <bpmn:incoming>Flow_TriesLeft_WaitAMoment</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitAMoment_LookAgain</bpmn:outgoing>
      <bpmn:timerEventDefinition id="WaitAMoment_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT0.25S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="GaveUp" name="Gave up">
      <bpmn:incoming>Flow_TriesLeft_GaveUp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_AwaitRequested_LookAgain" sourceRef="AwaitRequested" targetRef="LookAgain" />
    <bpmn:sequenceFlow id="Flow_WaitAMoment_LookAgain" sourceRef="WaitAMoment" targetRef="LookAgain" />
    <bpmn:sequenceFlow id="Flow_LookAgain_ReadState" sourceRef="LookAgain" targetRef="ReadState" />
    <bpmn:sequenceFlow id="Flow_ReadState_CheckState" sourceRef="ReadState" targetRef="CheckState" />
    <bpmn:sequenceFlow id="Flow_CheckState_IsVisible" sourceRef="CheckState" targetRef="IsVisible" />
    <bpmn:sequenceFlow id="Flow_IsVisible_Visible" name="yes" sourceRef="IsVisible" targetRef="Visible">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=check.visible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IsVisible_TriesLeft" name="no" sourceRef="IsVisible" targetRef="TriesLeft" />
    <bpmn:sequenceFlow id="Flow_TriesLeft_WaitAMoment" name="yes" sourceRef="TriesLeft" targetRef="WaitAMoment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=now() &lt; date and time(deadline)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TriesLeft_GaveUp" name="no" sourceRef="TriesLeft" targetRef="GaveUp" />
  </bpmn:process>
  <bpmn:process id="a2a-correlate" name="A2A correlate message to task" isExecutable="true">
    <bpmn:startEvent id="CorrelateRequested" name="Correlation requested">
      <bpmn:outgoing>Flow_CorrelateRequested_ResetAttempts</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="ResetAttempts" name="Reset attempts">
      <bpmn:extensionElements>
        <zeebe:script expression="=0" resultVariable="attempt" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CorrelateRequested_ResetAttempts</bpmn:incoming>
      <bpmn:outgoing>Flow_ResetAttempts_TryJoin</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="TryJoin" name="Try correlation">
      <bpmn:incoming>Flow_ResetAttempts_TryJoin</bpmn:incoming>
      <bpmn:incoming>Flow_WaitBeforeRetry_TryJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_TryJoin_CorrelateMessage</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CorrelateMessage" name="Correlate message" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=camunda.secrets.ENGINE_URL + &quot;/v2/messages/correlation&quot;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={name: messageName, correlationKey: taskId, variables: payload}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
          <zeebe:input source="=camunda.secrets.ENGINE_USERNAME" target="authentication.username" />
          <zeebe:input source="=camunda.secrets.ENGINE_PASSWORD" target="authentication.password" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={}" />
          <zeebe:header key="errorExpression" value="=if string(error.code) = &quot;404&quot; then bpmnError(&quot;NOT_FOUND&quot;, &quot;not found&quot;) else if string(error.code) = &quot;409&quot; then bpmnError(&quot;CONFLICT&quot;, &quot;already exists&quot;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TryJoin_CorrelateMessage</bpmn:incoming>
      <bpmn:outgoing>Flow_CorrelateMessage_MarkCorrelated</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="MarkCorrelated" name="Mark correlated">
      <bpmn:extensionElements>
        <zeebe:script expression="=true" resultVariable="correlated" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CorrelateMessage_MarkCorrelated</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkCorrelated_Correlated</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Correlated" name="Correlated">
      <bpmn:incoming>Flow_MarkCorrelated_Correlated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="CountAttempt" name="Count attempt">
      <bpmn:extensionElements>
        <zeebe:script expression="=attempt + 1" resultVariable="attempt" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoSubscription_CountAttempt</bpmn:incoming>
      <bpmn:outgoing>Flow_CountAttempt_AttemptsLeft</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="AttemptsLeft" name="Attempts left?" default="Flow_AttemptsLeft_MarkNotCorrelated">
      <bpmn:incoming>Flow_CountAttempt_AttemptsLeft</bpmn:incoming>
      <bpmn:outgoing>Flow_AttemptsLeft_WaitBeforeRetry</bpmn:outgoing>
      <bpmn:outgoing>Flow_AttemptsLeft_MarkNotCorrelated</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="WaitBeforeRetry" name="Wait before retry">
      <bpmn:incoming>Flow_AttemptsLeft_WaitBeforeRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitBeforeRetry_TryJoin</bpmn:outgoing>
      <bpmn:timerEventDefinition id="WaitBeforeRetry_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT0.3S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="NotCorrelated" name="Not correlated">
      <bpmn:incoming>Flow_MarkNotCorrelated_NotCorrelated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="NoSubscription" name="No subscription yet" attachedToRef="CorrelateMessage">
      <bpmn:outgoing>Flow_NoSubscription_CountAttempt</bpmn:outgoing>
      <bpmn:errorEventDefinition id="NoSubscription_def" errorRef="NotFound" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_CorrelateRequested_ResetAttempts" sourceRef="CorrelateRequested" targetRef="ResetAttempts" />
    <bpmn:sequenceFlow id="Flow_ResetAttempts_TryJoin" sourceRef="ResetAttempts" targetRef="TryJoin" />
    <bpmn:sequenceFlow id="Flow_WaitBeforeRetry_TryJoin" sourceRef="WaitBeforeRetry" targetRef="TryJoin" />
    <bpmn:sequenceFlow id="Flow_TryJoin_CorrelateMessage" sourceRef="TryJoin" targetRef="CorrelateMessage" />
    <bpmn:sequenceFlow id="Flow_CorrelateMessage_MarkCorrelated" sourceRef="CorrelateMessage" targetRef="MarkCorrelated" />
    <bpmn:sequenceFlow id="Flow_MarkCorrelated_Correlated" sourceRef="MarkCorrelated" targetRef="Correlated" />
    <bpmn:sequenceFlow id="Flow_NoSubscription_CountAttempt" sourceRef="NoSubscription" targetRef="CountAttempt" />
    <bpmn:sequenceFlow id="Flow_CountAttempt_AttemptsLeft" sourceRef="CountAttempt" targetRef="AttemptsLeft" />
    <bpmn:sequenceFlow id="Flow_AttemptsLeft_WaitBeforeRetry" name="yes" sourceRef="AttemptsLeft" targetRef="WaitBeforeRetry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=attempt &lt; tries</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AttemptsLeft_MarkNotCorrelated" name="no" sourceRef="AttemptsLeft" targetRef="MarkNotCorrelated" />
    <bpmn:sequenceFlow id="Flow_MarkNotCorrelated_NotCorrelated" sourceRef="MarkNotCorrelated" targetRef="NotCorrelated" />
    <bpmn:scriptTask id="MarkNotCorrelated" name="Mark not correlated">
      <bpmn:extensionElements>
        <zeebe:script expression="=false" resultVariable="correlated" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AttemptsLeft_MarkNotCorrelated</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkNotCorrelated_NotCorrelated</bpmn:outgoing>
    </bpmn:scriptTask>
  </bpmn:process>
  <bpmn:process id="a2a-list-collect" name="A2A collect indexed task pages" isExecutable="true">
    <bpmn:startEvent id="ListScanRequested" name="Collect tasks">
      <bpmn:outgoing>Flow_ListScanRequested_StartListScan</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="StartListScan" name="Start bounded scan">
      <bpmn:extensionElements>
        <zeebe:script expression="={items: [], keys: [], cursor: null, cursors: [], deadline: string(now() + duration(&quot;PT10S&quot;))}" resultVariable="listScan" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ListScanRequested_StartListScan</bpmn:incoming>
      <bpmn:outgoing>Flow_StartListScan_ListProcessPageJoin</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ListProcessPageJoin">
      <bpmn:incoming>Flow_StartListScan_ListProcessPageJoin</bpmn:incoming>
      <bpmn:incoming>Flow_ListScanDecision_ListProcessPageJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ListProcessPageJoin_SearchTasks</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SearchTasks" name="Search next process page" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=camunda.secrets.ENGINE_URL + &quot;/v2/process-instances/search&quot;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={filter: {processDefinitionId: camunda.secrets.A2A_AGENT_PROCESS, tags: if listReq.ctxTag != null then [&quot;a2a&quot;, listReq.ctxTag] else [&quot;a2a&quot;]}, sort: [{field: &quot;startDate&quot;, order: &quot;DESC&quot;}, {field: &quot;processInstanceKey&quot;, order: &quot;DESC&quot;}], page: {limit: 100, after: listScan.cursor}}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
          <zeebe:input source="=camunda.secrets.ENGINE_USERNAME" target="authentication.username" />
          <zeebe:input source="=camunda.secrets.ENGINE_PASSWORD" target="authentication.password" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={taskKeys: for i in response.body.items return i.processInstanceKey, listPage: {count: count(response.body.items), cursor: response.body.page.endCursor}}" />
          <zeebe:header key="errorExpression" value="=if string(error.code) = &quot;404&quot; then bpmnError(&quot;NOT_FOUND&quot;, &quot;not found&quot;) else if string(error.code) = &quot;409&quot; then bpmnError(&quot;CONFLICT&quot;, &quot;already exists&quot;) else null" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ListProcessPageJoin_SearchTasks</bpmn:incoming>
      <bpmn:outgoing>Flow_SearchTasks_AnyTasks</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="AnyTasks" name="Any tasks?" default="Flow_AnyTasks_ListBatchJoin">
      <bpmn:incoming>Flow_SearchTasks_AnyTasks</bpmn:incoming>
      <bpmn:outgoing>Flow_AnyTasks_ListVariablesJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_AnyTasks_ListBatchJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ListVariablesJoin">
      <bpmn:incoming>Flow_AnyTasks_ListVariablesJoin</bpmn:incoming>
      <bpmn:incoming>Flow_WaitListVariables_ListVariablesJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ListVariablesJoin_ReadTasks</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ReadTasks" name="Read complete root-state batch" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=camunda.secrets.ENGINE_URL + &quot;/v2/variables/search?truncateValues=false&quot;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={filter: {name: &quot;task&quot;, processInstanceKey: {&quot;$in&quot;: taskKeys}, scopeKey: {&quot;$in&quot;: taskKeys}}, page: {limit: 100}}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
          <zeebe:input source="=camunda.secrets.ENGINE_USERNAME" target="authentication.username" />
          <zeebe:input source="=camunda.secrets.ENGINE_PASSWORD" target="authentication.password" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={taskBatch: for i in response.body.items return context merge([i, {value: from json(i.value)}])}" />
          <zeebe:header key="errorExpression" value="=if string(error.code) = &quot;404&quot; then bpmnError(&quot;NOT_FOUND&quot;, &quot;not found&quot;) else if string(error.code) = &quot;409&quot; then bpmnError(&quot;CONFLICT&quot;, &quot;already exists&quot;) else null" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ListVariablesJoin_ReadTasks</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadTasks_ListBatchJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ListBatchJoin">
      <bpmn:incoming>Flow_AnyTasks_ListBatchJoin</bpmn:incoming>
      <bpmn:incoming>Flow_ReadTasks_ListBatchJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ListBatchJoin_CollectListBatch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="CollectListBatch" name="Validate and collect batch">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for ready in [if count(taskKeys) = 0 then true else taskBatch instance of list and count(distinct values(taskKeys)) = count(taskKeys) and count(taskBatch) = count(taskKeys) and count(distinct values(taskBatch.scopeKey)) = count(taskKeys) and (every i in taskBatch satisfies i.scopeKey = i.processInstanceKey and list contains(taskKeys, i.scopeKey) and i.value instance of context and i.value.id instance of string and i.value.contextId instance of string and i.value.rev instance of number and i.value.status instance of context and i.value.status.state instance of string and i.value.status.timestamp instance of string and i.value.history instance of list and i.value.artifacts instance of list)] return for overlap in [some k in taskKeys satisfies list contains(listScan.keys, k)] return for nextOk in [listPage.cursor instance of string and listPage.cursor != &quot;&quot; and not(list contains(listScan.cursors, listPage.cursor))] return for action in [if not(ready) then (if now() &gt;= date and time(listScan.deadline) then &quot;deadline&quot; else &quot;variables&quot;) else if overlap then &quot;overlap&quot; else if listPage.count &lt; 100 then &quot;done&quot; else if listPage.count != 100 or not(nextOk) then &quot;cursor&quot; else if now() &gt;= date and time(listScan.deadline) then &quot;deadline&quot; else &quot;page&quot;] return context merge([listScan, {action: action, items: if ready and not(overlap) and count(taskKeys) &gt; 0 then concatenate(listScan.items, taskBatch) else listScan.items, keys: if ready then concatenate(listScan.keys, taskKeys) else listScan.keys, cursor: if action = &quot;page&quot; then listPage.cursor else listScan.cursor, cursors: if action = &quot;page&quot; then append(listScan.cursors, listPage.cursor) else listScan.cursors}]))[1][1][1][1]" resultVariable="listScan" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ListBatchJoin_CollectListBatch</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectListBatch_ListScanDecision</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ListScanDecision" name="Scan outcome?" default="Flow_ListScanDecision_FailListScan">
      <bpmn:incoming>Flow_CollectListBatch_ListScanDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ListScanDecision_FinishListScan</bpmn:outgoing>
      <bpmn:outgoing>Flow_ListScanDecision_ListProcessPageJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_ListScanDecision_WaitListVariables</bpmn:outgoing>
      <bpmn:outgoing>Flow_ListScanDecision_FailListScan</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="FinishListScan" name="Return complete collection">
      <bpmn:extensionElements>
        <zeebe:script expression="={items: listScan.items, failure: null}" resultVariable="listing" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ListScanDecision_FinishListScan</bpmn:incoming>
      <bpmn:outgoing>Flow_FinishListScan_ListResultJoin</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ListResultJoin">
      <bpmn:incoming>Flow_FinishListScan_ListResultJoin</bpmn:incoming>
      <bpmn:incoming>Flow_FailListScan_ListResultJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ListResultJoin_ListScanReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ListScanReady" name="Collection ready">
      <bpmn:incoming>Flow_ListResultJoin_ListScanReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="WaitListVariables" name="Await root-state index">
      <bpmn:incoming>Flow_ListScanDecision_WaitListVariables</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitListVariables_ListVariablesJoin</bpmn:outgoing>
      <bpmn:timerEventDefinition id="WaitListVariables_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT0.25S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="FailListScan" name="Reject incomplete collection">
      <bpmn:extensionElements>
        <zeebe:script expression="={items: [], failure: if listScan.action = &quot;deadline&quot; then {code: -32603, message: &quot;Task listing did not become complete before the deadline&quot;, reason: &quot;DEADLINE_EXCEEDED&quot;} else {code: -32603, message: &quot;Task search pagination did not make progress&quot;, reason: &quot;DATA_LOSS&quot;}}" resultVariable="listing" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ListScanDecision_FailListScan</bpmn:incoming>
      <bpmn:outgoing>Flow_FailListScan_ListResultJoin</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ListScanRequested_StartListScan" sourceRef="ListScanRequested" targetRef="StartListScan" />
    <bpmn:sequenceFlow id="Flow_StartListScan_ListProcessPageJoin" sourceRef="StartListScan" targetRef="ListProcessPageJoin" />
    <bpmn:sequenceFlow id="Flow_ListProcessPageJoin_SearchTasks" sourceRef="ListProcessPageJoin" targetRef="SearchTasks" />
    <bpmn:sequenceFlow id="Flow_SearchTasks_AnyTasks" sourceRef="SearchTasks" targetRef="AnyTasks" />
    <bpmn:sequenceFlow id="Flow_AnyTasks_ListVariablesJoin" sourceRef="AnyTasks" targetRef="ListVariablesJoin" name="read">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(taskKeys) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ListVariablesJoin_ReadTasks" sourceRef="ListVariablesJoin" targetRef="ReadTasks" />
    <bpmn:sequenceFlow id="Flow_AnyTasks_ListBatchJoin" sourceRef="AnyTasks" targetRef="ListBatchJoin" name="empty" />
    <bpmn:sequenceFlow id="Flow_ReadTasks_ListBatchJoin" sourceRef="ReadTasks" targetRef="ListBatchJoin" />
    <bpmn:sequenceFlow id="Flow_ListBatchJoin_CollectListBatch" sourceRef="ListBatchJoin" targetRef="CollectListBatch" />
    <bpmn:sequenceFlow id="Flow_CollectListBatch_ListScanDecision" sourceRef="CollectListBatch" targetRef="ListScanDecision" />
    <bpmn:sequenceFlow id="Flow_ListScanDecision_FinishListScan" sourceRef="ListScanDecision" targetRef="FinishListScan" name="complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=listScan.action = "done"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ListScanDecision_ListProcessPageJoin" sourceRef="ListScanDecision" targetRef="ListProcessPageJoin" name="next page">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=listScan.action = "page"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ListScanDecision_WaitListVariables" sourceRef="ListScanDecision" targetRef="WaitListVariables" name="retry state">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=listScan.action = "variables"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_WaitListVariables_ListVariablesJoin" sourceRef="WaitListVariables" targetRef="ListVariablesJoin" />
    <bpmn:sequenceFlow id="Flow_ListScanDecision_FailListScan" sourceRef="ListScanDecision" targetRef="FailListScan" name="incomplete" />
    <bpmn:sequenceFlow id="Flow_FinishListScan_ListResultJoin" sourceRef="FinishListScan" targetRef="ListResultJoin" />
    <bpmn:sequenceFlow id="Flow_FailListScan_ListResultJoin" sourceRef="FailListScan" targetRef="ListResultJoin" />
    <bpmn:sequenceFlow id="Flow_ListResultJoin_ListScanReady" sourceRef="ListResultJoin" targetRef="ListScanReady" />
  </bpmn:process>
