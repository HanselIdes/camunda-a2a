    <bpmn:sequenceFlow id="Flow_CorrelateMessage_MarkCorrelated" sourceRef="CorrelateMessage" targetRef="MarkCorrelated" />
    <bpmn:sequenceFlow id="Flow_MarkCorrelated_Correlated" sourceRef="MarkCorrelated" targetRef="Correlated" />
    <bpmn:sequenceFlow id="Flow_NoSubscription_CountAttempt" sourceRef="NoSubscription" targetRef="CountAttempt" />
    <bpmn:sequenceFlow id="Flow_CountAttempt_AttemptsLeft" sourceRef="CountAttempt" targetRef="AttemptsLeft" />
    <bpmn:sequenceFlow id="Flow_AttemptsLeft_WaitBeforeRetry" name="yes" sourceRef="AttemptsLeft" targetRef="WaitBeforeRetry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=attempt &lt; tries</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AttemptsLeft_MarkNotCorrelated" name="no" sourceRef="AttemptsLeft" targetRef="MarkNotCorrelated" />
    <bpmn:sequenceFlow id="Flow_MarkNotCorrelated_NotCorrelated" sourceRef="MarkNotCorrelated" targetRef="NotCorrelated" />
    <bpmn:scriptTask id="MarkNotCorrelated" name="Mark not correlated">
