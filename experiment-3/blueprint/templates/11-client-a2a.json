{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "A2A 1.0 Client",
  "id": "dev.hansel.a2a.client.v1",
  "version": 3,
  "icon": {
    "contents": "data:image/svg+xml;base64,"
  },
  "description": "Discover an A2A 1.0 agent, send a message or read a task over authenticated JSON-RPC. Targets engine and stock Connectors 8.9+; runtime verification pending for 8.9. Polling is modeled explicitly. No push or streaming. AI Agent Sub-process v2 requires 8.10+.",
  "documentationRef": "https://a2a-protocol.org/latest/specification/",
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:Task"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "engines": {
    "camunda": "^8.9"
  },
  "groups": [
    {
      "id": "operation",
      "label": "A2A interaction"
    },
    {
      "id": "output",
      "label": "Response and errors"
    }
  ],
  "properties": [
    {
      "type": "Hidden",
      "value": "io.camunda:http-json:1",
      "binding": {
        "type": "zeebe:taskDefinition",
        "property": "type"
      }
    },
    {
      "id": "operationId",
      "label": "Operation",
      "type": "Dropdown",
      "value": "sendMessage",
      "group": "operation",
      "binding": {
        "type": "zeebe:input",
        "name": "operationId"
      },
      "constraints": {
        "notEmpty": true
      },
      "choices": [
        {
          "name": "Fetch Agent Card",
          "value": "fetchAgentCard"
        },
        {
          "name": "Send message",
          "value": "sendMessage"
        },
        {
          "name": "Get task",
          "value": "getTask"
        }
      ]
    },
    {
      "id": "url",
      "label": "Agent Card or JSON-RPC URL",
      "type": "String",
      "value": "",
      "group": "operation",
      "binding": {
        "type": "zeebe:input",
        "name": "url"
      },
      "feel": "optional",
      "constraints": {
        "notEmpty": true,
        "pattern": {
          "value": "^https://[^ /]+/[^ ]*$",
          "message": "Enter the complete HTTPS Agent Card or JSON-RPC URL"
        }
      },
      "description": "Complete HTTPS Agent Card URL for discovery, or the JSONRPC interface URL for task operations. Direct connector URLs are supported; no path rewriting is required."
    },
    {
      "id": "apiKey",
      "label": "Shared API key",
      "type": "String",
      "value": "{{secrets.A2A_API_KEY}}",
      "group": "operation",
      "binding": {
        "type": "zeebe:input",
        "name": "apiKey"
      },
      "feel": "optional",
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operationId",
        "oneOf": [
          "sendMessage",
          "getTask"
        ]
      },
      "description": "8.9: {{secrets.A2A_API_KEY}} from the Connector secret store. 8.10+: =camunda.secrets.A2A_API_KEY from the cluster secret store. Sent as X-Api-Key. Never enter a credential value in the diagram."
    },
    {
      "id": "message",
      "label": "A2A message",
      "type": "Text",
      "value": "",
      "group": "operation",
      "binding": {
        "type": "zeebe:input",
        "name": "message"
      },
      "feel": "required",
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operationId",
        "oneOf": [
          "sendMessage"
        ]
      },
      "description": "Message context with messageId, role and parts. For a follow-up, include taskId and contextId from the server response, never invented identifiers."
    },
    {
      "id": "taskId",
      "label": "Task ID",
      "type": "String",
      "value": "",
      "group": "operation",
      "binding": {
        "type": "zeebe:input",
        "name": "taskId"
      },
      "feel": "optional",
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operationId",
        "oneOf": [
          "getTask"
        ]
      },
      "description": "Use the task ID returned by SendMessage or GetTask."
    },
    {
      "id": "authentication.type",
      "label": "",
      "type": "Hidden",
      "value": "noAuth",
      "group": "operation",
      "binding": {
        "type": "zeebe:input",
        "name": "authentication.type"
      }
    },
    {
      "id": "method",
      "label": "",
      "type": "Hidden",
      "value": "=if operationId = \"fetchAgentCard\" then \"GET\" else \"POST\"",
      "group": "operation",
      "binding": {
        "type": "zeebe:input",
        "name": "method"
      }
    },
    {
      "id": "headers",
      "label": "",
      "type": "Hidden",
      "value": "=if operationId = \"fetchAgentCard\" then {\"A2A-Version\": \"1.0\"} else {\"A2A-Version\": \"1.0\", \"Content-Type\": \"application/json\", \"X-Api-Key\": apiKey}",
      "group": "operation",
      "binding": {
        "type": "zeebe:input",
        "name": "headers"
      }
    },
    {
      "id": "body",
      "label": "",
      "type": "Hidden",
      "value": "=if operationId = \"sendMessage\" then {jsonrpc: \"2.0\", id: uuid(), method: \"SendMessage\", params: {message: message, configuration: {returnImmediately: true}}} else {jsonrpc: \"2.0\", id: uuid(), method: \"GetTask\", params: {id: taskId}}",
      "group": "operation",
      "binding": {
        "type": "zeebe:input",
        "name": "body"
      },
      "condition": {
        "property": "operationId",
        "oneOf": [
          "sendMessage",
          "getTask"
        ]
      }
    },
    {
      "id": "readTimeoutInSeconds",
      "label": "Read timeout (seconds)",
      "type": "String",
      "value": "60",
      "group": "operation",
      "binding": {
        "type": "zeebe:input",
        "name": "readTimeoutInSeconds"
      },
      "feel": "optional",
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "resultVariable",
      "label": "Result variable",
      "type": "String",
      "group": "output",
      "optional": true,
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "resultVariable"
      }
    },
    {
      "id": "resultExpression",
      "label": "Result expression",
      "type": "Text",
      "feel": "required",
      "group": "output",
      "value": "={toolCallResult: response.body}",
      "description": "response.body is the Agent Card or complete JSON-RPC response, including errors.",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "resultExpression"
      }
    },
    {
      "id": "errorExpression",
      "label": "Error expression",
      "type": "Text",
      "feel": "required",
      "group": "output",
      "optional": true,
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "errorExpression"
      }
    },
    {
      "id": "retries",
      "label": "Retries",
      "type": "String",
      "value": "1",
      "group": "output",
      "binding": {
        "type": "zeebe:taskDefinition",
        "property": "retries"
      }
    }
  ]
}
