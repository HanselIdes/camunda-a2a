{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Server - A2A RPC Endpoint",
  "id": "dev.hansel.a2a.core.rpc.v1",
  "description": "Direct stock-Connectors A2A 1.0 endpoint for a non-production blueprint. Requires stock Connectors and Camunda engine 8.10 or later; only combinations documented in the setup guide are verified.",
  "documentationRef": "https://a2a-protocol.org/latest/specification/",
  "version": 2,
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:StartEvent"
  ],
  "elementType": {
    "value": "bpmn:StartEvent"
  },
  "engines": {
    "camunda": "^8.10"
  },
  "groups": [
    {
      "id": "endpoint",
      "label": "Webhook"
    },
    {
      "id": "output",
      "label": "Output mapping"
    }
  ],
  "properties": [
    {
      "value": "io.camunda:webhook:1",
      "binding": {
        "name": "inbound.type",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "inbound.shouldValidateHmac",
      "value": "disabled",
      "binding": {
        "name": "inbound.shouldValidateHmac",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "inbound.auth.type",
      "value": "APIKEY",
      "binding": {
        "name": "inbound.auth.type",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "synchronousResponse",
      "value": "true",
      "binding": {
        "name": "synchronousResponse",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "consumeUnmatchedEvents",
      "value": "true",
      "binding": {
        "name": "consumeUnmatchedEvents",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "deduplicationModeManualFlag",
      "value": "false",
      "binding": {
        "name": "deduplicationModeManualFlag",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "deduplicationMode",
      "value": "AUTO",
      "binding": {
        "name": "deduplicationMode",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "inbound.method",
      "value": "post",
      "group": "endpoint",
      "binding": {
        "name": "inbound.method",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "inbound.context",
      "label": "Webhook ID",
      "description": "Clients POST JSON-RPC requests to {connectors base}/inbound/{webhook ID}.",
      "value": "a2a",
      "constraints": {
        "notEmpty": true
      },
      "feel": "optional",
      "group": "endpoint",
      "binding": {
        "name": "inbound.context",
        "type": "zeebe:property"
      },
      "type": "String"
    },
    {
      "id": "inbound.responseExpression",
      "value": "={statusCode: 200, headers: {\"Content-Type\": \"application/json\"}, body: correlation.variables.rpcResponse}",
      "group": "endpoint",
      "binding": {
        "name": "inbound.responseExpression",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "resultVariable",
      "label": "Result variable",
      "description": "Name of variable to store the response in. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-variable\" target=\"_blank\">documentation</a>.",
      "group": "output",
      "binding": {
        "name": "resultVariable",
        "type": "zeebe:property"
      },
      "type": "String"
    },
    {
      "id": "resultExpression",
      "label": "Result expression",
      "description": "Persist the JSON-RPC body and only content-type/a2a-version headers. Never persist authorization, API keys or arbitrary request headers.",
      "value": "={rpc: request.body, hdr: {\"content-type\": request.headers.`content-type`, \"a2a-version\": request.headers.`a2a-version`}}",
      "feel": "required",
      "group": "output",
      "binding": {
        "name": "resultExpression",
        "type": "zeebe:property"
      },
      "type": "Text"
    },
    {
      "type": "Hidden",
      "id": "inbound.auth.apiKey",
      "value": "=camunda.secrets.A2A_API_KEY",
      "binding": {
        "type": "zeebe:property",
        "name": "inbound.auth.apiKey"
      }
    },
    {
      "type": "Hidden",
      "id": "inbound.auth.apiKeyLocator",
      "value": "=request.headers.`x-a2a-api-key`",
      "binding": {
        "type": "zeebe:property",
        "name": "inbound.auth.apiKeyLocator"
      }
    }
  ]
}
