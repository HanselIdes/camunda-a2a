{
  "components": [
    {
      "type": "text",
      "text": "### Ask the A2A server agent\n\nThe client AI agent discovers the server's Agent Card and chooses when to send, poll, or request missing input. The example uses synthetic dispute data only.",
      "id": "Field_a2a_client_ask_0",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "type": "textarea",
      "key": "question",
      "label": "What should the server agent review?",
      "validate": {
        "required": true
      },
      "defaultValue": "Northwind Electronics charged USD 49.95 twice for one order. The expected charge was USD 49.95. Review this synthetic example only.",
      "id": "Field_a2a_client_ask_1",
      "layout": {
        "row": "Row_1",
        "columns": null
      }
    }
  ],
  "type": "default",
  "id": "a2a-client-ask",
  "executionPlatform": "Camunda Cloud",
