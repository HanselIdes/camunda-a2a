<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_a2a_client" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="a2a-client" name="01 Client Agent - Ask the Server" isExecutable="true">
    <bpmn:startEvent id="QuestionAsked" name="Client request received">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="a2a-client-ask" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_QuestionAsked_ClientAgent</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:adHocSubProcess id="ClientAgent" name="Coordinate with the A2A server" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="openai" target="provider.type" />
          <zeebe:input source="completions" target="provider.openai.api.type" />
          <zeebe:input source="custom" target="provider.openai.backend.type" />
          <zeebe:input source="=camunda.secrets.CAMUNDA_PROVIDED_LLM_API_ENDPOINT" target="provider.openai.backend.custom.endpoint" />
          <zeebe:input source="apiKey" target="provider.openai.backend.custom.authentication.type" />
          <zeebe:input source="=camunda.secrets.CAMUNDA_PROVIDED_LLM_API_KEY" target="provider.openai.backend.custom.authentication.apiKey" />
          <zeebe:input source="=camunda.secrets.CAMUNDA_PROVIDED_LLM_DEFAULT_MODEL" target="provider.openai.model.model" />
          <zeebe:input source="modelDefault" target="provider.openai.api.completions.effort" />
          <zeebe:input source="=&quot;You are the client-side AI agent for a synthetic A2A demonstration. The remote server agent owns the review; do not invent case facts or make financial decisions. Start by calling DiscoverAgentCard, then use SendA2AMessage for the user's request. GetA2ATask polls the task returned by the prior send. If the server requests input, call AskClientForInput with the server's exact question, then send the user's answer and confirmed syntheticClaim as a follow-up. SendA2AMessage continues the task and context from the prior send result, and takes confirmation data only from the AskClientForInput form result. Neither tool accepts model-supplied task identifiers. Never send model-inferred values or invent IDs. Never describe a request as completed unless a GetA2ATask response reports TASK_STATE_COMPLETED. Report failures and nonterminal states accurately. This example performs no real financial action.&quot;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=question" target="data.userPrompt.prompt" />
          <zeebe:input source="=clientAgent.context" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=8" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="true" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="clientAgent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="1" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult,&#10;  completedAt: now()&#10;}" />
        <zeebe:agentDefinition agentType="aiAgentSubProcess" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_QuestionAsked_ClientAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_ClientAgent_PrepareClientResult</bpmn:outgoing>
      <bpmn:serviceTask id="DiscoverAgentCard" name="Discover server agent" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
        <bpmn:documentation>Read the public Agent Card before contacting the remote server. Use this tool first to inspect its name, JSON-RPC endpoint and advertised capabilities. Returns the card; does not send a task or expose credentials.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="=camunda.secrets.A2A_AGENT_CARD_URL" target="url" />
            <zeebe:input source="={&quot;A2A-Version&quot;: &quot;1.0&quot;}" target="headers" />
            <zeebe:input source="=false" target="storeResponse" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="20" target="readTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="13" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={toolCallResult: response.body}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="SendA2AMessage" name="Send A2A message" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
        <bpmn:documentation>Send a new A2A 1.0 message or a follow-up to the same task. Use the user's request as text. Follow-ups use task and context IDs from the prior send result. A structured syntheticClaim is added only from the AskClientForInput form result; neither can be supplied as an AI tool argument. Returns the JSON-RPC response and task.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=camunda.secrets.A2A_RPC_URL" target="url" />
            <zeebe:input source="={&quot;A2A-Version&quot;: &quot;1.0&quot;, &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;X-A2A-Api-Key&quot;: camunda.secrets.A2A_API_KEY}" target="headers" />
            <zeebe:input source="=false" target="storeResponse" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="60" target="readTimeoutInSeconds" />
            <zeebe:input source="={ jsonrpc: &quot;2.0&quot;, id: uuid(), method: &quot;SendMessage&quot;, params: { message: context merge([ { messageId: uuid(), role: &quot;ROLE_USER&quot;, parts: concatenate( [{text: fromAi(toolCall.text, &quot;The user's request or follow-up text&quot;, &quot;string&quot;)}], flatten( for records in [flatten( for message in agentContext.conversation.messages[item.role = &quot;tool_call_result&quot;] return message.results[item.name = &quot;AskClientForInput&quot;] )] return if count(records) &gt; 0 then (for content in [records[count(records)].content[item.type = &quot;object&quot;][1].content] return for result in [if get value(content, &quot;toolCallResult&quot;) instance of context then content.toolCallResult else content] return if result.syntheticClaim instance of context then [{data: {syntheticClaim: result.syntheticClaim}}] else [])[1][1] else [] ) ) }, (for records in [flatten( for message in agentContext.conversation.messages[item.role = &quot;tool_call_result&quot;] return message.results[item.name = &quot;SendA2AMessage&quot;] )] return if count(records) &gt; 0 then (for content in [records[count(records)].content[item.type = &quot;object&quot;][1].content] return for response in [if content instance of context and get value(content, &quot;toolCallResult&quot;) instance of context then content.toolCallResult else content] return for result in [if response instance of context then response.result else null] return if result instance of context then if get value(result, &quot;task&quot;) instance of context then {taskId: result.task.id, contextId: result.task.contextId} else if result.id instance of string and result.contextId instance of string then {taskId: result.id, contextId: result.contextId} else {} else {} )[1][1][1] else {})[1] ]), configuration: {returnImmediately: true} } }" target="body" />
            <zeebe:input source="=false" target="ignoreNullValues" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="13" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={toolCallResult: response.body}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="GetA2ATask" name="Poll A2A task" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
        <bpmn:documentation>Read the current state of the task returned by the prior SendA2AMessage call. The task ID comes from that response, not an AI tool argument. Poll while work continues and use the returned state and message to decide whether to request input or report a terminal result.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=camunda.secrets.A2A_RPC_URL" target="url" />
            <zeebe:input source="={&quot;A2A-Version&quot;: &quot;1.0&quot;, &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;X-A2A-Api-Key&quot;: camunda.secrets.A2A_API_KEY}" target="headers" />
            <zeebe:input source="=false" target="storeResponse" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="30" target="readTimeoutInSeconds" />
            <zeebe:input source="={ jsonrpc: &quot;2.0&quot;, id: uuid(), method: &quot;GetTask&quot;, params: {id: get value( (for records in [flatten( for message in agentContext.conversation.messages[item.role = &quot;tool_call_result&quot;] return message.results[item.name = &quot;SendA2AMessage&quot;] )] return if count(records) &gt; 0 then (for content in [records[count(records)].content[item.type = &quot;object&quot;][1].content] return for response in [if content instance of context and get value(content, &quot;toolCallResult&quot;) instance of context then content.toolCallResult else content] return for result in [if response instance of context then response.result else null] return if result instance of context then if get value(result, &quot;task&quot;) instance of context then {taskId: result.task.id, contextId: result.task.contextId} else if result.id instance of string and result.contextId instance of string then {taskId: result.id, contextId: result.contextId} else {} else {} )[1][1][1] else {})[1] , &quot;taskId&quot;)} }" target="body" />
            <zeebe:input source="=false" target="ignoreNullValues" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="13" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={toolCallResult: response.body}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:userTask id="AskClientForInput" name="Ask client for missing input">
        <bpmn:documentation>Pause for the user only when the server asks for missing information. Display its exact question and return the user's text plus explicitly confirmed synthetic claim fields. Never fill these fields from model inference.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="a2a-client-answer" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.question, &quot;The exact clarification requested by the server&quot;, &quot;string&quot;)" target="question" />
            <zeebe:output source="={text: followUp, syntheticClaim: {merchant: claimMerchant, currency: claimCurrency, chargeAmounts: [claimFirstAmount, claimSecondAmount], expectedAmount: claimExpectedAmount, syntheticOnly: claimSyntheticOnly}}" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:userTask>
    </bpmn:adHocSubProcess>
    <bpmn:scriptTask id="PrepareClientResult" name="Prepare client result">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for polls in [flatten( for message in clientAgent.context.conversation.messages[item.role = &quot;tool_call_result&quot;] return message.results[item.name = &quot;GetA2ATask&quot;] )] return for content in [if count(polls) &gt; 0 then polls[count(polls)].content[item.type = &quot;object&quot;][1].content else null] return for body in [if content instance of context and get value(content, &quot;toolCallResult&quot;) instance of context then content.toolCallResult else content] return for response in [if body instance of context then body.result else null] return for task in [if response instance of context then if get value(response, &quot;task&quot;) instance of context then response.task else response else null] return for state in [if task.status.state instance of string then task.status.state else null] return &quot;### Client agent response\n\n&quot; + (if clientAgent.responseText instance of string then clientAgent.responseText else &quot;The client agent returned no text.&quot;) + &quot;\n\n**Last observed server task state:** &quot; + (if state instance of string then state else &quot;No GetTask status was observed.&quot;))[1][1][1][1][1][1]" resultVariable="resultText" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ClientAgent_PrepareClientResult</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareClientResult_ReviewClientResult</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="ReviewClientResult" name="Review client agent result">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="a2a-client-result" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrepareClientResult_ReviewClientResult</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewClientResult_ClientConversationFinished</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ClientConversationFinished" name="Client conversation finished">
      <bpmn:incoming>Flow_ReviewClientResult_ClientConversationFinished</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_QuestionAsked_ClientAgent" sourceRef="QuestionAsked" targetRef="ClientAgent" />
    <bpmn:sequenceFlow id="Flow_ClientAgent_PrepareClientResult" sourceRef="ClientAgent" targetRef="PrepareClientResult" />
    <bpmn:sequenceFlow id="Flow_PrepareClientResult_ReviewClientResult" sourceRef="PrepareClientResult" targetRef="ReviewClientResult" />
    <bpmn:sequenceFlow id="Flow_ReviewClientResult_ClientConversationFinished" sourceRef="ReviewClientResult" targetRef="ClientConversationFinished" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="a2a-client">
      <bpmndi:BPMNShape id="QuestionAsked_di" bpmnElement="QuestionAsked">
        <dc:Bounds x="70" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="33" y="236" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClientAgent_di" bpmnElement="ClientAgent" isExpanded="true">
        <dc:Bounds x="180" y="60" width="400" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DiscoverAgentCard_di" bpmnElement="DiscoverAgentCard">
        <dc:Bounds x="220" y="110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendA2AMessage_di" bpmnElement="SendA2AMessage">
        <dc:Bounds x="420" y="110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GetA2ATask_di" bpmnElement="GetA2ATask">
        <dc:Bounds x="220" y="240" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AskClientForInput_di" bpmnElement="AskClientForInput">
        <dc:Bounds x="420" y="240" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PrepareClientResult_di" bpmnElement="PrepareClientResult">
        <dc:Bounds x="650" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReviewClientResult_di" bpmnElement="ReviewClientResult">
        <dc:Bounds x="820" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClientConversationFinished_di" bpmnElement="ClientConversationFinished">
        <dc:Bounds x="1000" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="963" y="236" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_QuestionAsked_ClientAgent_di" bpmnElement="Flow_QuestionAsked_ClientAgent">
        <di:waypoint x="106" y="210" />
        <di:waypoint x="180" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ClientAgent_PrepareClientResult_di" bpmnElement="Flow_ClientAgent_PrepareClientResult">
        <di:waypoint x="580" y="210" />
        <di:waypoint x="650" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PrepareClientResult_ReviewClientResult_di" bpmnElement="Flow_PrepareClientResult_ReviewClientResult">
        <di:waypoint x="750" y="210" />
        <di:waypoint x="820" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReviewClientResult_ClientConversationFinished_di" bpmnElement="Flow_ReviewClientResult_ClientConversationFinished">
        <di:waypoint x="920" y="210" />
        <di:waypoint x="1000" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
