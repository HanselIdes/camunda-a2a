<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_A2AClientConversation" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="A2AClientConversation">
    <bpmn:participant id="Pool_a2a-client" name="A2A client agent" processRef="a2a-client" />
  </bpmn:collaboration>
  <bpmn:process id="a2a-client" name="01 Client Agent - Ask the Server" isExecutable="true">
    <bpmn:startEvent id="QuestionAsked" name="Client request received">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="a2a-client-ask" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_QuestionAsked_DiscoverAgentCard</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="DiscoverAgentCard" name="Fetch remote agent card" zeebe:modelerTemplate="dev.hansel.a2a.client.v1" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:documentation>Read the public Agent Card before entering the client agent. Returns the card, not credentials.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="fetchAgentCard" target="operationId" />
          <zeebe:input source="=camunda.secrets.A2A_AGENT_CARD_URL" target="url" />
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="=if operationId = &quot;fetchAgentCard&quot; then &quot;GET&quot; else &quot;POST&quot;" target="method" />
          <zeebe:input source="=if operationId = &quot;fetchAgentCard&quot; then {&quot;A2A-Version&quot;: &quot;1.0&quot;} else {&quot;A2A-Version&quot;: &quot;1.0&quot;, &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;X-Api-Key&quot;: apiKey}" target="headers" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={agentCard: response.body}" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_QuestionAsked_DiscoverAgentCard</bpmn:incoming>
      <bpmn:outgoing>Flow_DiscoverAgentCard_ClientJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ClientJoin">
      <bpmn:incoming>Flow_DiscoverAgentCard_ClientJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PrepareClientFollowUp_ClientJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ClientJoin_ClientAgent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:adHocSubProcess id="ClientAgent" name="Client AI agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="openai" target="provider.type" />
          <zeebe:input source="completions" target="provider.openai.api.type" />
          <zeebe:input source="custom" target="provider.openai.backend.type" />
          <zeebe:input source="=camunda.secrets.CAMUNDA_PROVIDED_LLM_API_ENDPOINT" target="provider.openai.backend.custom.endpoint" />
          <zeebe:input source="apiKey" target="provider.openai.backend.custom.authentication.type" />
          <zeebe:input source="=camunda.secrets.CAMUNDA_PROVIDED_LLM_API_KEY" target="provider.openai.backend.custom.authentication.apiKey" />
          <zeebe:input source="=camunda.secrets.CAMUNDA_PROVIDED_LLM_DEFAULT_MODEL" target="provider.openai.model.model" />
          <zeebe:input source="modelDefault" target="provider.openai.api.completions.effort" />
          <zeebe:input source="=&quot;You are the client-side AI agent for a synthetic A2A demonstration. The remote server agent owns the review; do not invent case facts or make financial decisions. The process has already fetched the remote Agent Card. ReadIntakeGuidance explains the synthetic demo's intake checklist. CheckConfirmedDetails checks whether the human has supplied confirmation; it does not reconcile charges. DraftReviewNote prepares an unsent draft for human review, not a financial decision. Use these local tools when useful; all charge arithmetic belongs to the remote server. Use SendA2AMessage to delegate the user's request to that remote agent. This tool sends the message and polls the returned task using an explicit BPMN flow. If the server requests input, call AskClientForInput with the server's exact question, then send the user's answer and confirmed syntheticClaim as a follow-up. SendA2AMessage continues the task and context from the prior send result, and takes confirmation data only from the AskClientForInput form result. An active task is continued; after a terminal task a new task uses the server-returned context ID. Neither tool accepts model-supplied task identifiers. Never send model-inferred values or invent IDs. Never describe a request as completed unless the tool result reports TASK_STATE_COMPLETED. Report failures and nonterminal states accurately. This example performs no real financial action.&quot;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=question + &quot;\n\nRemote agent: &quot; + agentCard.name + &quot;\nSkills: &quot; + string join(agentCard.skills.name, &quot;, &quot;)" target="data.userPrompt.prompt" />
          <zeebe:input source="=clientAgent.context" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=8" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="true" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="clientAgent" />
          <zeebe:output source="=(for polls in [flatten( for message in agent.context.conversation.messages[item.role = &quot;tool_call_result&quot;] return message.results[item.name = &quot;SendA2AMessage&quot;] )] return for content in [if count(polls) &gt; 0 then polls[count(polls)].content[item.type = &quot;object&quot;][1].content else null] return for body in [if content instance of context and get value(content, &quot;toolCallResult&quot;) instance of context then content.toolCallResult else content] return for response in [if body instance of context then body.result else null] return for task in [if response instance of context then if get value(response, &quot;task&quot;) instance of context then response.task else response else null] return for state in [if task.status.state instance of string then task.status.state else null] return &quot;### Client agent response\n\n&quot; + (if agent.responseText instance of string then agent.responseText else &quot;The client agent returned no text.&quot;) + &quot;\n\n**Last observed server task state:** &quot; + (if state instance of string then state else &quot;No server task status was observed.&quot;))[1][1][1][1][1][1]" target="resultText" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="1" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult,&#10;  completedAt: now()&#10;}" />
        <zeebe:agentDefinition agentType="aiAgentSubProcess" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ClientJoin_ClientAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_ClientAgent_ReviewClientResult</bpmn:outgoing>
      <bpmn:scriptTask id="ReadIntakeGuidance" name="Read intake guidance">
        <bpmn:documentation>Read the local synthetic-demo intake checklist before collecting dispute details. Returns required information and the client/server responsibilities. This is demonstration guidance, not bank policy, and performs no external call.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="={ syntheticDemoOnly: true, requiredDetails: [&quot;merchant&quot;, &quot;currency&quot;, &quot;two charge amounts&quot;, &quot;expected order amount&quot;, &quot;explicit confirmation that all values are synthetic&quot;], clientResponsibilities: [&quot;collect the user's account&quot;, &quot;request missing confirmation&quot;, &quot;delegate charge reconciliation&quot;, &quot;prepare a draft for human review&quot;], restrictions: [&quot;do not infer financial fields from narrative&quot;, &quot;do not authorize refunds or decide fraud&quot;, &quot;do not treat this demonstration checklist as bank policy&quot;] }" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="CheckConfirmedDetails" name="Check confirmed details">
        <bpmn:documentation>Check whether AskClientForInput returned a human-confirmed synthetic claim. Accepts no model-provided financial fields. Returns confirmation presence and next steps, not arithmetic, eligibility or a dispute decision. Use when deciding whether to ask for details.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=flatten( for records in [flatten( for message in agentContext.conversation.messages[item.role = &quot;tool_call_result&quot;] return message.results[item.name = &quot;AskClientForInput&quot;] )] return if count(records) &gt; 0 then (for content in [records[count(records)].content[item.type = &quot;object&quot;][1].content] return for result in [if get value(content, &quot;toolCallResult&quot;) instance of context then content.toolCallResult else content] return if result.syntheticClaim instance of context then [{data: {syntheticClaim: result.syntheticClaim}}] else [])[1][1] else [] )" target="confirmedParts" />
          </zeebe:ioMapping>
          <zeebe:script expression="={ claim: if count(confirmedParts) = 1 then confirmedParts[1].data.syntheticClaim else null, humanConfirmationPresent: claim instance of context, syntheticOnlyConfirmed: claim.syntheticOnly = true, nextStep: if claim instance of context and claim.syntheticOnly = true then &quot;Send the human-confirmed details to the remote reconciliation agent.&quot; else &quot;Ask the human to confirm the synthetic claim using AskClientForInput.&quot;, notice: &quot;Checks confirmation provenance only. The server validates and reconciles amounts.&quot; }" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="DraftReviewNote" name="Draft review note">
        <bpmn:documentation>Format a draft note for the human reviewer after receiving remote reconciliation evidence. Supply a concise summary grounded in the user's account and actual tool results. Returns explicitly labeled draft text; it does not verify claims, send messages, change an account or authorize a refund.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.summary, &quot;Draft a concise note using only the user account and actual remote agent results. Label missing evidence; do not invent facts or authorize action.&quot;, &quot;string&quot;)" target="draftText" />
          </zeebe:ioMapping>
          <zeebe:script expression="={draftOnly: true, text: draftText, notice: &quot;Unsent draft for human review. No refund, notification or financial action performed.&quot;}" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:subProcess id="SendA2AMessage" name="Ask remote agent">
        <bpmn:documentation>Delegate to the remote A2A agent. Sends a new message or follows up on the same task using response-derived task/context IDs. Polls two seconds apart while the task is working, then returns the actual JSON-RPC response, including input-required or failure states. Confirmed synthetic claim data comes only from the human form. Use AskClientForInput if the response requests confirmation; do not infer claim values.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.text, &quot;The user request or follow-up text&quot;, &quot;string&quot;)" target="remoteText" />
            <zeebe:input source="=(for records in [flatten( for message in agentContext.conversation.messages[item.role = &quot;tool_call_result&quot;] return message.results[item.name = &quot;SendA2AMessage&quot;] )] return if count(records) &gt; 0 then (for content in [records[count(records)].content[item.type = &quot;object&quot;][1].content] return for response in [if content instance of context and get value(content, &quot;toolCallResult&quot;) instance of context then content.toolCallResult else content] return for result in [if response instance of context then response.result else null] return for task in [if result instance of context and get value(result, &quot;task&quot;) instance of context then result.task else result] return if task.id instance of string and task.contextId instance of string then if list contains([&quot;TASK_STATE_COMPLETED&quot;, &quot;TASK_STATE_CANCELED&quot;, &quot;TASK_STATE_FAILED&quot;, &quot;TASK_STATE_REJECTED&quot;], task.status.state) then {contextId: task.contextId} else {taskId: task.id, contextId: task.contextId} else {} )[1][1][1][1] else {})[1]" target="previousTask" />
            <zeebe:input source="=flatten( for records in [flatten( for message in agentContext.conversation.messages[item.role = &quot;tool_call_result&quot;] return message.results[item.name = &quot;AskClientForInput&quot;] )] return if count(records) &gt; 0 then (for content in [records[count(records)].content[item.type = &quot;object&quot;][1].content] return for result in [if get value(content, &quot;toolCallResult&quot;) instance of context then content.toolCallResult else content] return if result.syntheticClaim instance of context then [{data: {syntheticClaim: result.syntheticClaim}}] else [])[1][1] else [] )" target="confirmedParts" />
            <zeebe:output source="=remoteResponse" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="RemoteRequestStarted" name="Remote request started">
          <bpmn:outgoing>Flow_RemoteRequestStarted_SendRemoteMessage</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="SendRemoteMessage" name="Send A2A message" zeebe:modelerTemplate="dev.hansel.a2a.client.v1" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
            <zeebe:ioMapping>
              <zeebe:input source="sendMessage" target="operationId" />
              <zeebe:input source="=camunda.secrets.A2A_RPC_URL" target="url" />
              <zeebe:input source="=camunda.secrets.A2A_API_KEY" target="apiKey" />
              <zeebe:input source="=context merge([ { messageId: uuid(), role: &quot;ROLE_USER&quot;, parts: concatenate( [{text: remoteText}], confirmedParts ) }, previousTask ])" target="message" />
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="=if operationId = &quot;fetchAgentCard&quot; then &quot;GET&quot; else &quot;POST&quot;" target="method" />
              <zeebe:input source="=if operationId = &quot;fetchAgentCard&quot; then {&quot;A2A-Version&quot;: &quot;1.0&quot;} else {&quot;A2A-Version&quot;: &quot;1.0&quot;, &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;X-Api-Key&quot;: apiKey}" target="headers" />
              <zeebe:input source="=if operationId = &quot;sendMessage&quot; then {jsonrpc: &quot;2.0&quot;, id: uuid(), method: &quot;SendMessage&quot;, params: {message: message, configuration: {returnImmediately: true}}} else {jsonrpc: &quot;2.0&quot;, id: uuid(), method: &quot;GetTask&quot;, params: {id: taskId}}" target="body" />
              <zeebe:input source="60" target="readTimeoutInSeconds" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="resultExpression" value="={remoteResponse: response.body}" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_RemoteRequestStarted_SendRemoteMessage</bpmn:incoming>
          <bpmn:outgoing>Flow_SendRemoteMessage_RemoteTaskAccepted</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="RemoteTaskAccepted" name="Task returned?" default="Flow_RemoteTaskAccepted_RemoteReplyJoin">
          <bpmn:incoming>Flow_SendRemoteMessage_RemoteTaskAccepted</bpmn:incoming>
          <bpmn:outgoing>Flow_RemoteTaskAccepted_RemotePollJoin</bpmn:outgoing>
          <bpmn:outgoing>Flow_RemoteTaskAccepted_RemoteReplyJoin</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="RemotePollJoin">
          <bpmn:incoming>Flow_RemoteTaskAccepted_RemotePollJoin</bpmn:incoming>
          <bpmn:incoming>Flow_RemoteTaskState_RemotePollJoin</bpmn:incoming>
          <bpmn:outgoing>Flow_RemotePollJoin_WaitBeforeRemotePoll</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:intermediateCatchEvent id="WaitBeforeRemotePoll" name="Wait 2 seconds">
          <bpmn:incoming>Flow_RemotePollJoin_WaitBeforeRemotePoll</bpmn:incoming>
          <bpmn:outgoing>Flow_WaitBeforeRemotePoll_GetA2ATask</bpmn:outgoing>
          <bpmn:timerEventDefinition id="WaitBeforeRemotePoll_def">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT2S"</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:serviceTask id="GetA2ATask" name="Get A2A task" zeebe:modelerTemplate="dev.hansel.a2a.client.v1" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
            <zeebe:ioMapping>
              <zeebe:input source="getTask" target="operationId" />
              <zeebe:input source="=camunda.secrets.A2A_RPC_URL" target="url" />
              <zeebe:input source="=camunda.secrets.A2A_API_KEY" target="apiKey" />
              <zeebe:input source="=if remoteResponse.result.task instance of context then remoteResponse.result.task.id else remoteResponse.result.id" target="taskId" />
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="=if operationId = &quot;fetchAgentCard&quot; then &quot;GET&quot; else &quot;POST&quot;" target="method" />
              <zeebe:input source="=if operationId = &quot;fetchAgentCard&quot; then {&quot;A2A-Version&quot;: &quot;1.0&quot;} else {&quot;A2A-Version&quot;: &quot;1.0&quot;, &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;X-Api-Key&quot;: apiKey}" target="headers" />
              <zeebe:input source="=if operationId = &quot;sendMessage&quot; then {jsonrpc: &quot;2.0&quot;, id: uuid(), method: &quot;SendMessage&quot;, params: {message: message, configuration: {returnImmediately: true}}} else {jsonrpc: &quot;2.0&quot;, id: uuid(), method: &quot;GetTask&quot;, params: {id: taskId}}" target="body" />
              <zeebe:input source="30" target="readTimeoutInSeconds" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="resultExpression" value="={remoteResponse: response.body}" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_WaitBeforeRemotePoll_GetA2ATask</bpmn:incoming>
          <bpmn:outgoing>Flow_GetA2ATask_RemoteTaskState</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="RemoteTaskState" name="Still working?" default="Flow_RemoteTaskState_RemoteReplyJoin">
          <bpmn:incoming>Flow_GetA2ATask_RemoteTaskState</bpmn:incoming>
          <bpmn:outgoing>Flow_RemoteTaskState_RemotePollJoin</bpmn:outgoing>
          <bpmn:outgoing>Flow_RemoteTaskState_RemoteReplyJoin</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="RemoteReplyJoin">
          <bpmn:incoming>Flow_RemoteTaskAccepted_RemoteReplyJoin</bpmn:incoming>
          <bpmn:incoming>Flow_RemoteTaskState_RemoteReplyJoin</bpmn:incoming>
          <bpmn:outgoing>Flow_RemoteReplyJoin_RemoteReplyReceived</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="RemoteReplyReceived" name="Remote agent replied">
          <bpmn:incoming>Flow_RemoteReplyJoin_RemoteReplyReceived</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_RemoteRequestStarted_SendRemoteMessage" sourceRef="RemoteRequestStarted" targetRef="SendRemoteMessage" />
        <bpmn:sequenceFlow id="Flow_SendRemoteMessage_RemoteTaskAccepted" sourceRef="SendRemoteMessage" targetRef="RemoteTaskAccepted" />
        <bpmn:sequenceFlow id="Flow_RemoteTaskAccepted_RemotePollJoin" name="yes" sourceRef="RemoteTaskAccepted" targetRef="RemotePollJoin">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=remoteResponse.error = null and (remoteResponse.result.id instance of string or remoteResponse.result.task.id instance of string)</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_RemoteTaskAccepted_RemoteReplyJoin" name="no task / error" sourceRef="RemoteTaskAccepted" targetRef="RemoteReplyJoin" />
        <bpmn:sequenceFlow id="Flow_RemotePollJoin_WaitBeforeRemotePoll" sourceRef="RemotePollJoin" targetRef="WaitBeforeRemotePoll" />
        <bpmn:sequenceFlow id="Flow_WaitBeforeRemotePoll_GetA2ATask" sourceRef="WaitBeforeRemotePoll" targetRef="GetA2ATask" />
        <bpmn:sequenceFlow id="Flow_GetA2ATask_RemoteTaskState" sourceRef="GetA2ATask" targetRef="RemoteTaskState" />
        <bpmn:sequenceFlow id="Flow_RemoteTaskState_RemotePollJoin" name="yes" sourceRef="RemoteTaskState" targetRef="RemotePollJoin">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(for task in [if remoteResponse.result.task instance of context then remoteResponse.result.task else remoteResponse.result] return remoteResponse.error = null and list contains(["TASK_STATE_SUBMITTED", "TASK_STATE_WORKING"], task.status.state))[1]</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_RemoteTaskState_RemoteReplyJoin" name="otherwise" sourceRef="RemoteTaskState" targetRef="RemoteReplyJoin" />
        <bpmn:sequenceFlow id="Flow_RemoteReplyJoin_RemoteReplyReceived" sourceRef="RemoteReplyJoin" targetRef="RemoteReplyReceived" />
      </bpmn:subProcess>
      <bpmn:userTask id="AskClientForInput" name="Ask client for missing input">
        <bpmn:documentation>Pause for the user only when the server asks for missing information. Display its exact question and return the user's text plus explicitly confirmed synthetic claim fields. Never fill these fields from model inference.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="a2a-client-answer" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.question, &quot;The exact clarification requested by the server&quot;, &quot;string&quot;)" target="question" />
            <zeebe:output source="={text: followUp, syntheticClaim: {merchant: claimMerchant, currency: claimCurrency, chargeAmounts: [claimFirstAmount, claimSecondAmount], expectedAmount: claimExpectedAmount, syntheticOnly: claimSyntheticOnly}}" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:userTask>
    </bpmn:adHocSubProcess>
    <bpmn:userTask id="ReviewClientResult" name="User feedback">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="a2a-client-result" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ClientAgent_ReviewClientResult</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewClientResult_ClientSatisfied</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ClientSatisfied" name="User satisfied?" default="Flow_ClientSatisfied_PrepareClientFollowUp">
      <bpmn:incoming>Flow_ReviewClientResult_ClientSatisfied</bpmn:incoming>
      <bpmn:outgoing>Flow_ClientSatisfied_ClientConversationFinished</bpmn:outgoing>
      <bpmn:outgoing>Flow_ClientSatisfied_PrepareClientFollowUp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="PrepareClientFollowUp" name="Use user feedback">
      <bpmn:extensionElements>
        <zeebe:script expression="=clientFeedback" resultVariable="question" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ClientSatisfied_PrepareClientFollowUp</bpmn:incoming>
