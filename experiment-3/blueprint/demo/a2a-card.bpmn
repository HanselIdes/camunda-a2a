<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_a2a_card" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="a2a-card" name="A2A Agent Card" isExecutable="true">
    <bpmn:startEvent id="CardRequested" name="Agent Card requested" zeebe:modelerTemplate="dev.hansel.a2a.core.card.v1" zeebe:modelerTemplateVersion="1">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
          <zeebe:property name="inbound.context" value="a2a-card" />
          <zeebe:property name="inbound.auth.type" value="NONE" />
          <zeebe:property name="inbound.method" value="get" />
          <zeebe:property name="inbound.responseExpression" value="={statusCode: 200, headers: {&quot;Content-Type&quot;: &quot;application/json&quot;}, body: {name: &quot;Synthetic card-dispute reviewer&quot;, version: &quot;0.1.0&quot;, description: &quot;Non-production community demonstration. Reconciles synthetic charges for human review; &quot; + &quot;performs no financial actions.&quot;, provider: {organization: &quot;HanselIdes&quot;, url: &quot;https://github.com/HanselIdes/camunda-a2a&quot;}, supportedInterfaces: [{url: &quot;{{secrets.A2A_RPC_URL}}&quot;, protocolBinding: &quot;JSONRPC&quot;, protocolVersion: &quot;1.0&quot;}], capabilities: {streaming: false, pushNotifications: false, extendedAgentCard: false}, defaultInputModes: [&quot;text/plain&quot;], defaultOutputModes: [&quot;text/plain&quot;, &quot;application/json&quot;], securitySchemes: {a2aApiKey: {apiKeySecurityScheme: {location: &quot;header&quot;, name: &quot;X-A2A-Api-Key&quot;}}}, securityRequirements: [{schemes: {a2aApiKey: {}}}], skills: [{id: &quot;review_duplicate_charge&quot;, name: &quot;Reconcile synthetic charges&quot;, description: &quot;Call for every review. Checks explicit client confirmation; without it returns confirmation instructions. Reconciles only validated client-supplied synthetic amounts; accepts no model financial parameters. Returns arithmetic evidence for human review, not a refund authorization or fraud determination.&quot;, tags: [&quot;synthetic&quot;, &quot;card-dispute&quot;, &quot;reconciliation&quot;], examples: [&quot;Synthetic example only: Northwind Electronics charged USD 49.95 twice for one order. The expected charge was USD 49.95. Reconcile the two charges with your tool.&quot;]}]}}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_CardRequested_CardServed</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="CardServed" name="Card served">
      <bpmn:incoming>Flow_CardRequested_CardServed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CardRequested_CardServed" sourceRef="CardRequested" targetRef="CardServed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="a2a-card">
      <bpmndi:BPMNShape id="CardRequested_di" bpmnElement="CardRequested">
        <dc:Bounds x="150" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardServed_di" bpmnElement="CardServed">
        <dc:Bounds x="280" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_CardRequested_CardServed_di" bpmnElement="Flow_CardRequested_CardServed">
        <di:waypoint x="186" y="100" />
        <di:waypoint x="280" y="100" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
