# Copy to .env. Ports must be free on the host; the compose project name is camunda-a2a-3.
COMPOSE_PROJECT_NAME=camunda-a2a-3
CAMUNDA_REST_PORT=28080
CAMUNDA_GRPC_PORT=28500
CAMUNDA_MGMT_PORT=29600
CONNECTORS_PORT=28085
PROXY_PORT=28090
# Public base URL clients use for the agent (the proxy). Goes into the Agent Card.
A2A_PUBLIC_URL=http://localhost:28090
# The model the agent uses: any OpenAI-compatible endpoint. The default is a local Ollama.
LLM_API_ENDPOINT=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-coder-30b-64k
# Push notifications are on for the client agent, which receives every answer as a push. tck/run.sh switches them
# off for the gated run, because the TCK requires CORE-CAP-001 (error when unsupported) to pass.
A2A_PUSH_ENABLED=true
# The process the A2A endpoint starts for each new task. tck/run.sh and tck/run-push.sh set a2a-tck-fixture.
A2A_AGENT_PROCESS=a2a-agent
