{"name":"Synthetic card-dispute reviewer","supportedInterfaces":[{"url":"https://host.docker.internal:57430/inbound/a2a","protocolBinding":"JSONRPC","protocolVersion":"1.0"}],"provider":{"organization":"HanselIdes","url":"https://github.com/HanselIdes/camunda-a2a"},"securitySchemes":{"a2aApiKey":{"apiKeySecurityScheme":{"location":"header","name":"X-A2A-Api-Key"}}},"description":"Non-production community demonstration. Reconciles synthetic charges for human review; performs no financial actions.","version":"0.1.0","defaultInputModes":["text/plain"],"securityRequirements":[{"schemes":{"a2aApiKey":{}}}],"skills":[{"name":"Reconcile synthetic charges","examples":["Synthetic example only: Northwind Electronics charged USD 49.95 twice for one order. The expected charge was USD 49.95. Reconcile the two charges with your tool."],"id":"review_duplicate_charge","description":"Reconciles two supplied synthetic charge amounts against one expected order amount. Returns arithmetic evidence for human review, not a refund authorization or fraud determination.","tags":["synthetic","card-dispute","reconciliation"]}],"defaultOutputModes":["text/plain","application/json"],"capabilities":{"streaming":false,"pushNotifications":false,"extendedAgentCard":false}}