<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_a2a_card_dispute" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Msg_followUp" name="a2a-send">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=task.id" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="AgentFailed" name="AgentFailed" errorCode="AGENT_FAILED" />
  <bpmn:message id="A2ACancelMessage" name="a2a-cancel">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=task.id" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="a2a-controlled-agent" name="03 Server Agent - Synthetic Card Dispute" isExecutable="true">
    <bpmn:startEvent id="TaskReceived" name="A2A task received">
      <bpmn:outgoing>Flow_TaskReceived_NextTurn</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="NextTurn">
      <bpmn:incoming>Flow_TaskReceived_NextTurn</bpmn:incoming>
      <bpmn:incoming>Flow_FollowUp_NextTurn</bpmn:incoming>
      <bpmn:outgoing>Flow_NextTurn_EncodePrompt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:adHocSubProcess id="AgentTools" name="Review synthetic card dispute" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="openaiCompatible" target="provider.type" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_API_ENDPOINT}}" target="provider.openaiCompatible.endpoint" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_API_KEY}}" target="provider.openaiCompatible.authentication.apiKey" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_DEFAULT_MODEL}}" target="provider.openaiCompatible.model.model" />
          <zeebe:input source="=0" target="provider.openaiCompatible.model.parameters.temperature" />
          <zeebe:input source="=&quot;You help demonstrate card-dispute intake using synthetic data only. For each review call review_duplicate_charge; never calculate or supply financial fields yourself. The tool uses only the current request's explicit client confirmation, not values inferred from text. If the tool requests confirmation, reply NEED_INPUT: followed by its clarification instructions. After the tool returns, briefly describe its result. Do not authorize refunds, decide a real dispute, call external financial services or claim that matching amounts alone prove fraud.&quot;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=promptText" target="data.userPrompt.prompt" />
          <zeebe:input source="=agent.context" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=8" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&quot;AGENT_FAILED&quot;, string(error.message)) else null" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidateConfirmation_AgentTools</bpmn:incoming>
      <bpmn:outgoing>Flow_AgentTools_UpdateTask</bpmn:outgoing>
      <bpmn:scriptTask id="review_duplicate_charge" name="Reconcile synthetic charges">
        <bpmn:documentation>Call for every review. Checks explicit client confirmation; without it returns confirmation instructions. Reconciles only validated client-supplied synthetic amounts; accepts no model financial parameters. Returns arithmetic evidence for human review, not a refund authorization or fraud determination.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=confirmation" target="confirmed" />
          </zeebe:ioMapping>
          <zeebe:script expression="=if confirmed.valid = true then { merchant: confirmed.claim.merchant, currency: confirmed.claim.currency, chargeAmounts: confirmed.claim.chargeAmounts, expectedAmount: confirmed.claim.expectedAmount, paidAmount: decimal(sum(confirmed.claim.chargeAmounts), 2), overchargeAmount: decimal(max([sum(confirmed.claim.chargeAmounts) - confirmed.claim.expectedAmount, 0]), 2), matchingAmounts: every amount in confirmed.claim.chargeAmounts satisfies amount = confirmed.claim.expectedAmount, recommendation: &quot;REQUEST_HUMAN_REVIEW&quot;, syntheticOnly: true} else {confirmationRequired: true, instruction: &quot;Confirm synthetic data only: supply one message data part with syntheticClaim containing merchant and currency (nonempty text), chargeAmounts (exactly two finite nonnegative numbers), expectedAmount (a finite nonnegative number), and syntheticOnly=true. Free text alone is context, not confirmation.&quot;}" resultVariable="toolCallResult" />
          <zeebe:properties>
            <zeebe:property name="a2a:tags" value="synthetic,card-dispute,reconciliation" />
            <zeebe:property name="a2a:examples" value="Synthetic example only: Northwind Electronics charged USD 49.95 twice for one order. The expected charge was USD 49.95. Reconcile the two charges with your tool." />
          </zeebe:properties>
        </bpmn:extensionElements>
      </bpmn:scriptTask>
    </bpmn:adHocSubProcess>
    <bpmn:boundaryEvent id="AgentError" name="Agent failed" attachedToRef="AgentTools">
      <bpmn:outgoing>Flow_AgentError_ReportFailure</bpmn:outgoing>
      <bpmn:errorEventDefinition id="AgentError_def" errorRef="AgentFailed" />
    </bpmn:boundaryEvent>
    <bpmn:callActivity id="UpdateTask" name="Update A2A task">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-task-update" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=task" target="task" />
          <zeebe:input source="=(for reply in [agent.responseText] return for ask in [reply instance of string and starts with(trim(reply), &quot;NEED_INPUT:&quot;)] return for records in [flatten(for message in agent.context.conversation.messages[item.role = &quot;tool_call_result&quot;] return message.results[item.name = &quot;review_duplicate_charge&quot;])] return for evidence in [if count(records) &gt; 0 then records[count(records)].content else null] return for expected in [if confirmation.valid = true then { merchant: confirmation.claim.merchant, currency: confirmation.claim.currency, chargeAmounts: confirmation.claim.chargeAmounts, expectedAmount: confirmation.claim.expectedAmount, paidAmount: decimal(sum(confirmation.claim.chargeAmounts), 2), overchargeAmount: decimal(max([sum(confirmation.claim.chargeAmounts) - confirmation.claim.expectedAmount, 0]), 2), matchingAmounts: every amount in confirmation.claim.chargeAmounts satisfies amount = confirmation.claim.expectedAmount, recommendation: &quot;REQUEST_HUMAN_REVIEW&quot;, syntheticOnly: true} else null] return for grounded in [expected != null and evidence = expected] return {state: if confirmation.valid != true or ask then &quot;TASK_STATE_INPUT_REQUIRED&quot; else if grounded then &quot;TASK_STATE_COMPLETED&quot; else &quot;TASK_STATE_FAILED&quot;, text: if confirmation.valid != true then &quot;Confirm synthetic data only: supply one message data part with syntheticClaim containing merchant and currency (nonempty text), chargeAmounts (exactly two finite nonnegative numbers), expectedAmount (a finite nonnegative number), and syntheticOnly=true. Free text alone is context, not confirmation.&quot; else if ask then trim(substring(trim(reply), 12)) else if grounded then &quot;Synthetic charges reconciled for human review. No refund or financial action was performed.&quot; else &quot;The agent did not produce the required reconciliation evidence.&quot;, artifacts: if confirmation.valid != true or ask then [] else if grounded then [{artifactId: uuid(), name: &quot;reconciliation&quot;, parts: [{data: evidence}]}] else []})[1][1][1][1][1][1]" target="outcome" />
          <zeebe:output source="=task" target="task" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AgentTools_UpdateTask</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateTask_InputRequired</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="InputRequired" name="Input required?" default="Flow_InputRequired_TaskDone">
      <bpmn:incoming>Flow_UpdateTask_InputRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_InputRequired_FollowUp</bpmn:outgoing>
      <bpmn:outgoing>Flow_InputRequired_TaskDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="FollowUp" name="Follow-up received">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="={id: task.id, contextId: task.contextId, rev: task.rev + 1, status: {state: &quot;TASK_STATE_WORKING&quot;, timestamp: substring(string(now()), 1, 19) + &quot;Z&quot;}, artifacts: task.artifacts, history: append(task.history, put(put(followUp.message, &quot;taskId&quot;, task.id), &quot;contextId&quot;, task.contextId))}" target="task" />
          <zeebe:output source="=followUp" target="req" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InputRequired_FollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUp_NextTurn</bpmn:outgoing>
      <bpmn:messageEventDefinition id="FollowUp_def" messageRef="Msg_followUp" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="TaskDone" name="Task done">
      <bpmn:incoming>Flow_InputRequired_TaskDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="ReportFailure" name="Report failure">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="a2a-task-update" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=task" target="task" />
          <zeebe:input source="={state: &quot;TASK_STATE_FAILED&quot;, text: &quot;The agent could not complete the request.&quot;}" target="outcome" />
          <zeebe:output source="=task" target="task" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AgentError_ReportFailure</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportFailure_TaskFailed</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="TaskFailed" name="Task failed">
      <bpmn:incoming>Flow_ReportFailure_TaskFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="EncodePrompt" name="Join client input">
      <bpmn:extensionElements>
        <zeebe:script expression="=if count(req.message.parts[item.text instance of string]) = 0 then &quot;Review the explicit client confirmation.&quot; else string join(req.message.parts[item.text instance of string].text, &quot; &quot;)" resultVariable="promptText" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NextTurn_EncodePrompt</bpmn:incoming>
      <bpmn:outgoing>Flow_EncodePrompt_ValidateConfirmation</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="ValidateConfirmation" name="Validate client confirmation">
      <bpmn:extensionElements>
        <zeebe:script expression="={ parts: if req.message.parts instance of list then req.message.parts[item instance of context and item.data != null] else [], claim: if count(parts) = 1 then if parts[1].data instance of context then parts[1].data.syntheticClaim else null else null, validAmount: function(amount) if amount instance of number then amount &gt;= 0 and amount - amount = 0 else false, valid: if claim instance of context then if claim.merchant instance of string and claim.currency instance of string then if string length(trim(claim.merchant)) &gt; 0 and string length(trim(claim.currency)) &gt; 0 and claim.syntheticOnly = true then if claim.chargeAmounts instance of list then count(claim.chargeAmounts) = 2 and (every amount in claim.chargeAmounts satisfies validAmount(amount)) and validAmount(claim.expectedAmount) else false else false else false else false, result: {valid: valid = true, claim: if valid = true then {merchant: claim.merchant, currency: claim.currency, chargeAmounts: claim.chargeAmounts, expectedAmount: claim.expectedAmount, syntheticOnly: true} else null} }.result" resultVariable="confirmation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EncodePrompt_ValidateConfirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateConfirmation_AgentTools</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_TaskReceived_NextTurn" sourceRef="TaskReceived" targetRef="NextTurn" />
    <bpmn:sequenceFlow id="Flow_AgentTools_UpdateTask" sourceRef="AgentTools" targetRef="UpdateTask" />
    <bpmn:sequenceFlow id="Flow_UpdateTask_InputRequired" sourceRef="UpdateTask" targetRef="InputRequired" />
    <bpmn:sequenceFlow id="Flow_InputRequired_FollowUp" name="yes" sourceRef="InputRequired" targetRef="FollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task.status.state = "TASK_STATE_INPUT_REQUIRED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InputRequired_TaskDone" name="no" sourceRef="InputRequired" targetRef="TaskDone" />
    <bpmn:sequenceFlow id="Flow_FollowUp_NextTurn" sourceRef="FollowUp" targetRef="NextTurn" />
    <bpmn:sequenceFlow id="Flow_AgentError_ReportFailure" sourceRef="AgentError" targetRef="ReportFailure" />
    <bpmn:sequenceFlow id="Flow_ReportFailure_TaskFailed" sourceRef="ReportFailure" targetRef="TaskFailed" />
    <bpmn:sequenceFlow id="Flow_NextTurn_EncodePrompt" sourceRef="NextTurn" targetRef="EncodePrompt" />
    <bpmn:sequenceFlow id="Flow_EncodePrompt_ValidateConfirmation" sourceRef="EncodePrompt" targetRef="ValidateConfirmation" />
    <bpmn:sequenceFlow id="Flow_ValidateConfirmation_AgentTools" sourceRef="ValidateConfirmation" targetRef="AgentTools" />
    <bpmn:subProcess id="A2ACancellation" name="Cancel this A2A task" triggeredByEvent="true">
      <bpmn:startEvent id="A2ACancelRequested" name="Cancellation requested" isInterrupting="true">
        <bpmn:outgoing>A2ACancelToState</bpmn:outgoing>
        <bpmn:messageEventDefinition id="A2ACancelRequested_def" messageRef="A2ACancelMessage" />
      </bpmn:startEvent>
      <bpmn:scriptTask id="A2ASetCanceled" name="Commit terminal outcome">
        <bpmn:extensionElements>
          <zeebe:script resultVariable="task" expression="=if list contains([&quot;TASK_STATE_COMPLETED&quot;, &quot;TASK_STATE_CANCELED&quot;, &quot;TASK_STATE_FAILED&quot;, &quot;TASK_STATE_REJECTED&quot;], task.status.state) then task else context merge([task, {rev: task.rev + 1, artifacts: [], status: {state: &quot;TASK_STATE_CANCELED&quot;, timestamp: substring(string(now()), 1, 19) + &quot;Z&quot;}}])" />
        </bpmn:extensionElements>
        <bpmn:incoming>A2ACancelToState</bpmn:incoming>
        <bpmn:outgoing>A2ACancelToEnd</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:endEvent id="A2ACancelDone" name="Cancellation settled">
        <bpmn:incoming>A2ACancelToEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="A2ACancelToState" sourceRef="A2ACancelRequested" targetRef="A2ASetCanceled" />
      <bpmn:sequenceFlow id="A2ACancelToEnd" sourceRef="A2ASetCanceled" targetRef="A2ACancelDone" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="a2a-controlled-agent">
      <bpmndi:BPMNShape id="TaskReceived_di" bpmnElement="TaskReceived">
        <dc:Bounds x="57.0" y="52.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NextTurn_di" bpmnElement="NextTurn" isMarkerVisible="true">
        <dc:Bounds x="650.0" y="45.0" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AgentTools_di" bpmnElement="AgentTools" isExpanded="true">
        <dc:Bounds x="1075.0" y="30.0" width="250" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_duplicate_charge_di" bpmnElement="review_duplicate_charge">
        <dc:Bounds x="1150.0" y="100.0" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UpdateTask_di" bpmnElement="UpdateTask">
        <dc:Bounds x="1375.0" y="30.0" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InputRequired_di" bpmnElement="InputRequired" isMarkerVisible="true">
        <dc:Bounds x="1550.0" y="45.0" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1522.5" y="23.0" width="105" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FollowUp_di" bpmnElement="FollowUp">
        <dc:Bounds x="1707.0" y="52.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskDone_di" bpmnElement="TaskDone">
        <dc:Bounds x="1707.0" y="332.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReportFailure_di" bpmnElement="ReportFailure">
        <dc:Bounds x="1375.0" y="310.0" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskFailed_di" bpmnElement="TaskFailed">
        <dc:Bounds x="1557.0" y="332.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EncodePrompt_di" bpmnElement="EncodePrompt">
        <dc:Bounds x="775.0" y="30.0" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidateConfirmation_di" bpmnElement="ValidateConfirmation">
        <dc:Bounds x="925.0" y="30.0" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AgentError_di" bpmnElement="AgentError">
        <dc:Bounds x="1182.0" y="232.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_TaskReceived_NextTurn_di" bpmnElement="Flow_TaskReceived_NextTurn">
        <di:waypoint x="93.0" y="70.0" />
        <di:waypoint x="650.0" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AgentTools_UpdateTask_di" bpmnElement="Flow_AgentTools_UpdateTask">
        <di:waypoint x="1325.0" y="70.0" />
        <di:waypoint x="1375.0" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_UpdateTask_InputRequired_di" bpmnElement="Flow_UpdateTask_InputRequired">
        <di:waypoint x="1475.0" y="70.0" />
        <di:waypoint x="1550.0" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InputRequired_FollowUp_di" bpmnElement="Flow_InputRequired_FollowUp">
        <di:waypoint x="1600.0" y="70.0" />
        <di:waypoint x="1707.0" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InputRequired_TaskDone_di" bpmnElement="Flow_InputRequired_TaskDone">
        <di:waypoint x="1600.0" y="70.0" />
        <di:waypoint x="1650.0" y="70.0" />
        <di:waypoint x="1650.0" y="280.0" />
        <di:waypoint x="1650.0" y="280.0" />
        <di:waypoint x="1650.0" y="350.0" />
        <di:waypoint x="1707.0" y="350.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FollowUp_NextTurn_di" bpmnElement="Flow_FollowUp_NextTurn">
        <di:waypoint x="1725.0" y="88.0" />
        <di:waypoint x="1725.0" y="140.0" />
        <di:waypoint x="675.0" y="140.0" />
        <di:waypoint x="675.0" y="95.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AgentError_ReportFailure_di" bpmnElement="Flow_AgentError_ReportFailure">
        <di:waypoint x="1200.0" y="268.0" />
        <di:waypoint x="1200.0" y="350.0" />
        <di:waypoint x="1375.0" y="350.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReportFailure_TaskFailed_di" bpmnElement="Flow_ReportFailure_TaskFailed">
        <di:waypoint x="1475.0" y="350.0" />
        <di:waypoint x="1557.0" y="350.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NextTurn_EncodePrompt_di" bpmnElement="Flow_NextTurn_EncodePrompt">
        <di:waypoint x="700.0" y="70.0" />
        <di:waypoint x="775.0" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EncodePrompt_ValidateConfirmation_di" bpmnElement="Flow_EncodePrompt_ValidateConfirmation">
        <di:waypoint x="875.0" y="70.0" />
        <di:waypoint x="925.0" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ValidateConfirmation_AgentTools_di" bpmnElement="Flow_ValidateConfirmation_AgentTools">
        <di:waypoint x="1025.0" y="70.0" />
        <di:waypoint x="1075.0" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="A2ACancellation_di" bpmnElement="A2ACancellation" isExpanded="true">
        <dc:Bounds x="25.0" y="310.0" width="550" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2ACancelRequested_di" bpmnElement="A2ACancelRequested">
        <dc:Bounds x="132.0" y="402.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2ASetCanceled_di" bpmnElement="A2ASetCanceled">
        <dc:Bounds x="250.0" y="380.0" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2ACancelDone_di" bpmnElement="A2ACancelDone">
        <dc:Bounds x="432.0" y="402.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A2ACancelToState_di" bpmnElement="A2ACancelToState">
        <di:waypoint x="168.0" y="420.0" />
        <di:waypoint x="250.0" y="420.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2ACancelToEnd_di" bpmnElement="A2ACancelToEnd">
        <di:waypoint x="350.0" y="420.0" />
        <di:waypoint x="432.0" y="420.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
